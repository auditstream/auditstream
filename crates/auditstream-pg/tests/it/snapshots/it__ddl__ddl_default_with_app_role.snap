---
source: crates/auditstream-pg/tests/it/ddl.rs
expression: "first.join(\";\\n\\n\")"
---
DO $$
BEGIN
  PERFORM pg_catalog.set_config('auditstream._migration_tx', 'on', true);
END
$$;

DO $$
DECLARE
  grant_mode text := 'none';
  need_inherit boolean := false;
  need_set boolean := false;
  has_self_row boolean := false;
BEGIN
  IF pg_catalog.current_setting('auditstream._migration_tx', true) IS DISTINCT FROM 'on' THEN
    RAISE EXCEPTION 'Auditstream DDL statements must run inside a single transaction'
      USING HINT = 'Wrap the generated statements in BEGIN; ... COMMIT; or use a transactional migrator.';
  END IF;
  PERFORM pg_catalog.pg_advisory_xact_lock(7022629640991829879);
  IF NOT EXISTS (SELECT 1 FROM pg_catalog.pg_roles WHERE rolname = 'auditstream_owner') THEN
    EXECUTE 'CREATE ROLE "auditstream_owner" NOLOGIN';
  END IF;
  IF pg_catalog.current_setting('server_version_num')::int >= 160000 THEN
    need_inherit := NOT pg_catalog.pg_has_role(current_user, 'auditstream_owner', 'USAGE');
    need_set := NOT pg_catalog.pg_has_role(current_user, 'auditstream_owner', 'SET');
    IF need_inherit OR need_set THEN
      SELECT EXISTS (
        SELECT 1
          FROM pg_catalog.pg_auth_members m
          JOIN pg_catalog.pg_roles r ON r.oid = m.roleid
          JOIN pg_catalog.pg_roles u ON u.oid = m.member
         WHERE r.rolname = 'auditstream_owner'
           AND u.rolname = current_user
           AND m.grantor = u.oid
      ) INTO has_self_row;
      IF NOT has_self_row THEN
        EXECUTE pg_catalog.format(
          'GRANT "auditstream_owner" TO %I WITH INHERIT %s, SET %s',
          current_user,
          CASE WHEN need_inherit THEN 'TRUE' ELSE 'FALSE' END,
          CASE WHEN need_set THEN 'TRUE' ELSE 'FALSE' END
        );
        grant_mode := 'self_row';
      ELSIF need_inherit AND need_set THEN
        EXECUTE pg_catalog.format('GRANT "auditstream_owner" TO %I WITH INHERIT TRUE, SET TRUE', current_user);
        grant_mode := 'both';
      ELSIF need_inherit THEN
        EXECUTE pg_catalog.format('GRANT "auditstream_owner" TO %I WITH INHERIT TRUE', current_user);
        grant_mode := 'inherit';
      ELSE
        EXECUTE pg_catalog.format('GRANT "auditstream_owner" TO %I WITH SET TRUE', current_user);
        grant_mode := 'set';
      END IF;
    END IF;
  ELSIF NOT pg_catalog.pg_has_role(current_user, 'auditstream_owner', 'MEMBER') THEN
    EXECUTE pg_catalog.format('GRANT "auditstream_owner" TO %I', current_user);
    grant_mode := 'self_row';
  END IF;
  PERFORM pg_catalog.set_config('auditstream._granted_self', grant_mode, true);
END
$$;

CREATE SCHEMA IF NOT EXISTS "auditstream" AUTHORIZATION "auditstream_owner";

DO $$
DECLARE
  obj_schema name;
  obj_name name;
  fn_oid oid;
BEGIN
  IF EXISTS (
    SELECT 1 FROM pg_catalog.pg_namespace
     WHERE nspname = 'auditstream'
       AND nspowner <> 'auditstream_owner'::pg_catalog.regrole
  ) THEN
    EXECUTE pg_catalog.format('ALTER SCHEMA %I OWNER TO %I', 'auditstream', 'auditstream_owner');
  END IF;

  FOR obj_schema, obj_name IN
    WITH RECURSIVE tree(relid) AS (
      SELECT c.oid
        FROM pg_catalog.pg_class c
        JOIN pg_catalog.pg_namespace n ON n.oid = c.relnamespace
       WHERE n.nspname = 'auditstream'
         AND c.relname = 'changes'
         AND c.relkind IN ('r', 'p')
      UNION ALL
      SELECT i.inhrelid
        FROM tree
        JOIN pg_catalog.pg_inherits i ON i.inhparent = tree.relid
    )
    SELECT cn.nspname, c.relname
      FROM tree
      JOIN pg_catalog.pg_class c ON c.oid = tree.relid
      JOIN pg_catalog.pg_namespace cn ON cn.oid = c.relnamespace
     WHERE c.relowner <> 'auditstream_owner'::pg_catalog.regrole
     ORDER BY cn.nspname, c.relname
  LOOP
    EXECUTE pg_catalog.format('ALTER TABLE %I.%I OWNER TO %I', obj_schema, obj_name, 'auditstream_owner');
  END LOOP;

  SELECT p.oid INTO fn_oid
    FROM pg_catalog.pg_proc p
    JOIN pg_catalog.pg_namespace n ON n.oid = p.pronamespace
   WHERE n.nspname = 'auditstream'
     AND p.proname = 'log_event'
     AND p.prokind = 'f'
     AND p.pronargs = 3
     AND p.proargtypes = (ARRAY[
       'pg_catalog.text'::pg_catalog.regtype::pg_catalog.oid,
       'pg_catalog.jsonb'::pg_catalog.regtype::pg_catalog.oid,
       'pg_catalog.jsonb'::pg_catalog.regtype::pg_catalog.oid
     ])::pg_catalog.oidvector;
  IF fn_oid IS NOT NULL AND EXISTS (
    SELECT 1 FROM pg_catalog.pg_proc
     WHERE oid = fn_oid AND proowner <> 'auditstream_owner'::pg_catalog.regrole
  ) THEN
    EXECUTE pg_catalog.format('ALTER FUNCTION %I.log_event(text, jsonb, jsonb) OWNER TO %I', 'auditstream', 'auditstream_owner');
  END IF;
END
$$;

DO $$
BEGIN
  PERFORM pg_catalog.set_config('auditstream._prev_role', current_user, true);
  EXECUTE pg_catalog.format('SET LOCAL ROLE %I', 'auditstream_owner');
END
$$;

CREATE TABLE IF NOT EXISTS "auditstream".changes (
  id bigint GENERATED ALWAYS AS IDENTITY,
  event_id uuid NOT NULL DEFAULT gen_random_uuid(),
  occurred_at timestamptz NOT NULL DEFAULT clock_timestamp(),
  xact_id xid8 NOT NULL DEFAULT pg_current_xact_id(),
  source text NOT NULL DEFAULT 'db',
  schema_name text,
  table_name text,
  table_oid oid,
  op text NOT NULL,
  record_id jsonb,
  before jsonb,
  after jsonb,
  changed text[],
  actor jsonb,
  context jsonb,
  actor_source text,
  db_user text NOT NULL DEFAULT session_user,
  schema_version smallint NOT NULL DEFAULT 1,
  PRIMARY KEY (id, occurred_at),
  CONSTRAINT changes_source_check CHECK (source IN ('db', 'app')),
  CONSTRAINT changes_actor_source_check CHECK (
    actor_source IS NULL OR actor_source IN ('set_config', 'comment', 'jwt', 'invalid')
  ),
  CONSTRAINT changes_schema_version_check CHECK (schema_version >= 1)
) PARTITION BY RANGE (occurred_at);

DO $$
DECLARE
  prev_role name := current_user;
  switched_role boolean := false;
  base_month timestamp := pg_catalog.date_trunc('month', pg_catalog.now() AT TIME ZONE 'UTC');
  m int;
  month_start timestamp;
  month_end timestamp;
  obj_schema name;
  part_name name;
  grantee_oid oid;
  managed_tables name[] := ARRAY[]::name[];
BEGIN
  IF prev_role <> 'auditstream_owner' THEN
    EXECUTE pg_catalog.format('SET LOCAL ROLE %I', 'auditstream_owner');
    switched_role := true;
  END IF;
  EXECUTE pg_catalog.format(
    'CREATE TABLE IF NOT EXISTS %I.changes_default PARTITION OF %I.changes DEFAULT',
    'auditstream',
    'auditstream'
  );
  FOR m IN 0..0 LOOP
    month_start := base_month + pg_catalog.make_interval(months => m);
    month_end := base_month + pg_catalog.make_interval(months => m + 1);
    part_name := 'changes_' || pg_catalog.to_char(month_start, 'YYYY_MM');
    EXECUTE pg_catalog.format(
      'CREATE TABLE IF NOT EXISTS %I.%I PARTITION OF %I.changes FOR VALUES FROM (%L) TO (%L)',
      'auditstream',
      part_name,
      'auditstream',
      pg_catalog.to_char(month_start, 'YYYY-MM-DD HH24:MI:SS') || '+00',
      pg_catalog.to_char(month_end, 'YYYY-MM-DD HH24:MI:SS') || '+00'
    );
    managed_tables := pg_catalog.array_append(managed_tables, part_name);
  END LOOP;
  FOR obj_schema, part_name, grantee_oid IN
    WITH RECURSIVE tree(relid) AS (
      SELECT i.inhrelid
        FROM pg_catalog.pg_inherits i
        JOIN pg_catalog.pg_class parent ON parent.oid = i.inhparent
        JOIN pg_catalog.pg_namespace pn ON pn.oid = parent.relnamespace
       WHERE pn.nspname = 'auditstream'
         AND parent.relname = 'changes'
      UNION ALL
      SELECT i.inhrelid
        FROM tree
        JOIN pg_catalog.pg_inherits i ON i.inhparent = tree.relid
    ),
    child_grants AS (
      SELECT cn.nspname AS rel_schema, c.relname AS rel_name, a.grantee
        FROM tree
        JOIN pg_catalog.pg_class c ON c.oid = tree.relid
        JOIN pg_catalog.pg_namespace cn ON cn.oid = c.relnamespace
        CROSS JOIN LATERAL pg_catalog.aclexplode(
          COALESCE(c.relacl, pg_catalog.acldefault('r', c.relowner))
        ) AS a
       WHERE a.grantee <> c.relowner
      UNION
      SELECT cn.nspname AS rel_schema, c.relname AS rel_name, a.grantee
        FROM tree
        JOIN pg_catalog.pg_class c ON c.oid = tree.relid
        JOIN pg_catalog.pg_namespace cn ON cn.oid = c.relnamespace
        JOIN pg_catalog.pg_attribute att
          ON att.attrelid = c.oid
         AND att.attnum > 0
         AND NOT att.attisdropped
         AND att.attacl IS NOT NULL
        CROSS JOIN LATERAL pg_catalog.aclexplode(att.attacl) AS a
       WHERE a.grantee <> c.relowner
    )
    SELECT child_grants.rel_schema, child_grants.rel_name, child_grants.grantee
      FROM child_grants
     ORDER BY child_grants.rel_schema, child_grants.rel_name, child_grants.grantee
  LOOP
    IF grantee_oid = 0 THEN
      EXECUTE pg_catalog.format('REVOKE ALL ON TABLE %I.%I FROM PUBLIC CASCADE', obj_schema, part_name);
    ELSE
      EXECUTE pg_catalog.format(
        'REVOKE ALL ON TABLE %I.%I FROM %I CASCADE',
        obj_schema,
        part_name,
        pg_catalog.pg_get_userbyid(grantee_oid)
      );
    END IF;
  END LOOP;

  FOR grantee_oid IN
    SELECT parent_grants.grantee FROM (
      SELECT a.grantee
        FROM pg_catalog.pg_class c
        JOIN pg_catalog.pg_namespace n ON n.oid = c.relnamespace
        CROSS JOIN LATERAL pg_catalog.aclexplode(
          COALESCE(c.relacl, pg_catalog.acldefault('r', c.relowner))
        ) AS a
       WHERE n.nspname = 'auditstream'
         AND c.relname = 'changes'
         AND a.grantee <> c.relowner
         AND (a.grantee = 0 OR a.privilege_type <> 'SELECT' OR a.is_grantable)
      UNION
      SELECT a.grantee
        FROM pg_catalog.pg_class c
        JOIN pg_catalog.pg_namespace n ON n.oid = c.relnamespace
        JOIN pg_catalog.pg_attribute att
          ON att.attrelid = c.oid
         AND att.attnum > 0
         AND NOT att.attisdropped
         AND att.attacl IS NOT NULL
        CROSS JOIN LATERAL pg_catalog.aclexplode(att.attacl) AS a
       WHERE n.nspname = 'auditstream'
         AND c.relname = 'changes'
         AND a.grantee <> c.relowner
         AND (a.grantee = 0 OR a.privilege_type <> 'SELECT' OR a.is_grantable)
    ) AS parent_grants
     ORDER BY parent_grants.grantee
  LOOP
    IF grantee_oid = 0 THEN
      EXECUTE pg_catalog.format('REVOKE ALL ON TABLE %I.changes FROM PUBLIC CASCADE', 'auditstream');
    ELSE
      EXECUTE pg_catalog.format(
        'REVOKE INSERT, UPDATE, DELETE, TRUNCATE, REFERENCES, TRIGGER ON TABLE %I.changes FROM %I CASCADE',
        'auditstream',
        pg_catalog.pg_get_userbyid(grantee_oid)
      );
      EXECUTE pg_catalog.format(
        'REVOKE GRANT OPTION FOR SELECT ON TABLE %I.changes FROM %I CASCADE',
        'auditstream',
        pg_catalog.pg_get_userbyid(grantee_oid)
      );
      IF pg_catalog.current_setting('server_version_num')::int >= 170000 THEN
        EXECUTE pg_catalog.format(
          'REVOKE MAINTAIN ON TABLE %I.changes FROM %I CASCADE',
          'auditstream',
          pg_catalog.pg_get_userbyid(grantee_oid)
        );
      END IF;
    END IF;
  END LOOP;

  FOR obj_schema, part_name, grantee_oid IN
    SELECT DISTINCT sn.nspname, s.relname, a.grantee
      FROM pg_catalog.pg_class c
      JOIN pg_catalog.pg_namespace n ON n.oid = c.relnamespace
      JOIN pg_catalog.pg_depend d
        ON d.refclassid = 'pg_catalog.pg_class'::pg_catalog.regclass
       AND d.refobjid = c.oid
       AND d.classid = 'pg_catalog.pg_class'::pg_catalog.regclass
       AND d.deptype IN ('a', 'i')
      JOIN pg_catalog.pg_class s ON s.oid = d.objid AND s.relkind = 'S'
      JOIN pg_catalog.pg_namespace sn ON sn.oid = s.relnamespace
      CROSS JOIN LATERAL pg_catalog.aclexplode(
        COALESCE(s.relacl, pg_catalog.acldefault('s', s.relowner))
      ) AS a
     WHERE n.nspname = 'auditstream'
       AND c.relname = 'changes'
       AND a.grantee <> s.relowner
     ORDER BY sn.nspname, s.relname, a.grantee
  LOOP
    IF grantee_oid = 0 THEN
      EXECUTE pg_catalog.format('REVOKE ALL ON SEQUENCE %I.%I FROM PUBLIC CASCADE', obj_schema, part_name);
    ELSE
      EXECUTE pg_catalog.format(
        'REVOKE ALL ON SEQUENCE %I.%I FROM %I CASCADE',
        obj_schema,
        part_name,
        pg_catalog.pg_get_userbyid(grantee_oid)
      );
    END IF;
  END LOOP;
  IF switched_role THEN
    SET LOCAL ROLE NONE;
    IF prev_role <> current_user THEN
      EXECUTE pg_catalog.format('SET LOCAL ROLE %I', prev_role);
    END IF;
  END IF;
END
$$;

DO $$
BEGIN
  IF NOT EXISTS (SELECT 1 FROM pg_catalog.pg_class c
                 JOIN pg_catalog.pg_namespace n ON n.oid = c.relnamespace
                 WHERE n.nspname = 'auditstream' AND c.relname = 'changes_occurred_at_brin_idx') THEN
    CREATE INDEX IF NOT EXISTS changes_occurred_at_brin_idx ON "auditstream".changes USING brin (occurred_at);
  END IF;
END
$$;

DO $$
BEGIN
  IF NOT EXISTS (SELECT 1 FROM pg_catalog.pg_class c
                 JOIN pg_catalog.pg_namespace n ON n.oid = c.relnamespace
                 WHERE n.nspname = 'auditstream' AND c.relname = 'changes_xact_id_idx') THEN
    CREATE INDEX IF NOT EXISTS changes_xact_id_idx ON "auditstream".changes (xact_id, id);
  END IF;
END
$$;

DO $$
BEGIN
  IF NOT EXISTS (SELECT 1 FROM pg_catalog.pg_class c
                 JOIN pg_catalog.pg_namespace n ON n.oid = c.relnamespace
                 WHERE n.nspname = 'auditstream' AND c.relname = 'changes_lookup_idx') THEN
    CREATE INDEX IF NOT EXISTS changes_lookup_idx ON "auditstream".changes USING hash (record_id) WHERE record_id IS NOT NULL;
  END IF;
END
$$;

CREATE OR REPLACE FUNCTION "auditstream".log_event(
  action text,
  target jsonb DEFAULT NULL,
  data jsonb DEFAULT NULL
)
RETURNS uuid
LANGUAGE plpgsql
SECURITY DEFINER
SET search_path = pg_catalog, pg_temp
AS $fn$
DECLARE
  resolved record;
  v_event_id uuid;
BEGIN
  IF action IS NULL
     OR pg_catalog.char_length(pg_catalog.btrim(action)) < 1
     OR pg_catalog.char_length(action) > 64
     OR pg_catalog.upper(pg_catalog.btrim(action)) IN ('INSERT', 'UPDATE', 'DELETE', 'TRUNCATE') THEN
    RAISE EXCEPTION 'auditstream.log_event: invalid action %', action
      USING ERRCODE = '22023';
  END IF;

  IF target IS NOT NULL
     AND pg_catalog.jsonb_typeof(target) IS DISTINCT FROM 'object' THEN
    RAISE EXCEPTION 'auditstream.log_event: target must be a JSON object or NULL'
      USING ERRCODE = '22023';
  END IF;

  IF data IS NOT NULL
     AND pg_catalog.jsonb_typeof(data) IS DISTINCT FROM 'object' THEN
    RAISE EXCEPTION 'auditstream.log_event: data must be a JSON object or NULL'
      USING ERRCODE = '22023';
  END IF;

  SELECT r.actor, r.context, r.actor_source
    INTO resolved
    FROM "auditstream".resolve_actor() AS r;

  INSERT INTO "auditstream".changes (
    source,
    op,
    record_id,
    after,
    actor,
    context,
    actor_source,
    db_user,
    schema_version
  )
  VALUES (
    'app',
    action,
    target,
    data,
    resolved.actor,
    resolved.context,
    resolved.actor_source,
    session_user,
    1
  )
  RETURNING event_id INTO v_event_id;

  RETURN v_event_id;
END
$fn$;

DO $$
DECLARE
  grantee_oid oid;
  target_role text;
  allowed_roles text[] := ARRAY['app_user']::text[];
BEGIN
  FOR grantee_oid IN
    SELECT DISTINCT a.grantee
      FROM pg_catalog.pg_namespace n
      CROSS JOIN LATERAL pg_catalog.aclexplode(
        COALESCE(n.nspacl, pg_catalog.acldefault('n', n.nspowner))
      ) AS a
     WHERE n.nspname = 'auditstream'
       AND a.grantee <> n.nspowner
       AND (a.grantee = 0 OR a.privilege_type <> 'USAGE' OR a.is_grantable OR pg_catalog.pg_get_userbyid(a.grantee)::text <> ALL (allowed_roles))
     ORDER BY a.grantee
  LOOP
    IF grantee_oid = 0 THEN
      EXECUTE pg_catalog.format('REVOKE ALL ON SCHEMA %I FROM PUBLIC CASCADE', 'auditstream');
    ELSE
      IF pg_catalog.pg_get_userbyid(grantee_oid)::text <> ALL (allowed_roles) THEN
        EXECUTE pg_catalog.format('REVOKE ALL ON SCHEMA %I FROM %I CASCADE', 'auditstream', pg_catalog.pg_get_userbyid(grantee_oid));
      ELSE
        EXECUTE pg_catalog.format('REVOKE CREATE ON SCHEMA %I FROM %I CASCADE', 'auditstream', pg_catalog.pg_get_userbyid(grantee_oid));
        EXECUTE pg_catalog.format('REVOKE GRANT OPTION FOR USAGE ON SCHEMA %I FROM %I CASCADE', 'auditstream', pg_catalog.pg_get_userbyid(grantee_oid));
      END IF;
    END IF;
  END LOOP;
  FOR grantee_oid IN
    SELECT extra_changes_grants.grantee FROM (
      SELECT a.grantee
        FROM pg_catalog.pg_class c
        JOIN pg_catalog.pg_namespace n ON n.oid = c.relnamespace
        CROSS JOIN LATERAL pg_catalog.aclexplode(
          COALESCE(c.relacl, pg_catalog.acldefault('r', c.relowner))
        ) AS a
       WHERE n.nspname = 'auditstream'
         AND c.relname = 'changes'
         AND a.grantee <> c.relowner
         AND a.grantee <> 0
         AND pg_catalog.pg_get_userbyid(a.grantee)::text <> ALL (allowed_roles)
      UNION
      SELECT a.grantee
        FROM pg_catalog.pg_class c
        JOIN pg_catalog.pg_namespace n ON n.oid = c.relnamespace
        JOIN pg_catalog.pg_attribute att
          ON att.attrelid = c.oid
         AND att.attnum > 0
         AND NOT att.attisdropped
         AND att.attacl IS NOT NULL
        CROSS JOIN LATERAL pg_catalog.aclexplode(att.attacl) AS a
       WHERE n.nspname = 'auditstream'
         AND c.relname = 'changes'
         AND a.grantee <> c.relowner
         AND a.grantee <> 0
         AND pg_catalog.pg_get_userbyid(a.grantee)::text <> ALL (allowed_roles)
    ) AS extra_changes_grants
     ORDER BY extra_changes_grants.grantee
  LOOP
    EXECUTE pg_catalog.format(
      'REVOKE ALL ON TABLE %I.changes FROM %I CASCADE',
      'auditstream',
      pg_catalog.pg_get_userbyid(grantee_oid)
    );
  END LOOP;

  FOR grantee_oid IN
    SELECT DISTINCT a.grantee
      FROM pg_catalog.pg_proc p
      JOIN pg_catalog.pg_namespace n ON n.oid = p.pronamespace
      CROSS JOIN LATERAL pg_catalog.aclexplode(
        COALESCE(p.proacl, pg_catalog.acldefault('f', p.proowner))
      ) AS a
     WHERE n.nspname = 'auditstream'
       AND p.proname = 'log_event'
       AND p.prokind = 'f'
       AND p.pronargs = 3
       AND p.proargtypes = (ARRAY[
         'pg_catalog.text'::pg_catalog.regtype::pg_catalog.oid,
         'pg_catalog.jsonb'::pg_catalog.regtype::pg_catalog.oid,
         'pg_catalog.jsonb'::pg_catalog.regtype::pg_catalog.oid
       ])::pg_catalog.oidvector
       AND a.grantee <> p.proowner
       AND (a.grantee = 0 OR a.is_grantable OR pg_catalog.pg_get_userbyid(a.grantee)::text <> ALL (allowed_roles))
     ORDER BY a.grantee
  LOOP
    IF grantee_oid = 0 THEN
      EXECUTE pg_catalog.format('REVOKE ALL ON FUNCTION %I.log_event(text, jsonb, jsonb) FROM PUBLIC CASCADE', 'auditstream');
    ELSE
      IF pg_catalog.pg_get_userbyid(grantee_oid)::text <> ALL (allowed_roles) THEN
        EXECUTE pg_catalog.format('REVOKE ALL ON FUNCTION %I.log_event(text, jsonb, jsonb) FROM %I CASCADE', 'auditstream', pg_catalog.pg_get_userbyid(grantee_oid));
      ELSE
        EXECUTE pg_catalog.format('REVOKE GRANT OPTION FOR EXECUTE ON FUNCTION %I.log_event(text, jsonb, jsonb) FROM %I CASCADE', 'auditstream', pg_catalog.pg_get_userbyid(grantee_oid));
      END IF;
    END IF;
  END LOOP;
  FOREACH target_role IN ARRAY allowed_roles LOOP
    IF NOT EXISTS (
      SELECT 1 FROM pg_catalog.pg_namespace n
      CROSS JOIN LATERAL pg_catalog.aclexplode(
        COALESCE(n.nspacl, pg_catalog.acldefault('n', n.nspowner))
      ) AS a
       WHERE n.nspname = 'auditstream'
         AND a.grantee <> 0
         AND pg_catalog.pg_get_userbyid(a.grantee)::text = target_role
         AND a.privilege_type = 'USAGE'
    ) THEN
      EXECUTE pg_catalog.format('GRANT USAGE ON SCHEMA %I TO %I', 'auditstream', target_role);
    END IF;
    IF NOT EXISTS (
      SELECT 1 FROM pg_catalog.pg_class c
      JOIN pg_catalog.pg_namespace n ON n.oid = c.relnamespace
      CROSS JOIN LATERAL pg_catalog.aclexplode(
        COALESCE(c.relacl, pg_catalog.acldefault('r', c.relowner))
      ) AS a
       WHERE n.nspname = 'auditstream'
         AND c.relname = 'changes'
         AND a.grantee <> 0
         AND pg_catalog.pg_get_userbyid(a.grantee)::text = target_role
         AND a.privilege_type = 'SELECT'
    ) THEN
      EXECUTE pg_catalog.format('GRANT SELECT ON TABLE %I.changes TO %I', 'auditstream', target_role);
    END IF;
    IF NOT EXISTS (
      SELECT 1 FROM pg_catalog.pg_proc p
      JOIN pg_catalog.pg_namespace n ON n.oid = p.pronamespace
      CROSS JOIN LATERAL pg_catalog.aclexplode(
        COALESCE(p.proacl, pg_catalog.acldefault('f', p.proowner))
      ) AS a
       WHERE n.nspname = 'auditstream'
         AND p.proname = 'log_event'
         AND p.prokind = 'f'
         AND p.pronargs = 3
         AND p.proargtypes = (ARRAY[
           'pg_catalog.text'::pg_catalog.regtype::pg_catalog.oid,
           'pg_catalog.jsonb'::pg_catalog.regtype::pg_catalog.oid,
           'pg_catalog.jsonb'::pg_catalog.regtype::pg_catalog.oid
         ])::pg_catalog.oidvector
         AND a.grantee <> 0
         AND pg_catalog.pg_get_userbyid(a.grantee)::text = target_role
         AND a.privilege_type = 'EXECUTE'
    ) THEN
      EXECUTE pg_catalog.format(
        'GRANT EXECUTE ON FUNCTION %I.log_event(text, jsonb, jsonb) TO %I',
        'auditstream',
        target_role
      );
    END IF;
  END LOOP;
END
$$;

DO $$
DECLARE
  prev_role text := pg_catalog.current_setting('auditstream._prev_role', true);
BEGIN
  SET LOCAL ROLE NONE;
  IF prev_role IS NOT NULL AND prev_role <> '' AND prev_role <> current_user THEN
    EXECUTE pg_catalog.format('SET LOCAL ROLE %I', prev_role);
  END IF;
  PERFORM pg_catalog.set_config('auditstream._prev_role', '', true);
END
$$;

DO $$
DECLARE
  prev_role name := current_user;
  switched_role boolean := false;
  base_month timestamp := pg_catalog.date_trunc('month', pg_catalog.now() AT TIME ZONE 'UTC');
  m int;
  month_start timestamp;
  month_end timestamp;
  obj_schema name;
  part_name name;
  grantee_oid oid;
  managed_tables name[] := ARRAY[]::name[];
BEGIN
  IF prev_role <> 'auditstream_owner' THEN
    EXECUTE pg_catalog.format('SET LOCAL ROLE %I', 'auditstream_owner');
    switched_role := true;
  END IF;
  FOR m IN 1..3 LOOP
    month_start := base_month + pg_catalog.make_interval(months => m);
    month_end := base_month + pg_catalog.make_interval(months => m + 1);
    part_name := 'changes_' || pg_catalog.to_char(month_start, 'YYYY_MM');
    EXECUTE pg_catalog.format(
      'CREATE TABLE IF NOT EXISTS %I.%I PARTITION OF %I.changes FOR VALUES FROM (%L) TO (%L)',
      'auditstream',
      part_name,
      'auditstream',
      pg_catalog.to_char(month_start, 'YYYY-MM-DD HH24:MI:SS') || '+00',
      pg_catalog.to_char(month_end, 'YYYY-MM-DD HH24:MI:SS') || '+00'
    );
    managed_tables := pg_catalog.array_append(managed_tables, part_name);
  END LOOP;
  FOR part_name, grantee_oid IN
    SELECT future_grants.rel_name, future_grants.grantee FROM (
      SELECT c.relname AS rel_name, a.grantee
        FROM pg_catalog.pg_class c
        JOIN pg_catalog.pg_namespace n ON n.oid = c.relnamespace
        CROSS JOIN LATERAL pg_catalog.aclexplode(
          COALESCE(c.relacl, pg_catalog.acldefault('r', c.relowner))
        ) AS a
       WHERE n.nspname = 'auditstream'
         AND c.relname = ANY (managed_tables)
         AND a.grantee <> c.relowner
      UNION
      SELECT c.relname AS rel_name, a.grantee
        FROM pg_catalog.pg_class c
        JOIN pg_catalog.pg_namespace n ON n.oid = c.relnamespace
        JOIN pg_catalog.pg_attribute att
          ON att.attrelid = c.oid
         AND att.attnum > 0
         AND NOT att.attisdropped
         AND att.attacl IS NOT NULL
        CROSS JOIN LATERAL pg_catalog.aclexplode(att.attacl) AS a
       WHERE n.nspname = 'auditstream'
         AND c.relname = ANY (managed_tables)
         AND a.grantee <> c.relowner
    ) AS future_grants
     ORDER BY future_grants.rel_name, future_grants.grantee
  LOOP
    IF grantee_oid = 0 THEN
      EXECUTE pg_catalog.format('REVOKE ALL ON TABLE %I.%I FROM PUBLIC CASCADE', 'auditstream', part_name);
    ELSE
      EXECUTE pg_catalog.format(
        'REVOKE ALL ON TABLE %I.%I FROM %I CASCADE',
        'auditstream',
        part_name,
        pg_catalog.pg_get_userbyid(grantee_oid)
      );
    END IF;
  END LOOP;
  IF switched_role THEN
    SET LOCAL ROLE NONE;
    IF prev_role <> current_user THEN
      EXECUTE pg_catalog.format('SET LOCAL ROLE %I', prev_role);
    END IF;
  END IF;
END
$$;

DO $$
DECLARE
  grant_mode text := pg_catalog.current_setting('auditstream._granted_self', true);
BEGIN
  IF grant_mode = 'self_row' THEN
    EXECUTE pg_catalog.format('REVOKE "auditstream_owner" FROM %I', current_user);
  ELSIF grant_mode = 'both' THEN
    EXECUTE pg_catalog.format('REVOKE INHERIT OPTION FOR "auditstream_owner" FROM %I', current_user);
    EXECUTE pg_catalog.format('REVOKE SET OPTION FOR "auditstream_owner" FROM %I', current_user);
  ELSIF grant_mode = 'inherit' THEN
    EXECUTE pg_catalog.format('REVOKE INHERIT OPTION FOR "auditstream_owner" FROM %I', current_user);
  ELSIF grant_mode = 'set' THEN
    EXECUTE pg_catalog.format('REVOKE SET OPTION FOR "auditstream_owner" FROM %I', current_user);
  END IF;
  IF grant_mode IS NOT NULL AND grant_mode <> '' THEN
    PERFORM pg_catalog.set_config('auditstream._granted_self', '', true);
  END IF;
END
$$
