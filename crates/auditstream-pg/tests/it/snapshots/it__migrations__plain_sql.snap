CREATE OR REPLACE FUNCTION "auditstream".log_event(
  action text,
  target jsonb DEFAULT NULL,
  data jsonb DEFAULT NULL
)
RETURNS uuid
LANGUAGE plpgsql
SECURITY DEFINER
SET search_path = pg_catalog, pg_temp
AS $fn$
DECLARE
  resolved record;
  v_event_id uuid;
BEGIN
  IF action IS NULL
     OR pg_catalog.char_length(pg_catalog.btrim(action)) < 1
     OR pg_catalog.char_length(action) > 64
     OR pg_catalog.upper(pg_catalog.btrim(action)) IN ('INSERT', 'UPDATE', 'DELETE', 'TRUNCATE') THEN
    RAISE EXCEPTION 'auditstream.log_event: invalid action %', action
      USING ERRCODE = '22023';
  END IF;

  IF target IS NOT NULL
     AND pg_catalog.jsonb_typeof(target) IS DISTINCT FROM 'object' THEN
    RAISE EXCEPTION 'auditstream.log_event: target must be a JSON object or NULL'
      USING ERRCODE = '22023';
  END IF;

  IF data IS NOT NULL
     AND pg_catalog.jsonb_typeof(data) IS DISTINCT FROM 'object' THEN
    RAISE EXCEPTION 'auditstream.log_event: data must be a JSON object or NULL'
      USING ERRCODE = '22023';
  END IF;

  SELECT r.actor, r.context, r.actor_source
    INTO resolved
    FROM "auditstream".resolve_actor() AS r;

  INSERT INTO "auditstream".changes (
    source,
    op,
    record_id,
    after,
    actor,
    context,
    actor_source,
    db_user,
    schema_version
  )
  VALUES (
    'app',
    action,
    target,
    data,
    resolved.actor,
    resolved.context,
    resolved.actor_source,
    session_user,
    1
  )
  RETURNING event_id INTO v_event_id;

  RETURN v_event_id;
END
$fn$;

DO $$
BEGIN
  IF EXISTS (SELECT 1 FROM pg_catalog.pg_proc
             WHERE oid = '"auditstream".log_event(text, jsonb, jsonb)'::pg_catalog.regprocedure
               AND proowner <> 'auditstream_owner'::pg_catalog.regrole) THEN
    ALTER FUNCTION "auditstream".log_event(text, jsonb, jsonb) OWNER TO "auditstream_owner";
  END IF;
END
$$;

REVOKE ALL ON SCHEMA "auditstream" FROM PUBLIC;

REVOKE ALL ON "auditstream".changes FROM PUBLIC;

REVOKE ALL ON FUNCTION "auditstream".log_event(text, jsonb, jsonb) FROM PUBLIC;

GRANT USAGE ON SCHEMA "auditstream" TO "app_user";

GRANT SELECT ON "auditstream".changes TO "app_user";

GRANT EXECUTE ON FUNCTION "auditstream".log_event(text, jsonb, jsonb) TO "app_user";

CREATE OR REPLACE FUNCTION "auditstream".resolve_actor(
  OUT actor jsonb,
  OUT context jsonb,
  OUT actor_source text
)
LANGUAGE plpgsql
STABLE
SECURITY DEFINER
SET search_path = pg_catalog, pg_temp
AS $fn$
DECLARE
  raw_setting text;
  q_tail text;
  q_len integer;
  prefix text;
  slash_rev integer;
  open_pos integer;
  comment_body text;
  key_pos integer;
  quote_pos integer;
  has_tag boolean := false;
  raw_b64 text;
  b64_len integer;
  decoded_bytes bytea;
  payload jsonb;
  v_source text;
  obo jsonb;
  ctx jsonb;
  claims jsonb;
BEGIN
  raw_setting := NULLIF(pg_catalog.current_setting('auditstream.actor', true), '');
  IF raw_setting IS NOT NULL THEN
    IF pg_catalog.octet_length(raw_setting) > 512 THEN
      actor := NULL; context := NULL; actor_source := 'invalid'; RETURN;
    END IF;
    BEGIN
      payload := raw_setting::jsonb;
    EXCEPTION WHEN others THEN
      actor := NULL; context := NULL; actor_source := 'invalid'; RETURN;
    END;
    v_source := 'set_config';
  ELSE
    q_tail := pg_catalog.rtrim(
      pg_catalog.right(pg_catalog.current_query(), 4096),
      E' \t\n\r\f\v;'
    );
    q_len := pg_catalog.length(q_tail);
    IF q_len >= 4
       AND pg_catalog.right(q_tail, 2) = '*/'
       AND pg_catalog.strpos(q_tail, 'auditstream=''') > 0 THEN
      prefix := pg_catalog.left(q_tail, q_len - 2);
      slash_rev := pg_catalog.strpos(pg_catalog.reverse(prefix), '/');
      IF slash_rev > 0 THEN
        open_pos := q_len - 1 - slash_rev;
        IF pg_catalog.substr(prefix, open_pos, 2) = '/*' THEN
          comment_body := pg_catalog.substr(prefix, open_pos + 2);
          IF pg_catalog.left(comment_body, 13) = 'auditstream=''' THEN
            quote_pos := pg_catalog.strpos(pg_catalog.substr(comment_body, 14), '''');
            IF quote_pos > 0 THEN
              raw_b64 := pg_catalog.substr(comment_body, 14, quote_pos - 1);
              has_tag := true;
            END IF;
          ELSE
            key_pos := pg_catalog.strpos(comment_body, ',auditstream=''');
            IF key_pos > 0 THEN
              quote_pos := pg_catalog.strpos(pg_catalog.substr(comment_body, key_pos + 14), '''');
              IF quote_pos > 0 THEN
                raw_b64 := pg_catalog.substr(comment_body, key_pos + 14, quote_pos - 1);
                has_tag := true;
              END IF;
            END IF;
          END IF;
        END IF;
      END IF;
    END IF;
    IF has_tag THEN
      b64_len := pg_catalog.length(raw_b64);
      IF b64_len < 1
         OR b64_len > 683
         OR b64_len % 4 = 1
         OR pg_catalog.ltrim(
              raw_b64,
              'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789_-'
            ) <> '' THEN
        actor := NULL; context := NULL; actor_source := 'invalid'; RETURN;
      END IF;
      BEGIN
        decoded_bytes := pg_catalog.decode(
          pg_catalog.translate(raw_b64, '-_', '+/')
            || pg_catalog.repeat('=', (4 - b64_len % 4) % 4),
          'base64'
        );
        IF pg_catalog.octet_length(decoded_bytes) > 512 THEN
          actor := NULL; context := NULL; actor_source := 'invalid'; RETURN;
        END IF;
        payload := pg_catalog.convert_from(decoded_bytes, 'UTF8')::jsonb;
      EXCEPTION WHEN others THEN
        actor := NULL; context := NULL; actor_source := 'invalid'; RETURN;
      END;
      v_source := 'comment';
    END IF;
  END IF;

  IF v_source IS NOT NULL THEN
    IF pg_catalog.jsonb_typeof(payload) IS DISTINCT FROM 'object'
       OR pg_catalog.jsonb_typeof(payload->'type') IS DISTINCT FROM 'string'
       OR payload->>'type' NOT IN ('user', 'api_key', 'ai_agent', 'service', 'system')
       OR pg_catalog.jsonb_typeof(payload->'id') IS DISTINCT FROM 'string'
       OR pg_catalog.length(payload->>'id') = 0 THEN
      actor := NULL; context := NULL; actor_source := 'invalid'; RETURN;
    END IF;
    IF pg_catalog.jsonb_exists(payload, 'tenant')
       AND (
         pg_catalog.jsonb_typeof(payload->'tenant') IS DISTINCT FROM 'string'
         OR pg_catalog.length(payload->>'tenant') = 0
       ) THEN
      actor := NULL; context := NULL; actor_source := 'invalid'; RETURN;
    END IF;
    IF pg_catalog.jsonb_exists(payload, 'onBehalfOf') THEN
      obo := payload->'onBehalfOf';
      IF pg_catalog.jsonb_typeof(obo) IS DISTINCT FROM 'object'
         OR pg_catalog.jsonb_typeof(obo->'type') IS DISTINCT FROM 'string'
         OR obo->>'type' NOT IN ('user', 'api_key', 'ai_agent', 'service', 'system')
         OR pg_catalog.jsonb_typeof(obo->'id') IS DISTINCT FROM 'string'
         OR pg_catalog.length(obo->>'id') = 0
         OR pg_catalog.jsonb_exists(obo, 'onBehalfOf')
         OR (
           pg_catalog.jsonb_exists(obo, 'tenant')
           AND (
             pg_catalog.jsonb_typeof(obo->'tenant') IS DISTINCT FROM 'string'
             OR pg_catalog.length(obo->>'tenant') = 0
           )
         ) THEN
        actor := NULL; context := NULL; actor_source := 'invalid'; RETURN;
      END IF;
    END IF;
    IF pg_catalog.jsonb_exists(payload, 'context') THEN
      ctx := payload->'context';
      IF pg_catalog.jsonb_typeof(ctx) IS DISTINCT FROM 'object'
         OR (
           pg_catalog.jsonb_exists(ctx, 'requestId')
           AND (pg_catalog.jsonb_typeof(ctx->'requestId') IS DISTINCT FROM 'string' OR pg_catalog.length(ctx->>'requestId') = 0)
         )
         OR (
           pg_catalog.jsonb_exists(ctx, 'source')
           AND (pg_catalog.jsonb_typeof(ctx->'source') IS DISTINCT FROM 'string' OR pg_catalog.length(ctx->>'source') = 0)
         )
         OR (
           pg_catalog.jsonb_exists(ctx, 'ip')
           AND (pg_catalog.jsonb_typeof(ctx->'ip') IS DISTINCT FROM 'string' OR pg_catalog.length(ctx->>'ip') = 0)
         )
         OR (
           pg_catalog.jsonb_exists(ctx, 'userAgent')
           AND (pg_catalog.jsonb_typeof(ctx->'userAgent') IS DISTINCT FROM 'string' OR pg_catalog.length(ctx->>'userAgent') = 0)
         ) THEN
        actor := NULL; context := NULL; actor_source := 'invalid'; RETURN;
      END IF;
      context := ctx;
      actor := payload - 'context';
    ELSE
      actor := payload;
    END IF;
    actor_source := v_source;
    RETURN;
  END IF;

  raw_setting := NULLIF(pg_catalog.current_setting('request.jwt.claims', true), '');
  IF raw_setting IS NOT NULL THEN
    BEGIN
      claims := raw_setting::jsonb;
    EXCEPTION WHEN others THEN
      actor := NULL; context := NULL; actor_source := 'invalid'; RETURN;
    END;
    IF pg_catalog.jsonb_typeof(claims) IS DISTINCT FROM 'object' THEN
      actor := NULL; context := NULL; actor_source := 'invalid'; RETURN;
    END IF;
    IF pg_catalog.jsonb_exists(claims, 'sub')
       AND pg_catalog.jsonb_typeof(claims->'sub') IS DISTINCT FROM 'null' THEN
      IF pg_catalog.jsonb_typeof(claims->'sub') IS DISTINCT FROM 'string'
         OR pg_catalog.length(claims->>'sub') = 0 THEN
        actor := NULL; context := NULL; actor_source := 'invalid'; RETURN;
      END IF;
      actor := pg_catalog.jsonb_build_object('type', 'user', 'id', claims->>'sub');
      context := NULL;
      actor_source := 'jwt';
      RETURN;
    END IF;
  END IF;

  actor := NULL;
  context := NULL;
  actor_source := NULL;
END
$fn$;

DO $$
BEGIN
  IF EXISTS (SELECT 1 FROM pg_catalog.pg_proc
             WHERE oid = '"auditstream".resolve_actor()'::pg_catalog.regprocedure
               AND proowner <> 'auditstream_owner'::pg_catalog.regrole) THEN
    ALTER FUNCTION "auditstream".resolve_actor() OWNER TO "auditstream_owner";
  END IF;
END
$$;

REVOKE ALL ON FUNCTION "auditstream".resolve_actor() FROM PUBLIC;

CREATE OR REPLACE FUNCTION "auditstream".capture()
RETURNS trigger
LANGUAGE plpgsql
SECURITY DEFINER
SET search_path = pg_catalog, pg_temp
AS $fn$
DECLARE
  resolved record;
  pk_json jsonb;
  pk_len integer;
  pk_single text;
  pk_cols text[] := '{}';
  ex_json jsonb;
  ex_len integer;
  ex_cols text[] := '{}';
  has_ex boolean := false;
  v_schema text;
  v_table text;
  v_relid oid;
  v_before jsonb;
  v_after jsonb;
  v_record_id jsonb;
  v_changed text[];
BEGIN
  IF TG_NARGS >= 4 THEN
    v_schema := TG_ARGV[2];
    v_table := TG_ARGV[3];
    v_relid := pg_catalog.to_regclass(pg_catalog.format('%I.%I', v_schema, v_table));
  ELSE
    v_schema := TG_TABLE_SCHEMA;
    v_table := TG_TABLE_NAME;
    v_relid := TG_RELID;
  END IF;

  IF TG_OP = 'TRUNCATE' THEN
    resolved := "auditstream".resolve_actor();
    INSERT INTO "auditstream".changes (
      source, schema_name, table_name, table_oid, op,
      actor, context, actor_source, db_user, schema_version
    )
    VALUES (
      'db', v_schema, v_table, v_relid, 'TRUNCATE',
      resolved.actor, resolved.context, resolved.actor_source,
      session_user, 1
    );
    RETURN NULL;
  END IF;

  IF TG_NARGS >= 1 AND TG_ARGV[0] <> '[]' THEN
    pk_json := TG_ARGV[0]::jsonb;
    pk_len := pg_catalog.jsonb_array_length(pk_json);
    IF pk_len = 1 THEN
      pk_single := pk_json->>0;
    ELSIF pk_len > 1 THEN
      pk_cols := ARRAY(SELECT pg_catalog.jsonb_array_elements_text(pk_json));
    END IF;
  END IF;
  IF TG_NARGS >= 2 AND TG_ARGV[1] <> '[]' THEN
    ex_json := TG_ARGV[1]::jsonb;
    ex_len := pg_catalog.jsonb_array_length(ex_json);
    IF ex_len = 1 THEN
      ex_cols := ARRAY[ex_json->>0];
      has_ex := true;
    ELSIF ex_len > 1 THEN
      ex_cols := ARRAY(SELECT pg_catalog.jsonb_array_elements_text(ex_json));
      has_ex := true;
    END IF;
  END IF;

  IF TG_OP = 'UPDATE' THEN
    IF has_ex THEN
      v_before := pg_catalog.to_jsonb(OLD) - ex_cols;
      v_after := pg_catalog.to_jsonb(NEW) - ex_cols;
    ELSE
      v_before := pg_catalog.to_jsonb(OLD);
      v_after := pg_catalog.to_jsonb(NEW);
    END IF;
    IF v_after = v_before THEN
      RETURN NULL;
    END IF;
    v_changed := ARRAY(
      SELECT e.k
        FROM pg_catalog.jsonb_each(v_after) AS e(k, v)
       WHERE v_before->e.k IS DISTINCT FROM e.v
    );
    IF pk_single IS NOT NULL THEN
      v_record_id := pg_catalog.jsonb_build_object(pk_single, v_after->pk_single);
    ELSIF pg_catalog.cardinality(pk_cols) > 0 THEN
      SELECT pg_catalog.jsonb_object_agg(k, v_after->k)
        INTO v_record_id
        FROM pg_catalog.unnest(pk_cols) AS k;
    END IF;
    resolved := "auditstream".resolve_actor();
    INSERT INTO "auditstream".changes (
      source, schema_name, table_name, table_oid, op,
      record_id, before, after, changed,
      actor, context, actor_source, db_user, schema_version
    )
    VALUES (
      'db',
      v_schema,
      v_table,
      v_relid,
      'UPDATE',
      v_record_id,
      v_before,
      v_after,
      v_changed,
      resolved.actor,
      resolved.context,
      resolved.actor_source,
      session_user,
      1
    );
    RETURN NULL;
  END IF;

  IF TG_OP = 'INSERT' THEN
    resolved := "auditstream".resolve_actor();
    IF pk_single IS NOT NULL AND NOT has_ex THEN
      INSERT INTO "auditstream".changes (
        source, schema_name, table_name, table_oid, op,
        record_id, before, after, changed,
        actor, context, actor_source, db_user, schema_version
      )
      SELECT
        'db',
        v_schema,
        v_table,
        v_relid,
        'INSERT',
        pg_catalog.jsonb_build_object(pk_single, s.row_after->pk_single),
        NULL,
        s.row_after,
        NULL,
        resolved.actor,
        resolved.context,
        resolved.actor_source,
        session_user,
        1
      FROM (
        SELECT pg_catalog.to_jsonb(r) AS row_after
          FROM new_rows AS r
        OFFSET 0
      ) AS s;
    ELSE
      INSERT INTO "auditstream".changes (
        source, schema_name, table_name, table_oid, op,
        record_id, before, after, changed,
        actor, context, actor_source, db_user, schema_version
      )
      SELECT
        'db',
        v_schema,
        v_table,
        v_relid,
        'INSERT',
        CASE
          WHEN pk_single IS NOT NULL THEN pg_catalog.jsonb_build_object(pk_single, s.row_after->pk_single)
          WHEN pg_catalog.cardinality(pk_cols) > 0 THEN (
            SELECT pg_catalog.jsonb_object_agg(k, s.row_after->k)
              FROM pg_catalog.unnest(pk_cols) AS k
          )
        END,
        NULL,
        s.row_after,
        NULL,
        resolved.actor,
        resolved.context,
        resolved.actor_source,
        session_user,
        1
      FROM (
        SELECT CASE WHEN has_ex THEN pg_catalog.to_jsonb(r) - ex_cols ELSE pg_catalog.to_jsonb(r) END AS row_after
          FROM new_rows AS r
        OFFSET 0
      ) AS s;
    END IF;
    RETURN NULL;
  END IF;

  IF TG_OP = 'DELETE' THEN
    resolved := "auditstream".resolve_actor();
    IF pk_single IS NOT NULL AND NOT has_ex THEN
      INSERT INTO "auditstream".changes (
        source, schema_name, table_name, table_oid, op,
        record_id, before, after, changed,
        actor, context, actor_source, db_user, schema_version
      )
      SELECT
        'db',
        v_schema,
        v_table,
        v_relid,
        'DELETE',
        pg_catalog.jsonb_build_object(pk_single, s.row_before->pk_single),
        s.row_before,
        NULL,
        NULL,
        resolved.actor,
        resolved.context,
        resolved.actor_source,
        session_user,
        1
      FROM (
        SELECT pg_catalog.to_jsonb(r) AS row_before
          FROM old_rows AS r
        OFFSET 0
      ) AS s;
    ELSE
      INSERT INTO "auditstream".changes (
        source, schema_name, table_name, table_oid, op,
        record_id, before, after, changed,
        actor, context, actor_source, db_user, schema_version
      )
      SELECT
        'db',
        v_schema,
        v_table,
        v_relid,
        'DELETE',
        CASE
          WHEN pk_single IS NOT NULL THEN pg_catalog.jsonb_build_object(pk_single, s.row_before->pk_single)
          WHEN pg_catalog.cardinality(pk_cols) > 0 THEN (
            SELECT pg_catalog.jsonb_object_agg(k, s.row_before->k)
              FROM pg_catalog.unnest(pk_cols) AS k
          )
        END,
        s.row_before,
        NULL,
        NULL,
        resolved.actor,
        resolved.context,
        resolved.actor_source,
        session_user,
        1
      FROM (
        SELECT CASE WHEN has_ex THEN pg_catalog.to_jsonb(r) - ex_cols ELSE pg_catalog.to_jsonb(r) END AS row_before
          FROM old_rows AS r
        OFFSET 0
      ) AS s;
    END IF;
    RETURN NULL;
  END IF;

  RETURN NULL;
END
$fn$;

DO $$
BEGIN
  IF EXISTS (SELECT 1 FROM pg_catalog.pg_proc
             WHERE oid = '"auditstream".capture()'::pg_catalog.regprocedure
               AND proowner <> 'auditstream_owner'::pg_catalog.regrole) THEN
    ALTER FUNCTION "auditstream".capture() OWNER TO "auditstream_owner";
  END IF;
END
$$;

REVOKE ALL ON FUNCTION "auditstream".capture() FROM PUBLIC;

CREATE OR REPLACE TRIGGER auditstream_insert
  AFTER INSERT ON "public"."invoice"
  REFERENCING NEW TABLE AS new_rows
  FOR EACH STATEMENT
  EXECUTE FUNCTION "auditstream".capture('["id"]', '["password_hash"]');

CREATE OR REPLACE TRIGGER auditstream_update
  AFTER UPDATE ON "public"."invoice"
  FOR EACH ROW
  EXECUTE FUNCTION "auditstream".capture('["id"]', '["password_hash"]');

CREATE OR REPLACE TRIGGER auditstream_delete
  AFTER DELETE ON "public"."invoice"
  REFERENCING OLD TABLE AS old_rows
  FOR EACH STATEMENT
  EXECUTE FUNCTION "auditstream".capture('["id"]', '["password_hash"]');

CREATE OR REPLACE TRIGGER auditstream_truncate
  AFTER TRUNCATE ON "public"."invoice"
  FOR EACH STATEMENT
  EXECUTE FUNCTION "auditstream".capture('["id"]', '["password_hash"]');

CREATE OR REPLACE TRIGGER auditstream_insert
  AFTER INSERT ON "public"."line_item"
  REFERENCING NEW TABLE AS new_rows
  FOR EACH STATEMENT
  EXECUTE FUNCTION "auditstream".capture('["id"]', '[]');

CREATE OR REPLACE TRIGGER auditstream_update
  AFTER UPDATE ON "public"."line_item"
  FOR EACH ROW
  EXECUTE FUNCTION "auditstream".capture('["id"]', '[]');

CREATE OR REPLACE TRIGGER auditstream_delete
  AFTER DELETE ON "public"."line_item"
  REFERENCING OLD TABLE AS old_rows
  FOR EACH STATEMENT
  EXECUTE FUNCTION "auditstream".capture('["id"]', '[]');

CREATE OR REPLACE TRIGGER auditstream_truncate
  AFTER TRUNCATE ON "public"."line_item"
  FOR EACH STATEMENT
  EXECUTE FUNCTION "auditstream".capture('["id"]', '[]');

DO $$
DECLARE
  prev_role name := current_user;
  base_month timestamp := pg_catalog.date_trunc('month', pg_catalog.now() AT TIME ZONE 'UTC');
  m int;
  month_start timestamp;
  month_end timestamp;
  part_name name;
  grantee_oid oid;
  managed_tables name[] := ARRAY[]::name[];
BEGIN
  EXECUTE pg_catalog.format('SET LOCAL ROLE %I', 'auditstream_owner');
  FOR m IN 1..3 LOOP
    month_start := base_month + pg_catalog.make_interval(months => m);
    month_end := base_month + pg_catalog.make_interval(months => m + 1);
    part_name := 'changes_' || pg_catalog.to_char(month_start, 'YYYY_MM');
    EXECUTE pg_catalog.format(
      'CREATE TABLE IF NOT EXISTS %I.%I PARTITION OF %I.changes FOR VALUES FROM (%L) TO (%L)',
      'auditstream',
      part_name,
      'auditstream',
      pg_catalog.to_char(month_start, 'YYYY-MM-DD HH24:MI:SS') || '+00',
      pg_catalog.to_char(month_end, 'YYYY-MM-DD HH24:MI:SS') || '+00'
    );
    managed_tables := pg_catalog.array_append(managed_tables, part_name);
  END LOOP;
  SET LOCAL ROLE NONE;
  IF prev_role <> current_user THEN
    EXECUTE pg_catalog.format('SET LOCAL ROLE %I', prev_role);
  END IF;
  FOR part_name IN
    SELECT c.relname FROM pg_catalog.pg_class c
    JOIN pg_catalog.pg_namespace n ON n.oid = c.relnamespace
    WHERE n.nspname = 'auditstream' AND c.relname = ANY (managed_tables)
      AND c.relowner <> 'auditstream_owner'::pg_catalog.regrole
    ORDER BY c.relname
  LOOP
    EXECUTE pg_catalog.format('ALTER TABLE %I.%I OWNER TO %I', 'auditstream', part_name, 'auditstream_owner');
  END LOOP;
  FOR part_name, grantee_oid IN
    SELECT DISTINCT c.relname, a.grantee
    FROM pg_catalog.pg_class c
    JOIN pg_catalog.pg_namespace n ON n.oid = c.relnamespace
    CROSS JOIN LATERAL pg_catalog.aclexplode(c.relacl) AS a
    WHERE n.nspname = 'auditstream'
      AND c.relname = ANY (managed_tables)
      AND c.relacl IS NOT NULL
      AND a.grantee <> c.relowner
      AND (a.grantee = 0 OR a.privilege_type <> 'SELECT')
    ORDER BY c.relname, a.grantee
  LOOP
    IF grantee_oid = 0 THEN
      EXECUTE pg_catalog.format('REVOKE ALL ON TABLE %I.%I FROM PUBLIC', 'auditstream', part_name);
    ELSIF part_name = 'changes' THEN
      EXECUTE pg_catalog.format(
        'REVOKE INSERT, UPDATE, DELETE, TRUNCATE, REFERENCES, TRIGGER ON TABLE %I.%I FROM %I',
        'auditstream',
        part_name,
        pg_catalog.pg_get_userbyid(grantee_oid)
      );
      IF pg_catalog.current_setting('server_version_num')::int >= 170000 THEN
        EXECUTE pg_catalog.format(
          'REVOKE MAINTAIN ON TABLE %I.%I FROM %I',
          'auditstream',
          part_name,
          pg_catalog.pg_get_userbyid(grantee_oid)
        );
      END IF;
    ELSE
      EXECUTE pg_catalog.format(
        'REVOKE ALL ON TABLE %I.%I FROM %I',
        'auditstream',
        part_name,
        pg_catalog.pg_get_userbyid(grantee_oid)
      );
    END IF;
  END LOOP;
END
$$;

DO $$
BEGIN
  IF pg_catalog.current_setting('auditstream._granted_self', true) = '1' THEN
    EXECUTE pg_catalog.format('REVOKE "auditstream_owner" FROM %I', current_user);
    PERFORM pg_catalog.set_config('auditstream._granted_self', '', true);
  END IF;
END
$$;

DO $$
BEGIN
  IF pg_catalog.current_setting('auditstream._lock_timeout_fallback', true) = 'on' THEN
    SET LOCAL lock_timeout = 0;
    PERFORM pg_catalog.set_config('auditstream._lock_timeout_fallback', 'off', true);
  END IF;
  PERFORM pg_catalog.set_config('auditstream._migration_tx', 'off', true);
END
$$;

COMMIT;
