---
source: crates/auditstream-pg/tests/it/triggers.rs
expression: "no_pk.join(\";\\n\\n\")"
---
DO $$
BEGIN
  PERFORM pg_catalog.set_config('auditstream._migration_tx', 'on', true);
END
$$;

DO $$
DECLARE
  grant_mode text := 'none';
  grantor_role text := '';
  grantor_oid oid;
  has_grantor_row boolean := false;
BEGIN
  IF pg_catalog.current_setting('auditstream._migration_tx', true) IS DISTINCT FROM 'on' THEN
    RAISE EXCEPTION 'Auditstream trigger statements must run inside a single transaction'
      USING HINT = 'Wrap the generated statements in BEGIN; ... COMMIT; or use a transactional migrator.';
  END IF;
  IF pg_catalog.current_setting('server_version_num')::int >= 160000 THEN
    IF NOT pg_catalog.pg_has_role(current_user, 'auditstream_owner', 'SET') THEN
      SELECT m.member
        INTO grantor_oid
        FROM pg_catalog.pg_auth_members m
        JOIN pg_catalog.pg_roles r ON r.oid = m.roleid
        JOIN pg_catalog.pg_roles u ON u.rolname = current_user
       WHERE r.rolname = 'auditstream_owner'
         AND m.admin_option
         AND (m.member = u.oid OR pg_catalog.pg_has_role(u.oid, m.member, 'USAGE'))
       ORDER BY (m.member = u.oid) DESC, m.member
       LIMIT 1;
      IF grantor_oid IS NULL THEN
        EXECUTE pg_catalog.format(
          'GRANT "auditstream_owner" TO %I WITH INHERIT FALSE, SET TRUE',
          current_user
        );
        grant_mode := 'self_row';
      ELSE
        grantor_role := pg_catalog.pg_get_userbyid(grantor_oid)::text;
        SELECT EXISTS (
          SELECT 1
            FROM pg_catalog.pg_auth_members m
            JOIN pg_catalog.pg_roles r ON r.oid = m.roleid
            JOIN pg_catalog.pg_roles u ON u.oid = m.member
           WHERE r.rolname = 'auditstream_owner'
             AND u.rolname = current_user
             AND m.grantor = grantor_oid
        ) INTO has_grantor_row;
        IF NOT has_grantor_row THEN
          EXECUTE pg_catalog.format(
            'GRANT "auditstream_owner" TO %I WITH INHERIT FALSE, SET TRUE GRANTED BY %I',
            current_user,
            grantor_role
          );
          grant_mode := 'self_row';
        ELSE
          EXECUTE pg_catalog.format(
            'GRANT "auditstream_owner" TO %I WITH SET TRUE GRANTED BY %I',
            current_user,
            grantor_role
          );
          grant_mode := 'set';
        END IF;
      END IF;
    END IF;
  ELSIF NOT pg_catalog.pg_has_role(current_user, 'auditstream_owner', 'MEMBER') THEN
    EXECUTE pg_catalog.format('GRANT "auditstream_owner" TO %I', current_user);
    grant_mode := 'self_row';
  END IF;
  PERFORM pg_catalog.set_config('auditstream._triggers_granted_self', grant_mode, true);
  PERFORM pg_catalog.set_config('auditstream._triggers_granted_self_grantor', grantor_role, true);
END
$$;

DO $$
DECLARE
  caller name := current_user;
  fn_name name;
  need_reconcile boolean := false;
  granted_schema_usage boolean := false;
BEGIN
  SELECT EXISTS (
    SELECT 1 FROM pg_catalog.pg_proc p
    JOIN pg_catalog.pg_namespace n ON n.oid = p.pronamespace
     WHERE n.nspname = 'auditstream'
       AND p.proname IN ('resolve_actor', 'capture')
       AND p.prokind = 'f'
       AND p.pronargs = 0
       AND p.proowner <> 'auditstream_owner'::pg_catalog.regrole
  ) INTO need_reconcile;

  IF NOT need_reconcile THEN
    RETURN;
  END IF;

  IF NOT pg_catalog.pg_has_role(caller, 'auditstream_owner', 'USAGE') THEN
    IF NOT EXISTS (
      SELECT 1 FROM pg_catalog.pg_namespace n
      CROSS JOIN LATERAL pg_catalog.aclexplode(
        COALESCE(n.nspacl, pg_catalog.acldefault('n', n.nspowner))
      ) AS a
       WHERE n.nspname = 'auditstream'
         AND a.grantee <> 0
         AND pg_catalog.pg_get_userbyid(a.grantee)::text = caller::text
         AND a.privilege_type = 'USAGE'
    ) THEN
      EXECUTE pg_catalog.format('SET LOCAL ROLE %I', 'auditstream_owner');
      EXECUTE pg_catalog.format('GRANT USAGE ON SCHEMA %I TO %I', 'auditstream', caller);
      SET LOCAL ROLE NONE;
      IF caller <> current_user THEN
        EXECUTE pg_catalog.format('SET LOCAL ROLE %I', caller);
      END IF;
      granted_schema_usage := true;
    END IF;
  END IF;

  FOREACH fn_name IN ARRAY ARRAY['resolve_actor', 'capture']::name[] LOOP
    IF EXISTS (
      SELECT 1 FROM pg_catalog.pg_proc p
      JOIN pg_catalog.pg_namespace n ON n.oid = p.pronamespace
       WHERE n.nspname = 'auditstream'
         AND p.proname = fn_name
         AND p.prokind = 'f'
         AND p.pronargs = 0
         AND p.proowner <> 'auditstream_owner'::pg_catalog.regrole
    ) THEN
      EXECUTE pg_catalog.format('ALTER FUNCTION %I.%I() OWNER TO %I', 'auditstream', fn_name, 'auditstream_owner');
    END IF;
  END LOOP;

  IF granted_schema_usage THEN
    EXECUTE pg_catalog.format('SET LOCAL ROLE %I', 'auditstream_owner');
    EXECUTE pg_catalog.format('REVOKE USAGE ON SCHEMA %I FROM %I', 'auditstream', caller);
    SET LOCAL ROLE NONE;
    IF caller <> current_user THEN
      EXECUTE pg_catalog.format('SET LOCAL ROLE %I', caller);
    END IF;
  END IF;
END
$$;

DO $$
BEGIN
  PERFORM pg_catalog.set_config('auditstream._prev_role', current_user, true);
  EXECUTE pg_catalog.format('SET LOCAL ROLE %I', 'auditstream_owner');
END
$$;

CREATE OR REPLACE FUNCTION "auditstream".resolve_actor(
  OUT actor jsonb,
  OUT context jsonb,
  OUT actor_source text
)
LANGUAGE plpgsql
STABLE
SECURITY DEFINER
SET search_path = pg_catalog, pg_temp
AS $fn$
DECLARE
  raw_setting text;
  q_tail text;
  q_len integer;
  prefix text;
  slash_rev integer;
  open_pos integer;
  comment_body text;
  body_len integer;
  allow_escapes boolean;
  pos integer;
  eq_pos integer;
  pair_key text;
  key_check text;
  val_start integer;
  val_end integer;
  scan_pos integer;
  quote_rel integer;
  q_idx integer;
  bs_prefix text;
  found_count integer;
  pair_ok boolean;
  has_tag boolean := false;
  raw_b64 text;
  b64_len integer;
  decoded_bytes bytea;
  payload jsonb;
  v_source text;
  obo jsonb;
  ctx jsonb;
  claims jsonb;
BEGIN
  raw_setting := NULLIF(pg_catalog.current_setting('auditstream.actor', true), '');
  IF raw_setting IS NOT NULL THEN
    IF pg_catalog.octet_length(raw_setting) > 512 THEN
      actor := NULL; context := NULL; actor_source := 'invalid'; RETURN;
    END IF;
    BEGIN
      payload := raw_setting::jsonb;
    EXCEPTION WHEN others THEN
      actor := NULL; context := NULL; actor_source := 'invalid'; RETURN;
    END;
    v_source := 'set_config';
  ELSE
    q_tail := pg_catalog.rtrim(
      pg_catalog.right(pg_catalog.current_query(), 4096),
      E' \t\n\r\f\x0b;'
    );
    q_len := pg_catalog.length(q_tail);
    IF q_len >= 4
       AND pg_catalog.right(q_tail, 2) = '*/'
       AND pg_catalog.strpos(q_tail, 'auditstream=''') > 0 THEN
      prefix := pg_catalog.left(q_tail, q_len - 2);
      slash_rev := pg_catalog.strpos(pg_catalog.reverse(prefix), '/');
      IF slash_rev > 0 THEN
        open_pos := q_len - 1 - slash_rev;
        IF pg_catalog.substr(prefix, open_pos, 2) = '/*'
           AND (
             (open_pos > 1 AND pg_catalog.substr(prefix, open_pos - 1, 1) <> '*')
             OR (
               open_pos = 1
               AND (
                 pg_catalog.length(pg_catalog.current_query()) <= 4096
                 OR pg_catalog.left(pg_catalog.right(pg_catalog.current_query(), 4097), 1) <> '*'
               )
             )
           ) THEN
          comment_body := pg_catalog.substr(prefix, open_pos + 2);
          body_len := pg_catalog.length(comment_body);
          IF body_len >= 14
             AND pg_catalog.left(comment_body, 13) = 'auditstream='''
             AND pg_catalog.right(comment_body, 1) = '''' THEN
            IF pg_catalog.strpos(pg_catalog.substr(comment_body, 14, body_len - 14), '''') = 0 THEN
              raw_b64 := pg_catalog.substr(comment_body, 14, body_len - 14);
              has_tag := true;
            END IF;
          END IF;
          IF NOT has_tag AND pg_catalog.strpos(comment_body, 'auditstream=''') > 0 THEN
            FOR pass_idx IN 0..1 LOOP
              allow_escapes := (pass_idx = 1);
              IF allow_escapes AND pg_catalog.strpos(comment_body, E'\\''') = 0 THEN
                EXIT;
              END IF;
              pos := 1;
              found_count := 0;
              pair_ok := true;
              raw_b64 := NULL;
              WHILE pos <= body_len LOOP
                eq_pos := pg_catalog.strpos(pg_catalog.substr(comment_body, pos), '=''');
                IF eq_pos <= 1 THEN
                  pair_ok := false;
                  EXIT;
                END IF;
                pair_key := pg_catalog.substr(comment_body, pos, eq_pos - 1);
                key_check := CASE
                  WHEN allow_escapes THEN pg_catalog.replace(pair_key, E'\\''', '')
                  ELSE pair_key
                END;
                IF pg_catalog.ltrim(
                     key_check,
                     'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789_-.*~()!%'
                   ) <> '' THEN
                  pair_ok := false;
                  EXIT;
                END IF;
                val_start := pos + eq_pos + 1;
                val_end := 0;
                IF allow_escapes AND pair_key <> 'auditstream' THEN
                  scan_pos := val_start;
                  WHILE scan_pos <= body_len LOOP
                    quote_rel := pg_catalog.strpos(pg_catalog.substr(comment_body, scan_pos), '''');
                    IF quote_rel = 0 THEN
                      EXIT;
                    END IF;
                    q_idx := scan_pos + quote_rel - 1;
                    IF quote_rel = 1 OR pg_catalog.substr(comment_body, q_idx - 1, 1) <> E'\\' THEN
                      val_end := q_idx;
                      EXIT;
                    END IF;
                    bs_prefix := pg_catalog.substr(comment_body, scan_pos, quote_rel - 1);
                    IF (pg_catalog.length(bs_prefix) - pg_catalog.length(pg_catalog.rtrim(bs_prefix, E'\\'))) % 2 = 0 THEN
                      val_end := q_idx;
                      EXIT;
                    END IF;
                    scan_pos := q_idx + 1;
                  END LOOP;
                ELSE
                  quote_rel := pg_catalog.strpos(pg_catalog.substr(comment_body, val_start), '''');
                  IF quote_rel > 0 THEN
                    val_end := val_start + quote_rel - 1;
                  END IF;
                END IF;
                IF val_end = 0 THEN
                  pair_ok := false;
                  EXIT;
                END IF;
                IF pair_key = 'auditstream' THEN
                  found_count := found_count + 1;
                  IF found_count = 1 THEN
                    raw_b64 := pg_catalog.substr(comment_body, val_start, val_end - val_start);
                  END IF;
                END IF;
                pos := val_end + 1;
                IF pos <= body_len THEN
                  IF pg_catalog.substr(comment_body, pos, 1) <> ',' OR pos = body_len THEN
                    pair_ok := false;
                    EXIT;
                  END IF;
                  pos := pos + 1;
                END IF;
              END LOOP;
              IF pair_ok THEN
                IF found_count > 1 THEN
                  actor := NULL; context := NULL; actor_source := 'invalid'; RETURN;
                END IF;
                IF found_count = 1 THEN
                  has_tag := true;
                  EXIT;
                END IF;
              END IF;
            END LOOP;
          END IF;
        END IF;
      END IF;
    END IF;
    IF has_tag THEN
      b64_len := pg_catalog.length(raw_b64);
      IF b64_len < 1
         OR b64_len > 683
         OR b64_len % 4 = 1
         OR pg_catalog.ltrim(
              raw_b64,
              'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789_-'
            ) <> '' THEN
        actor := NULL; context := NULL; actor_source := 'invalid'; RETURN;
      END IF;
      BEGIN
        decoded_bytes := pg_catalog.decode(
          pg_catalog.translate(raw_b64, '-_', '+/')
            || pg_catalog.repeat('=', (4 - b64_len % 4) % 4),
          'base64'
        );
        IF pg_catalog.octet_length(decoded_bytes) > 512 THEN
          actor := NULL; context := NULL; actor_source := 'invalid'; RETURN;
        END IF;
        payload := pg_catalog.convert_from(decoded_bytes, 'UTF8')::jsonb;
      EXCEPTION WHEN others THEN
        actor := NULL; context := NULL; actor_source := 'invalid'; RETURN;
      END;
      v_source := 'comment';
    END IF;
  END IF;

  IF v_source IS NOT NULL THEN
    IF pg_catalog.jsonb_typeof(payload) IS DISTINCT FROM 'object'
       OR pg_catalog.jsonb_typeof(payload->'type') IS DISTINCT FROM 'string'
       OR payload->>'type' NOT IN ('user', 'api_key', 'ai_agent', 'service', 'system')
       OR pg_catalog.jsonb_typeof(payload->'id') IS DISTINCT FROM 'string'
       OR pg_catalog.length(payload->>'id') = 0 THEN
      actor := NULL; context := NULL; actor_source := 'invalid'; RETURN;
    END IF;
    IF pg_catalog.jsonb_exists(payload, 'tenant')
       AND (
         pg_catalog.jsonb_typeof(payload->'tenant') IS DISTINCT FROM 'string'
         OR pg_catalog.length(payload->>'tenant') = 0
       ) THEN
      actor := NULL; context := NULL; actor_source := 'invalid'; RETURN;
    END IF;
    IF pg_catalog.jsonb_exists(payload, 'onBehalfOf') THEN
      obo := payload->'onBehalfOf';
      IF pg_catalog.jsonb_typeof(obo) IS DISTINCT FROM 'object'
         OR pg_catalog.jsonb_typeof(obo->'type') IS DISTINCT FROM 'string'
         OR obo->>'type' NOT IN ('user', 'api_key', 'ai_agent', 'service', 'system')
         OR pg_catalog.jsonb_typeof(obo->'id') IS DISTINCT FROM 'string'
         OR pg_catalog.length(obo->>'id') = 0
         OR pg_catalog.jsonb_exists(obo, 'onBehalfOf')
         OR (
           pg_catalog.jsonb_exists(obo, 'tenant')
           AND (
             pg_catalog.jsonb_typeof(obo->'tenant') IS DISTINCT FROM 'string'
             OR pg_catalog.length(obo->>'tenant') = 0
           )
         ) THEN
        actor := NULL; context := NULL; actor_source := 'invalid'; RETURN;
      END IF;
    END IF;
    IF pg_catalog.jsonb_exists(payload, 'context') THEN
      ctx := payload->'context';
      IF pg_catalog.jsonb_typeof(ctx) IS DISTINCT FROM 'object'
         OR (
           pg_catalog.jsonb_exists(ctx, 'requestId')
           AND (pg_catalog.jsonb_typeof(ctx->'requestId') IS DISTINCT FROM 'string' OR pg_catalog.length(ctx->>'requestId') = 0)
         )
         OR (
           pg_catalog.jsonb_exists(ctx, 'source')
           AND (pg_catalog.jsonb_typeof(ctx->'source') IS DISTINCT FROM 'string' OR pg_catalog.length(ctx->>'source') = 0)
         )
         OR (
           pg_catalog.jsonb_exists(ctx, 'ip')
           AND (pg_catalog.jsonb_typeof(ctx->'ip') IS DISTINCT FROM 'string' OR pg_catalog.length(ctx->>'ip') = 0)
         )
         OR (
           pg_catalog.jsonb_exists(ctx, 'userAgent')
           AND (pg_catalog.jsonb_typeof(ctx->'userAgent') IS DISTINCT FROM 'string' OR pg_catalog.length(ctx->>'userAgent') = 0)
         ) THEN
        actor := NULL; context := NULL; actor_source := 'invalid'; RETURN;
      END IF;
      context := ctx;
      actor := payload - 'context';
    ELSE
      actor := payload;
    END IF;
    actor_source := v_source;
    RETURN;
  END IF;

  raw_setting := NULLIF(pg_catalog.current_setting('request.jwt.claims', true), '');
  IF raw_setting IS NOT NULL THEN
    BEGIN
      claims := raw_setting::jsonb;
    EXCEPTION WHEN others THEN
      actor := NULL; context := NULL; actor_source := 'invalid'; RETURN;
    END;
    IF pg_catalog.jsonb_typeof(claims) IS DISTINCT FROM 'object' THEN
      actor := NULL; context := NULL; actor_source := 'invalid'; RETURN;
    END IF;
    IF pg_catalog.jsonb_exists(claims, 'sub')
       AND pg_catalog.jsonb_typeof(claims->'sub') IS DISTINCT FROM 'null' THEN
      IF pg_catalog.jsonb_typeof(claims->'sub') IS DISTINCT FROM 'string'
         OR pg_catalog.length(claims->>'sub') = 0
         OR 21 + pg_catalog.octet_length((claims->'sub')::text) > 512 THEN
        actor := NULL; context := NULL; actor_source := 'invalid'; RETURN;
      END IF;
      actor := pg_catalog.jsonb_build_object('type', 'user', 'id', claims->>'sub');
      context := NULL;
      actor_source := 'jwt';
      RETURN;
    END IF;
  END IF;

  actor := NULL;
  context := NULL;
  actor_source := NULL;
END
$fn$;

CREATE OR REPLACE FUNCTION "auditstream".capture()
RETURNS trigger
LANGUAGE plpgsql
SECURITY DEFINER
SET search_path = pg_catalog, pg_temp
AS $fn$
DECLARE
  resolved record;
  pk_json jsonb;
  pk_len integer;
  pk_single text;
  pk_cols text[] := '{}';
  ex_json jsonb;
  ex_len integer;
  ex_cols text[] := '{}';
  has_ex boolean := false;
  v_schema text;
  v_table text;
  v_relid oid;
  v_before jsonb;
  v_after jsonb;
  v_record_id jsonb;
  v_changed text[];
BEGIN
  IF TG_NARGS >= 4 THEN
    v_schema := TG_ARGV[2];
    v_table := TG_ARGV[3];
    SELECT c.oid
      INTO v_relid
      FROM pg_catalog.pg_class c
      JOIN pg_catalog.pg_namespace n ON n.oid = c.relnamespace
     WHERE n.nspname = v_schema
       AND c.relname = v_table;
    IF v_relid IS NULL OR (
      v_relid <> TG_RELID
      AND NOT EXISTS (
        SELECT 1
          FROM pg_catalog.pg_partition_ancestors(TG_RELID) AS a(relid)
         WHERE a.relid = v_relid
      )
    ) THEN
      RAISE EXCEPTION 'auditstream.capture: trigger relation % is not a partition of %.%',
        TG_RELID::pg_catalog.regclass, v_schema, v_table
        USING ERRCODE = '42501';
    END IF;
  ELSE
    v_schema := TG_TABLE_SCHEMA;
    v_table := TG_TABLE_NAME;
    v_relid := TG_RELID;
  END IF;

  IF TG_OP = 'TRUNCATE' THEN
    resolved := "auditstream".resolve_actor();
    INSERT INTO "auditstream".changes (
      source, schema_name, table_name, table_oid, op,
      actor, context, actor_source, db_user, schema_version
    )
    VALUES (
      'db', v_schema, v_table, v_relid, 'TRUNCATE',
      resolved.actor, resolved.context, resolved.actor_source,
      session_user, 1
    );
    RETURN NULL;
  END IF;

  IF TG_NARGS >= 1 AND TG_ARGV[0] <> '[]' THEN
    pk_json := TG_ARGV[0]::jsonb;
    pk_len := pg_catalog.jsonb_array_length(pk_json);
    IF pk_len = 1 THEN
      pk_single := pk_json->>0;
    ELSIF pk_len > 1 THEN
      pk_cols := ARRAY(SELECT pg_catalog.jsonb_array_elements_text(pk_json));
    END IF;
  END IF;
  IF TG_NARGS >= 2 AND TG_ARGV[1] <> '[]' THEN
    ex_json := TG_ARGV[1]::jsonb;
    ex_len := pg_catalog.jsonb_array_length(ex_json);
    IF ex_len = 1 THEN
      ex_cols := ARRAY[ex_json->>0];
      has_ex := true;
    ELSIF ex_len > 1 THEN
      ex_cols := ARRAY(SELECT pg_catalog.jsonb_array_elements_text(ex_json));
      has_ex := true;
    END IF;
  END IF;

  IF TG_OP = 'UPDATE' THEN
    IF has_ex THEN
      v_before := pg_catalog.to_jsonb(OLD) - ex_cols;
      v_after := pg_catalog.to_jsonb(NEW) - ex_cols;
    ELSE
      v_before := pg_catalog.to_jsonb(OLD);
      v_after := pg_catalog.to_jsonb(NEW);
    END IF;
    IF v_after = v_before THEN
      RETURN NULL;
    END IF;
    v_changed := ARRAY(
      SELECT e.k
        FROM pg_catalog.jsonb_each(v_after) AS e(k, v)
       WHERE v_before->e.k IS DISTINCT FROM e.v
    );
    IF pk_single IS NOT NULL THEN
      v_record_id := pg_catalog.jsonb_build_object(pk_single, v_after->pk_single);
    ELSIF pg_catalog.cardinality(pk_cols) > 0 THEN
      SELECT pg_catalog.jsonb_object_agg(k, v_after->k)
        INTO v_record_id
        FROM pg_catalog.unnest(pk_cols) AS k;
    END IF;
    resolved := "auditstream".resolve_actor();
    INSERT INTO "auditstream".changes (
      source, schema_name, table_name, table_oid, op,
      record_id, before, after, changed,
      actor, context, actor_source, db_user, schema_version
    )
    VALUES (
      'db',
      v_schema,
      v_table,
      v_relid,
      'UPDATE',
      v_record_id,
      v_before,
      v_after,
      v_changed,
      resolved.actor,
      resolved.context,
      resolved.actor_source,
      session_user,
      1
    );
    RETURN NULL;
  END IF;

  IF TG_OP = 'INSERT' THEN
    resolved := "auditstream".resolve_actor();
    IF pk_single IS NOT NULL AND NOT has_ex THEN
      INSERT INTO "auditstream".changes (
        source, schema_name, table_name, table_oid, op,
        record_id, before, after, changed,
        actor, context, actor_source, db_user, schema_version
      )
      SELECT
        'db',
        v_schema,
        v_table,
        v_relid,
        'INSERT',
        pg_catalog.jsonb_build_object(pk_single, s.row_after->pk_single),
        NULL,
        s.row_after,
        NULL,
        resolved.actor,
        resolved.context,
        resolved.actor_source,
        session_user,
        1
      FROM (
        SELECT pg_catalog.to_jsonb(r) AS row_after
          FROM new_rows AS r
        OFFSET 0
      ) AS s;
    ELSE
      INSERT INTO "auditstream".changes (
        source, schema_name, table_name, table_oid, op,
        record_id, before, after, changed,
        actor, context, actor_source, db_user, schema_version
      )
      SELECT
        'db',
        v_schema,
        v_table,
        v_relid,
        'INSERT',
        CASE
          WHEN pk_single IS NOT NULL THEN pg_catalog.jsonb_build_object(pk_single, s.row_after->pk_single)
          WHEN pg_catalog.cardinality(pk_cols) > 0 THEN (
            SELECT pg_catalog.jsonb_object_agg(k, s.row_after->k)
              FROM pg_catalog.unnest(pk_cols) AS k
          )
        END,
        NULL,
        s.row_after,
        NULL,
        resolved.actor,
        resolved.context,
        resolved.actor_source,
        session_user,
        1
      FROM (
        SELECT CASE WHEN has_ex THEN pg_catalog.to_jsonb(r) - ex_cols ELSE pg_catalog.to_jsonb(r) END AS row_after
          FROM new_rows AS r
        OFFSET 0
      ) AS s;
    END IF;
    RETURN NULL;
  END IF;

  IF TG_OP = 'DELETE' THEN
    resolved := "auditstream".resolve_actor();
    IF pk_single IS NOT NULL AND NOT has_ex THEN
      INSERT INTO "auditstream".changes (
        source, schema_name, table_name, table_oid, op,
        record_id, before, after, changed,
        actor, context, actor_source, db_user, schema_version
      )
      SELECT
        'db',
        v_schema,
        v_table,
        v_relid,
        'DELETE',
        pg_catalog.jsonb_build_object(pk_single, s.row_before->pk_single),
        s.row_before,
        NULL,
        NULL,
        resolved.actor,
        resolved.context,
        resolved.actor_source,
        session_user,
        1
      FROM (
        SELECT pg_catalog.to_jsonb(r) AS row_before
          FROM old_rows AS r
        OFFSET 0
      ) AS s;
    ELSE
      INSERT INTO "auditstream".changes (
        source, schema_name, table_name, table_oid, op,
        record_id, before, after, changed,
        actor, context, actor_source, db_user, schema_version
      )
      SELECT
        'db',
        v_schema,
        v_table,
        v_relid,
        'DELETE',
        CASE
          WHEN pk_single IS NOT NULL THEN pg_catalog.jsonb_build_object(pk_single, s.row_before->pk_single)
          WHEN pg_catalog.cardinality(pk_cols) > 0 THEN (
            SELECT pg_catalog.jsonb_object_agg(k, s.row_before->k)
              FROM pg_catalog.unnest(pk_cols) AS k
          )
        END,
        s.row_before,
        NULL,
        NULL,
        resolved.actor,
        resolved.context,
        resolved.actor_source,
        session_user,
        1
      FROM (
        SELECT CASE WHEN has_ex THEN pg_catalog.to_jsonb(r) - ex_cols ELSE pg_catalog.to_jsonb(r) END AS row_before
          FROM old_rows AS r
        OFFSET 0
      ) AS s;
    END IF;
    RETURN NULL;
  END IF;

  RETURN NULL;
END
$fn$;

DO $$
DECLARE
  fn_name name;
  grantee_oid oid;
BEGIN
  FOR fn_name, grantee_oid IN
    SELECT DISTINCT p.proname, a.grantee
      FROM pg_catalog.pg_proc p
      JOIN pg_catalog.pg_namespace n ON n.oid = p.pronamespace
      CROSS JOIN LATERAL pg_catalog.aclexplode(
        COALESCE(p.proacl, pg_catalog.acldefault('f', p.proowner))
      ) AS a
     WHERE n.nspname = 'auditstream'
       AND p.proname IN ('resolve_actor', 'capture')
       AND p.prokind = 'f'
       AND p.pronargs = 0
       AND a.grantee <> p.proowner
     ORDER BY p.proname, a.grantee
  LOOP
    IF grantee_oid = 0 THEN
      EXECUTE pg_catalog.format('REVOKE ALL ON FUNCTION %I.%I() FROM PUBLIC CASCADE', 'auditstream', fn_name);
    ELSE
      EXECUTE pg_catalog.format(
        'REVOKE ALL ON FUNCTION %I.%I() FROM %I CASCADE',
        'auditstream',
        fn_name,
        pg_catalog.pg_get_userbyid(grantee_oid)
      );
    END IF;
  END LOOP;
END
$$;

DO $$
DECLARE
  prev_role text := pg_catalog.current_setting('auditstream._prev_role', true);
BEGIN
  SET LOCAL ROLE NONE;
  IF prev_role IS NOT NULL AND prev_role <> '' AND prev_role <> current_user THEN
    EXECUTE pg_catalog.format('SET LOCAL ROLE %I', prev_role);
  END IF;
  PERFORM pg_catalog.set_config('auditstream._prev_role', '', true);
END
$$;

DO $$
DECLARE
  caller name := current_user;
  granted_usage boolean := false;
  granted_exec boolean := false;
BEGIN
  IF NOT pg_catalog.pg_has_role(caller, 'auditstream_owner', 'USAGE') THEN
    EXECUTE pg_catalog.format('SET LOCAL ROLE %I', 'auditstream_owner');
    IF NOT EXISTS (
      SELECT 1 FROM pg_catalog.pg_namespace n
      CROSS JOIN LATERAL pg_catalog.aclexplode(
        COALESCE(n.nspacl, pg_catalog.acldefault('n', n.nspowner))
      ) AS a
       WHERE n.nspname = 'auditstream'
         AND a.grantee <> 0
         AND pg_catalog.pg_get_userbyid(a.grantee)::text = caller::text
         AND a.privilege_type = 'USAGE'
    ) THEN
      EXECUTE pg_catalog.format('GRANT USAGE ON SCHEMA %I TO %I', 'auditstream', caller);
      granted_usage := true;
    END IF;
    EXECUTE pg_catalog.format('GRANT EXECUTE ON FUNCTION %I.capture() TO %I', 'auditstream', caller);
    granted_exec := true;
    SET LOCAL ROLE NONE;
    IF caller <> current_user THEN
      EXECUTE pg_catalog.format('SET LOCAL ROLE %I', caller);
    END IF;
  END IF;
  PERFORM pg_catalog.set_config(
    'auditstream._temp_trigger_privs',
    CASE
      WHEN granted_usage AND granted_exec THEN 'both'
      WHEN granted_exec THEN 'exec'
      ELSE 'none'
    END,
    true
  );
END
$$;

CREATE OR REPLACE TRIGGER auditstream_insert
  AFTER INSERT ON "public"."scratch_log"
  REFERENCING NEW TABLE AS new_rows
  FOR EACH STATEMENT
  EXECUTE FUNCTION "auditstream".capture('[]', '[]');

CREATE OR REPLACE TRIGGER auditstream_update
  AFTER UPDATE ON "public"."scratch_log"
  FOR EACH ROW
  EXECUTE FUNCTION "auditstream".capture('[]', '[]');

CREATE OR REPLACE TRIGGER auditstream_delete
  AFTER DELETE ON "public"."scratch_log"
  REFERENCING OLD TABLE AS old_rows
  FOR EACH STATEMENT
  EXECUTE FUNCTION "auditstream".capture('[]', '[]');

CREATE OR REPLACE TRIGGER auditstream_truncate
  AFTER TRUNCATE ON "public"."scratch_log"
  FOR EACH STATEMENT
  EXECUTE FUNCTION "auditstream".capture('[]', '[]');

DO $$
DECLARE
  caller name := current_user;
  priv_mode text := pg_catalog.current_setting('auditstream._temp_trigger_privs', true);
BEGIN
  IF priv_mode IN ('both', 'exec') THEN
    EXECUTE pg_catalog.format('SET LOCAL ROLE %I', 'auditstream_owner');
    EXECUTE pg_catalog.format('REVOKE EXECUTE ON FUNCTION %I.capture() FROM %I CASCADE', 'auditstream', caller);
    IF priv_mode = 'both' THEN
      EXECUTE pg_catalog.format('REVOKE USAGE ON SCHEMA %I FROM %I CASCADE', 'auditstream', caller);
    END IF;
    SET LOCAL ROLE NONE;
    IF caller <> current_user THEN
      EXECUTE pg_catalog.format('SET LOCAL ROLE %I', caller);
    END IF;
    PERFORM pg_catalog.set_config('auditstream._temp_trigger_privs', '', true);
  END IF;
END
$$;

DO $$
DECLARE
  grant_mode text := pg_catalog.current_setting('auditstream._triggers_granted_self', true);
  grantor_role text := pg_catalog.current_setting('auditstream._triggers_granted_self_grantor', true);
  granted_by text := '';
BEGIN
  IF grantor_role IS NOT NULL AND grantor_role <> '' THEN
    granted_by := pg_catalog.format(' GRANTED BY %I', grantor_role);
  END IF;
  IF grant_mode = 'self_row' THEN
    EXECUTE pg_catalog.format('REVOKE "auditstream_owner" FROM %I', current_user) || granted_by;
  ELSIF grant_mode = 'set' THEN
    EXECUTE pg_catalog.format('REVOKE SET OPTION FOR "auditstream_owner" FROM %I', current_user) || granted_by;
  END IF;
  IF grant_mode IS NOT NULL AND grant_mode <> '' THEN
    PERFORM pg_catalog.set_config('auditstream._triggers_granted_self', '', true);
  END IF;
  IF grantor_role IS NOT NULL AND grantor_role <> '' THEN
    PERFORM pg_catalog.set_config('auditstream._triggers_granted_self_grantor', '', true);
  END IF;
END
$$
