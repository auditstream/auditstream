---
source: crates/auditstream-pg/tests/it/triggers.rs
expression: "no_pk.join(\";\\n\\n\")"
---
DO $$
DECLARE
  granted_self boolean := false;
BEGIN
  IF NOT pg_catalog.pg_has_role(current_user, 'auditstream_owner', 'USAGE') THEN
    EXECUTE pg_catalog.format('GRANT "auditstream_owner" TO %I', current_user);
    granted_self := true;
  END IF;
  PERFORM pg_catalog.set_config(
    'auditstream._triggers_granted_self',
    CASE WHEN granted_self THEN '1' ELSE '0' END,
    false
  );
END
$$;

CREATE OR REPLACE FUNCTION "auditstream".resolve_actor(
  OUT actor jsonb,
  OUT context jsonb,
  OUT actor_source text
)
LANGUAGE plpgsql
STABLE
SECURITY DEFINER
SET search_path = pg_catalog, pg_temp
AS $fn$
DECLARE
  raw_setting text;
  body text[];
  matched text[];
  raw_b64 text;
  decoded_bytes bytea;
  payload jsonb;
  claims jsonb;
  sub_val text;
BEGIN
  raw_setting := NULLIF(pg_catalog.current_setting('auditstream.actor', true), '');
  IF raw_setting IS NOT NULL THEN
    IF pg_catalog.octet_length(raw_setting) > 512 THEN
      actor := NULL; context := NULL; actor_source := 'invalid'; RETURN;
    END IF;
    BEGIN
      payload := raw_setting::jsonb;
    EXCEPTION WHEN others THEN
      actor := NULL; context := NULL; actor_source := 'invalid'; RETURN;
    END;
    IF pg_catalog.jsonb_typeof(payload) IS DISTINCT FROM 'object'
       OR pg_catalog.jsonb_typeof(payload->'type') IS DISTINCT FROM 'string'
       OR pg_catalog.jsonb_typeof(payload->'id') IS DISTINCT FROM 'string'
       OR pg_catalog.length(payload->>'type') = 0
       OR pg_catalog.length(payload->>'id') = 0 THEN
      actor := NULL; context := NULL; actor_source := 'invalid'; RETURN;
    END IF;
    IF pg_catalog.jsonb_typeof(payload->'context') = 'object' THEN
      context := payload->'context';
    END IF;
    actor := payload - 'context';
    actor_source := 'set_config';
    RETURN;
  END IF;

  body := pg_catalog.regexp_match(
    pg_catalog.right(pg_catalog.current_query(), 4096),
    '/\*([^/]*)\*/[\s;]*$'
  );
  IF body IS NOT NULL THEN
    matched := pg_catalog.regexp_match(body[1], '(?:^|,)auditstream=''([^'']*)''');
    IF matched IS NOT NULL THEN
      raw_b64 := matched[1];
      IF pg_catalog.length(raw_b64) < 1
         OR pg_catalog.length(raw_b64) > 683
         OR pg_catalog.length(raw_b64) % 4 = 1
         OR raw_b64 !~ '^[A-Za-z0-9_-]+$' THEN
        actor := NULL; context := NULL; actor_source := 'invalid'; RETURN;
      END IF;
      BEGIN
        decoded_bytes := pg_catalog.decode(
          pg_catalog.translate(raw_b64, '-_', '+/')
            || pg_catalog.repeat('=', (4 - pg_catalog.length(raw_b64) % 4) % 4),
          'base64'
        );
        IF pg_catalog.octet_length(decoded_bytes) > 512 THEN
          actor := NULL; context := NULL; actor_source := 'invalid'; RETURN;
        END IF;
        payload := pg_catalog.convert_from(decoded_bytes, 'UTF8')::jsonb;
      EXCEPTION WHEN others THEN
        actor := NULL; context := NULL; actor_source := 'invalid'; RETURN;
      END;
      IF pg_catalog.jsonb_typeof(payload) IS DISTINCT FROM 'object'
         OR pg_catalog.jsonb_typeof(payload->'type') IS DISTINCT FROM 'string'
         OR pg_catalog.jsonb_typeof(payload->'id') IS DISTINCT FROM 'string'
         OR pg_catalog.length(payload->>'type') = 0
         OR pg_catalog.length(payload->>'id') = 0 THEN
        actor := NULL; context := NULL; actor_source := 'invalid'; RETURN;
      END IF;
      IF pg_catalog.jsonb_typeof(payload->'context') = 'object' THEN
        context := payload->'context';
      END IF;
      actor := payload - 'context';
      actor_source := 'comment';
      RETURN;
    END IF;
  END IF;

  raw_setting := NULLIF(pg_catalog.current_setting('request.jwt.claims', true), '');
  IF raw_setting IS NOT NULL THEN
    BEGIN
      claims := raw_setting::jsonb;
    EXCEPTION WHEN others THEN
      actor := NULL; context := NULL; actor_source := 'invalid'; RETURN;
    END;
    IF pg_catalog.jsonb_typeof(claims) = 'object'
       AND pg_catalog.jsonb_typeof(claims->'sub') = 'string' THEN
      sub_val := claims->>'sub';
      IF pg_catalog.length(sub_val) > 0 THEN
        actor := pg_catalog.jsonb_build_object('type', 'user', 'id', sub_val);
        context := NULL;
        actor_source := 'jwt';
        RETURN;
      END IF;
    END IF;
  END IF;

  actor := NULL;
  context := NULL;
  actor_source := NULL;
END
$fn$;

ALTER FUNCTION "auditstream".resolve_actor() OWNER TO "auditstream_owner";

REVOKE ALL ON FUNCTION "auditstream".resolve_actor() FROM PUBLIC;

CREATE OR REPLACE FUNCTION "auditstream".capture()
RETURNS trigger
LANGUAGE plpgsql
SECURITY DEFINER
SET search_path = pg_catalog, pg_temp
AS $fn$
DECLARE
  resolved record;
  pk_cols text[] := '{}';
  ex_cols text[] := '{}';
  v_schema text;
  v_table text;
  v_relid oid;
  v_before jsonb;
  v_after jsonb;
  v_record_id jsonb;
  v_changed text[];
BEGIN
  IF TG_NARGS >= 1 THEN
    pk_cols := COALESCE(
      ARRAY(SELECT pg_catalog.jsonb_array_elements_text(TG_ARGV[0]::jsonb)),
      '{}'::text[]
    );
  END IF;
  IF TG_NARGS >= 2 THEN
    ex_cols := COALESCE(
      ARRAY(SELECT pg_catalog.jsonb_array_elements_text(TG_ARGV[1]::jsonb)),
      '{}'::text[]
    );
  END IF;
  IF TG_NARGS >= 4 THEN
    v_schema := TG_ARGV[2];
    v_table := TG_ARGV[3];
    v_relid := pg_catalog.to_regclass(pg_catalog.format('%I.%I', v_schema, v_table));
  ELSE
    v_schema := TG_TABLE_SCHEMA;
    v_table := TG_TABLE_NAME;
    v_relid := TG_RELID;
  END IF;

  SELECT r.actor, r.context, r.actor_source
    INTO resolved
    FROM "auditstream".resolve_actor() AS r;

  IF TG_OP = 'TRUNCATE' THEN
    INSERT INTO "auditstream".changes (
      source, schema_name, table_name, table_oid, op,
      actor, context, actor_source, db_user, schema_version
    )
    VALUES (
      'db', v_schema, v_table, v_relid, 'TRUNCATE',
      resolved.actor, resolved.context, resolved.actor_source,
      session_user, 1
    );
    RETURN NULL;
  END IF;

  IF TG_OP = 'INSERT' THEN
    INSERT INTO "auditstream".changes (
      source, schema_name, table_name, table_oid, op,
      record_id, before, after, changed,
      actor, context, actor_source, db_user, schema_version
    )
    SELECT
      'db',
      v_schema,
      v_table,
      v_relid,
      'INSERT',
      CASE WHEN pg_catalog.cardinality(pk_cols) > 0 THEN (
        SELECT pg_catalog.jsonb_object_agg(k, s.row_after->k)
          FROM pg_catalog.unnest(pk_cols) AS k
      ) END,
      NULL,
      s.row_after,
      NULL,
      resolved.actor,
      resolved.context,
      resolved.actor_source,
      session_user,
      1
    FROM (
      SELECT pg_catalog.to_jsonb(r) - ex_cols AS row_after
        FROM new_rows AS r
    ) AS s;
    RETURN NULL;
  END IF;

  IF TG_OP = 'DELETE' THEN
    INSERT INTO "auditstream".changes (
      source, schema_name, table_name, table_oid, op,
      record_id, before, after, changed,
      actor, context, actor_source, db_user, schema_version
    )
    SELECT
      'db',
      v_schema,
      v_table,
      v_relid,
      'DELETE',
      CASE WHEN pg_catalog.cardinality(pk_cols) > 0 THEN (
        SELECT pg_catalog.jsonb_object_agg(k, s.row_before->k)
          FROM pg_catalog.unnest(pk_cols) AS k
      ) END,
      s.row_before,
      NULL,
      NULL,
      resolved.actor,
      resolved.context,
      resolved.actor_source,
      session_user,
      1
    FROM (
      SELECT pg_catalog.to_jsonb(r) - ex_cols AS row_before
        FROM old_rows AS r
    ) AS s;
    RETURN NULL;
  END IF;

  IF TG_OP = 'UPDATE' THEN
    v_before := pg_catalog.to_jsonb(OLD) - ex_cols;
    v_after := pg_catalog.to_jsonb(NEW) - ex_cols;
    IF v_after = v_before THEN
      RETURN NULL;
    END IF;
    IF pg_catalog.cardinality(pk_cols) > 0 THEN
      SELECT pg_catalog.jsonb_object_agg(k, v_after->k)
        INTO v_record_id
        FROM pg_catalog.unnest(pk_cols) AS k;
    END IF;
    v_changed := ARRAY(
      SELECT e.k
        FROM pg_catalog.jsonb_each(v_after) AS e(k, v)
       WHERE v_before->e.k IS DISTINCT FROM e.v
    );
    INSERT INTO "auditstream".changes (
      source, schema_name, table_name, table_oid, op,
      record_id, before, after, changed,
      actor, context, actor_source, db_user, schema_version
    )
    VALUES (
      'db',
      v_schema,
      v_table,
      v_relid,
      'UPDATE',
      v_record_id,
      v_before,
      v_after,
      v_changed,
      resolved.actor,
      resolved.context,
      resolved.actor_source,
      session_user,
      1
    );
    RETURN NULL;
  END IF;

  RETURN NULL;
END
$fn$;

ALTER FUNCTION "auditstream".capture() OWNER TO "auditstream_owner";

REVOKE ALL ON FUNCTION "auditstream".capture() FROM PUBLIC;

CREATE OR REPLACE TRIGGER auditstream_insert
  AFTER INSERT ON "public"."scratch_log"
  REFERENCING NEW TABLE AS new_rows
  FOR EACH STATEMENT
  EXECUTE FUNCTION "auditstream".capture('[]', '[]');

CREATE OR REPLACE TRIGGER auditstream_update
  AFTER UPDATE ON "public"."scratch_log"
  FOR EACH ROW
  WHEN (OLD.* IS DISTINCT FROM NEW.*)
  EXECUTE FUNCTION "auditstream".capture('[]', '[]');

CREATE OR REPLACE TRIGGER auditstream_delete
  AFTER DELETE ON "public"."scratch_log"
  REFERENCING OLD TABLE AS old_rows
  FOR EACH STATEMENT
  EXECUTE FUNCTION "auditstream".capture('[]', '[]');

CREATE OR REPLACE TRIGGER auditstream_truncate
  AFTER TRUNCATE ON "public"."scratch_log"
  FOR EACH STATEMENT
  EXECUTE FUNCTION "auditstream".capture('[]', '[]');

DO $$
BEGIN
  IF pg_catalog.current_setting('auditstream._triggers_granted_self', true) = '1' THEN
    EXECUTE pg_catalog.format('REVOKE "auditstream_owner" FROM %I', current_user);
    PERFORM pg_catalog.set_config('auditstream._triggers_granted_self', '', false);
  END IF;
END
$$
