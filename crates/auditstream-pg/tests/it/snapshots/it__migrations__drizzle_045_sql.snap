DO $$
DECLARE
  grantee_oid oid;
  target_role text;
  allowed_roles text[] := ARRAY['app_user']::text[];
BEGIN
  FOR grantee_oid IN
    SELECT DISTINCT a.grantee
      FROM pg_catalog.pg_namespace n
      CROSS JOIN LATERAL pg_catalog.aclexplode(
        COALESCE(n.nspacl, pg_catalog.acldefault('n', n.nspowner))
      ) AS a
     WHERE n.nspname = 'auditstream'
       AND a.grantee <> n.nspowner
       AND (a.grantee = 0 OR a.privilege_type <> 'USAGE' OR a.is_grantable OR pg_catalog.pg_get_userbyid(a.grantee)::text <> ALL (allowed_roles))
     ORDER BY a.grantee
  LOOP
    IF grantee_oid = 0 THEN
      EXECUTE pg_catalog.format('REVOKE ALL ON SCHEMA %I FROM PUBLIC CASCADE', 'auditstream');
    ELSE
      IF pg_catalog.pg_get_userbyid(grantee_oid)::text <> ALL (allowed_roles) THEN
        EXECUTE pg_catalog.format('REVOKE ALL ON SCHEMA %I FROM %I CASCADE', 'auditstream', pg_catalog.pg_get_userbyid(grantee_oid));
      ELSE
        EXECUTE pg_catalog.format('REVOKE CREATE ON SCHEMA %I FROM %I CASCADE', 'auditstream', pg_catalog.pg_get_userbyid(grantee_oid));
        EXECUTE pg_catalog.format('REVOKE GRANT OPTION FOR USAGE ON SCHEMA %I FROM %I CASCADE', 'auditstream', pg_catalog.pg_get_userbyid(grantee_oid));
      END IF;
    END IF;
  END LOOP;
  FOR grantee_oid IN
    SELECT extra_changes_grants.grantee FROM (
      SELECT a.grantee
        FROM pg_catalog.pg_class c
        JOIN pg_catalog.pg_namespace n ON n.oid = c.relnamespace
        CROSS JOIN LATERAL pg_catalog.aclexplode(
          COALESCE(c.relacl, pg_catalog.acldefault('r', c.relowner))
        ) AS a
       WHERE n.nspname = 'auditstream'
         AND c.relname = 'changes'
         AND a.grantee <> c.relowner
         AND a.grantee <> 0
         AND pg_catalog.pg_get_userbyid(a.grantee)::text <> ALL (allowed_roles)
      UNION
      SELECT a.grantee
        FROM pg_catalog.pg_class c
        JOIN pg_catalog.pg_namespace n ON n.oid = c.relnamespace
        JOIN pg_catalog.pg_attribute att
          ON att.attrelid = c.oid
         AND att.attnum > 0
         AND NOT att.attisdropped
         AND att.attacl IS NOT NULL
        CROSS JOIN LATERAL pg_catalog.aclexplode(att.attacl) AS a
       WHERE n.nspname = 'auditstream'
         AND c.relname = 'changes'
         AND a.grantee <> c.relowner
         AND a.grantee <> 0
         AND pg_catalog.pg_get_userbyid(a.grantee)::text <> ALL (allowed_roles)
    ) AS extra_changes_grants
     ORDER BY extra_changes_grants.grantee
  LOOP
    EXECUTE pg_catalog.format(
      'REVOKE ALL ON TABLE %I.changes FROM %I CASCADE',
      'auditstream',
      pg_catalog.pg_get_userbyid(grantee_oid)
    );
  END LOOP;

  FOR grantee_oid IN
    SELECT DISTINCT a.grantee
      FROM pg_catalog.pg_proc p
      JOIN pg_catalog.pg_namespace n ON n.oid = p.pronamespace
      CROSS JOIN LATERAL pg_catalog.aclexplode(
        COALESCE(p.proacl, pg_catalog.acldefault('f', p.proowner))
      ) AS a
     WHERE n.nspname = 'auditstream'
       AND p.proname = 'log_event'
       AND p.prokind = 'f'
       AND p.pronargs = 3
       AND p.proargtypes = (ARRAY[
         'pg_catalog.text'::pg_catalog.regtype::pg_catalog.oid,
         'pg_catalog.jsonb'::pg_catalog.regtype::pg_catalog.oid,
         'pg_catalog.jsonb'::pg_catalog.regtype::pg_catalog.oid
       ])::pg_catalog.oidvector
       AND a.grantee <> p.proowner
       AND (a.grantee = 0 OR a.is_grantable OR pg_catalog.pg_get_userbyid(a.grantee)::text <> ALL (allowed_roles))
     ORDER BY a.grantee
  LOOP
    IF grantee_oid = 0 THEN
      EXECUTE pg_catalog.format('REVOKE ALL ON FUNCTION %I.log_event(text, jsonb, jsonb) FROM PUBLIC CASCADE', 'auditstream');
    ELSE
      IF pg_catalog.pg_get_userbyid(grantee_oid)::text <> ALL (allowed_roles) THEN
        EXECUTE pg_catalog.format('REVOKE ALL ON FUNCTION %I.log_event(text, jsonb, jsonb) FROM %I CASCADE', 'auditstream', pg_catalog.pg_get_userbyid(grantee_oid));
      ELSE
        EXECUTE pg_catalog.format('REVOKE GRANT OPTION FOR EXECUTE ON FUNCTION %I.log_event(text, jsonb, jsonb) FROM %I CASCADE', 'auditstream', pg_catalog.pg_get_userbyid(grantee_oid));
      END IF;
    END IF;
  END LOOP;
  FOREACH target_role IN ARRAY allowed_roles LOOP
    IF NOT EXISTS (
      SELECT 1 FROM pg_catalog.pg_namespace n
      CROSS JOIN LATERAL pg_catalog.aclexplode(
        COALESCE(n.nspacl, pg_catalog.acldefault('n', n.nspowner))
      ) AS a
       WHERE n.nspname = 'auditstream'
         AND a.grantee <> 0
         AND pg_catalog.pg_get_userbyid(a.grantee)::text = target_role
         AND a.privilege_type = 'USAGE'
    ) THEN
      EXECUTE pg_catalog.format('GRANT USAGE ON SCHEMA %I TO %I', 'auditstream', target_role);
    END IF;
    IF NOT EXISTS (
      SELECT 1 FROM pg_catalog.pg_class c
      JOIN pg_catalog.pg_namespace n ON n.oid = c.relnamespace
      CROSS JOIN LATERAL pg_catalog.aclexplode(
        COALESCE(c.relacl, pg_catalog.acldefault('r', c.relowner))
      ) AS a
       WHERE n.nspname = 'auditstream'
         AND c.relname = 'changes'
         AND a.grantee <> 0
         AND pg_catalog.pg_get_userbyid(a.grantee)::text = target_role
         AND a.privilege_type = 'SELECT'
    ) THEN
      EXECUTE pg_catalog.format('GRANT SELECT ON TABLE %I.changes TO %I', 'auditstream', target_role);
    END IF;
    IF NOT EXISTS (
      SELECT 1 FROM pg_catalog.pg_proc p
      JOIN pg_catalog.pg_namespace n ON n.oid = p.pronamespace
      CROSS JOIN LATERAL pg_catalog.aclexplode(
        COALESCE(p.proacl, pg_catalog.acldefault('f', p.proowner))
      ) AS a
       WHERE n.nspname = 'auditstream'
         AND p.proname = 'log_event'
         AND p.prokind = 'f'
         AND p.pronargs = 3
         AND p.proargtypes = (ARRAY[
           'pg_catalog.text'::pg_catalog.regtype::pg_catalog.oid,
           'pg_catalog.jsonb'::pg_catalog.regtype::pg_catalog.oid,
           'pg_catalog.jsonb'::pg_catalog.regtype::pg_catalog.oid
         ])::pg_catalog.oidvector
         AND a.grantee <> 0
         AND pg_catalog.pg_get_userbyid(a.grantee)::text = target_role
         AND a.privilege_type = 'EXECUTE'
    ) THEN
      EXECUTE pg_catalog.format(
        'GRANT EXECUTE ON FUNCTION %I.log_event(text, jsonb, jsonb) TO %I',
        'auditstream',
        target_role
      );
    END IF;
  END LOOP;
END
$$;
--> statement-breakpoint
DO $$
DECLARE
  prev_role text := pg_catalog.current_setting('auditstream._prev_role', true);
BEGIN
  SET LOCAL ROLE NONE;
  IF prev_role IS NOT NULL AND prev_role <> '' AND prev_role <> current_user THEN
    EXECUTE pg_catalog.format('SET LOCAL ROLE %I', prev_role);
  END IF;
  PERFORM pg_catalog.set_config('auditstream._prev_role', '', true);
END
$$;
--> statement-breakpoint
DO $$
DECLARE
  caller name := current_user;
  fn_name name;
  need_reconcile boolean := false;
  granted_schema_usage boolean := false;
BEGIN
  SELECT EXISTS (
    SELECT 1 FROM pg_catalog.pg_proc p
    JOIN pg_catalog.pg_namespace n ON n.oid = p.pronamespace
     WHERE n.nspname = 'auditstream'
       AND p.proname IN ('resolve_actor', 'capture')
       AND p.prokind = 'f'
       AND p.pronargs = 0
       AND p.proowner <> 'auditstream_owner'::pg_catalog.regrole
  ) INTO need_reconcile;

  IF NOT need_reconcile THEN
    RETURN;
  END IF;

  IF NOT pg_catalog.pg_has_role(caller, 'auditstream_owner', 'USAGE') THEN
    IF NOT EXISTS (
      SELECT 1 FROM pg_catalog.pg_namespace n
      CROSS JOIN LATERAL pg_catalog.aclexplode(
        COALESCE(n.nspacl, pg_catalog.acldefault('n', n.nspowner))
      ) AS a
       WHERE n.nspname = 'auditstream'
         AND a.grantee <> 0
         AND pg_catalog.pg_get_userbyid(a.grantee)::text = caller::text
         AND a.privilege_type = 'USAGE'
    ) THEN
      EXECUTE pg_catalog.format('SET LOCAL ROLE %I', 'auditstream_owner');
      EXECUTE pg_catalog.format('GRANT USAGE ON SCHEMA %I TO %I', 'auditstream', caller);
      SET LOCAL ROLE NONE;
      IF caller <> current_user THEN
        EXECUTE pg_catalog.format('SET LOCAL ROLE %I', caller);
      END IF;
      granted_schema_usage := true;
    END IF;
  END IF;

  FOREACH fn_name IN ARRAY ARRAY['resolve_actor', 'capture']::name[] LOOP
    IF EXISTS (
      SELECT 1 FROM pg_catalog.pg_proc p
      JOIN pg_catalog.pg_namespace n ON n.oid = p.pronamespace
       WHERE n.nspname = 'auditstream'
         AND p.proname = fn_name
         AND p.prokind = 'f'
         AND p.pronargs = 0
         AND p.proowner <> 'auditstream_owner'::pg_catalog.regrole
    ) THEN
      EXECUTE pg_catalog.format('ALTER FUNCTION %I.%I() OWNER TO %I', 'auditstream', fn_name, 'auditstream_owner');
    END IF;
  END LOOP;

  IF granted_schema_usage THEN
    EXECUTE pg_catalog.format('SET LOCAL ROLE %I', 'auditstream_owner');
    EXECUTE pg_catalog.format('REVOKE USAGE ON SCHEMA %I FROM %I', 'auditstream', caller);
    SET LOCAL ROLE NONE;
    IF caller <> current_user THEN
      EXECUTE pg_catalog.format('SET LOCAL ROLE %I', caller);
    END IF;
  END IF;
END
$$;
--> statement-breakpoint
DO $$
BEGIN
  PERFORM pg_catalog.set_config('auditstream._prev_role', current_user, true);
  EXECUTE pg_catalog.format('SET LOCAL ROLE %I', 'auditstream_owner');
END
$$;
--> statement-breakpoint
CREATE OR REPLACE FUNCTION "auditstream".resolve_actor(
  OUT actor jsonb,
  OUT context jsonb,
  OUT actor_source text
)
LANGUAGE plpgsql
STABLE
SECURITY DEFINER
SET search_path = pg_catalog, pg_temp
AS $fn$
DECLARE
  v_raw_setting text;
  v_q_tail text;
  v_last_ch text;
  v_q_len integer;
  v_prefix text;
  v_p1 integer;
  v_open_pos integer;
  v_comment_body text;
  v_body_len integer;
  v_allow_escapes boolean;
  v_pos integer;
  v_eq_pos integer;
  v_pair_key text;
  v_key_check text;
  v_val_start integer;
  v_val_end integer;
  v_scan_pos integer;
  v_quote_rel integer;
  v_q_idx integer;
  v_bs_prefix text;
  v_found_count integer;
  v_pair_ok boolean;
  v_has_tag boolean := false;
  v_raw_b64 text;
  v_b64_len integer;
  v_decoded_bytes bytea;
  v_payload jsonb;
  v_source text;
  v_type text;
  v_val jsonb;
  v_obo jsonb;
  v_ctx jsonb;
  v_claims jsonb;
BEGIN
  v_raw_setting := NULLIF(pg_catalog.current_setting('auditstream.actor', true), '');
  IF v_raw_setting IS NOT NULL THEN
    IF pg_catalog.octet_length(v_raw_setting) > 512 THEN
      actor := NULL; context := NULL; actor_source := 'invalid'; RETURN;
    END IF;
    BEGIN
      v_payload := v_raw_setting::jsonb;
    EXCEPTION WHEN others THEN
      actor := NULL; context := NULL; actor_source := 'invalid'; RETURN;
    END;
    v_source := 'set_config';
  ELSE
    v_q_tail := pg_catalog.right(pg_catalog.current_query(), 4096);
    v_last_ch := pg_catalog.right(v_q_tail, 1);
    IF v_last_ch = '/'
       OR (v_last_ch <> '' AND pg_catalog.strpos(E' \t\n\r\f\x0b;', v_last_ch) > 0) THEN
      IF v_last_ch <> '/' THEN
        v_q_tail := pg_catalog.rtrim(v_q_tail, E' \t\n\r\f\x0b;');
      END IF;
      v_q_len := pg_catalog.length(v_q_tail);
      IF v_q_len >= 4
         AND pg_catalog.right(v_q_tail, 2) = '*/'
         AND pg_catalog.strpos(v_q_tail, 'auditstream=''') > 0 THEN
        v_prefix := pg_catalog.left(v_q_tail, v_q_len - 2);
        v_p1 := pg_catalog.strpos(v_prefix, '/');
        IF v_p1 > 0 THEN
          IF pg_catalog.strpos(pg_catalog.substr(v_prefix, v_p1 + 1), '/') = 0 THEN
            v_open_pos := v_p1;
          ELSE
            v_open_pos := v_q_len - 1 - pg_catalog.strpos(pg_catalog.reverse(v_prefix), '/');
          END IF;
          IF pg_catalog.substr(v_prefix, v_open_pos, 2) = '/*'
             AND (CASE
               WHEN v_open_pos > 1 THEN pg_catalog.substr(v_prefix, v_open_pos - 1, 1) <> '*'
               ELSE pg_catalog.length(pg_catalog.current_query()) <= 4096
                    OR pg_catalog.left(pg_catalog.right(pg_catalog.current_query(), 4097), 1) <> '*'
             END) THEN
            v_comment_body := pg_catalog.substr(v_prefix, v_open_pos + 2);
            v_body_len := pg_catalog.length(v_comment_body);
            IF v_body_len >= 14
               AND pg_catalog.left(v_comment_body, 13) = 'auditstream='''
               AND pg_catalog.right(v_comment_body, 1) = '''' THEN
              v_raw_b64 := pg_catalog.substr(v_comment_body, 14, v_body_len - 14);
              IF pg_catalog.strpos(v_raw_b64, '''') = 0 THEN
                v_has_tag := true;
              END IF;
            END IF;
            IF NOT v_has_tag AND pg_catalog.strpos(v_comment_body, 'auditstream=''') > 0 THEN
              FOR pass_idx IN 0..1 LOOP
                v_allow_escapes := (pass_idx = 1);
                IF v_allow_escapes AND pg_catalog.strpos(v_comment_body, E'\\''') = 0 THEN
                  EXIT;
                END IF;
                v_pos := 1;
                v_found_count := 0;
                v_pair_ok := true;
                v_raw_b64 := NULL;
                WHILE v_pos <= v_body_len LOOP
                  v_eq_pos := pg_catalog.strpos(pg_catalog.substr(v_comment_body, v_pos), '=''');
                  IF v_eq_pos <= 1 THEN
                    v_pair_ok := false;
                    EXIT;
                  END IF;
                  v_pair_key := pg_catalog.substr(v_comment_body, v_pos, v_eq_pos - 1);
                  v_key_check := CASE
                    WHEN v_allow_escapes THEN pg_catalog.replace(v_pair_key, E'\\''', '')
                    ELSE v_pair_key
                  END;
                  IF pg_catalog.textregexeq(v_key_check COLLATE pg_catalog."C", '[^A-Za-z0-9_.*~()!%-]') THEN
                    v_pair_ok := false;
                    EXIT;
                  END IF;
                  v_val_start := v_pos + v_eq_pos + 1;
                  v_val_end := 0;
                  IF v_allow_escapes AND v_pair_key <> 'auditstream' THEN
                    v_scan_pos := v_val_start;
                    WHILE v_scan_pos <= v_body_len LOOP
                      v_quote_rel := pg_catalog.strpos(pg_catalog.substr(v_comment_body, v_scan_pos), '''');
                      IF v_quote_rel = 0 THEN
                        EXIT;
                      END IF;
                      v_q_idx := v_scan_pos + v_quote_rel - 1;
                      IF v_quote_rel = 1 OR pg_catalog.substr(v_comment_body, v_q_idx - 1, 1) <> E'\\' THEN
                        v_val_end := v_q_idx;
                        EXIT;
                      END IF;
                      v_bs_prefix := pg_catalog.substr(v_comment_body, v_scan_pos, v_quote_rel - 1);
                      IF (pg_catalog.length(v_bs_prefix) - pg_catalog.length(pg_catalog.rtrim(v_bs_prefix, E'\\'))) % 2 = 0 THEN
                        v_val_end := v_q_idx;
                        EXIT;
                      END IF;
                      v_scan_pos := v_q_idx + 1;
                    END LOOP;
                  ELSE
                    v_quote_rel := pg_catalog.strpos(pg_catalog.substr(v_comment_body, v_val_start), '''');
                    IF v_quote_rel > 0 THEN
                      v_val_end := v_val_start + v_quote_rel - 1;
                    END IF;
                  END IF;
                  IF v_val_end = 0 THEN
                    v_pair_ok := false;
                    EXIT;
                  END IF;
                  IF v_pair_key = 'auditstream' THEN
                    v_found_count := v_found_count + 1;
                    IF v_found_count = 1 THEN
                      v_raw_b64 := pg_catalog.substr(v_comment_body, v_val_start, v_val_end - v_val_start);
                    END IF;
                  END IF;
                  v_pos := v_val_end + 1;
                  IF v_pos <= v_body_len THEN
                    IF pg_catalog.substr(v_comment_body, v_pos, 1) <> ',' OR v_pos = v_body_len THEN
                      v_pair_ok := false;
                      EXIT;
                    END IF;
                    v_pos := v_pos + 1;
                  END IF;
                END LOOP;
                IF v_pair_ok THEN
                  IF v_found_count > 1 THEN
                    actor := NULL; context := NULL; actor_source := 'invalid'; RETURN;
                  END IF;
                  IF v_found_count = 1 THEN
                    v_has_tag := true;
                    EXIT;
                  END IF;
                END IF;
              END LOOP;
            END IF;
          END IF;
        END IF;
      END IF;
    END IF;
    IF v_has_tag THEN
      v_b64_len := pg_catalog.length(v_raw_b64);
      IF v_b64_len < 1
         OR v_b64_len > 683
         OR v_b64_len % 4 = 1
         OR pg_catalog.textregexeq(v_raw_b64 COLLATE pg_catalog."C", '[^A-Za-z0-9_-]') THEN
        actor := NULL; context := NULL; actor_source := 'invalid'; RETURN;
      END IF;
      BEGIN
        v_decoded_bytes := pg_catalog.decode(
          pg_catalog.translate(v_raw_b64, '-_', '+/')
            || pg_catalog.repeat('=', (4 - v_b64_len % 4) % 4),
          'base64'
        );
        IF pg_catalog.octet_length(v_decoded_bytes) > 512 THEN
          actor := NULL; context := NULL; actor_source := 'invalid'; RETURN;
        END IF;
        v_payload := pg_catalog.convert_from(v_decoded_bytes, 'UTF8')::jsonb;
      EXCEPTION WHEN others THEN
        actor := NULL; context := NULL; actor_source := 'invalid'; RETURN;
      END;
      v_source := 'comment';
    END IF;
  END IF;

  IF v_source IS NOT NULL THEN
    IF pg_catalog.jsonb_typeof(v_payload) IS DISTINCT FROM 'object' THEN
      actor := NULL; context := NULL; actor_source := 'invalid'; RETURN;
    END IF;
    v_type := v_payload->>'type';
    v_val := v_payload->'id';
    IF v_type IS NULL
       OR pg_catalog.jsonb_typeof(v_payload->'type') IS DISTINCT FROM 'string'
       OR v_type NOT IN ('user', 'api_key', 'ai_agent', 'service', 'system')
       OR pg_catalog.jsonb_typeof(v_val) IS DISTINCT FROM 'string'
       OR v_val = '""'::jsonb THEN
      actor := NULL; context := NULL; actor_source := 'invalid'; RETURN;
    END IF;
    v_val := v_payload->'tenant';
    IF v_val IS NOT NULL
       AND (pg_catalog.jsonb_typeof(v_val) IS DISTINCT FROM 'string' OR v_val = '""'::jsonb) THEN
      actor := NULL; context := NULL; actor_source := 'invalid'; RETURN;
    END IF;
    v_obo := v_payload->'onBehalfOf';
    IF v_obo IS NOT NULL THEN
      IF pg_catalog.jsonb_typeof(v_obo) IS DISTINCT FROM 'object' THEN
        actor := NULL; context := NULL; actor_source := 'invalid'; RETURN;
      END IF;
      v_type := v_obo->>'type';
      v_val := v_obo->'id';
      IF v_type IS NULL
         OR pg_catalog.jsonb_typeof(v_obo->'type') IS DISTINCT FROM 'string'
         OR v_type NOT IN ('user', 'api_key', 'ai_agent', 'service', 'system')
         OR pg_catalog.jsonb_typeof(v_val) IS DISTINCT FROM 'string'
         OR v_val = '""'::jsonb
         OR v_obo->'onBehalfOf' IS NOT NULL THEN
        actor := NULL; context := NULL; actor_source := 'invalid'; RETURN;
      END IF;
      v_val := v_obo->'tenant';
      IF v_val IS NOT NULL
         AND (pg_catalog.jsonb_typeof(v_val) IS DISTINCT FROM 'string' OR v_val = '""'::jsonb) THEN
        actor := NULL; context := NULL; actor_source := 'invalid'; RETURN;
      END IF;
    END IF;
    v_ctx := v_payload->'context';
    IF v_ctx IS NOT NULL THEN
      IF pg_catalog.jsonb_typeof(v_ctx) IS DISTINCT FROM 'object' THEN
        actor := NULL; context := NULL; actor_source := 'invalid'; RETURN;
      END IF;
      v_val := v_ctx->'requestId';
      IF v_val IS NOT NULL
         AND (pg_catalog.jsonb_typeof(v_val) IS DISTINCT FROM 'string' OR v_val = '""'::jsonb) THEN
        actor := NULL; context := NULL; actor_source := 'invalid'; RETURN;
      END IF;
      v_val := v_ctx->'source';
      IF v_val IS NOT NULL
         AND (pg_catalog.jsonb_typeof(v_val) IS DISTINCT FROM 'string' OR v_val = '""'::jsonb) THEN
        actor := NULL; context := NULL; actor_source := 'invalid'; RETURN;
      END IF;
      v_val := v_ctx->'ip';
      IF v_val IS NOT NULL
         AND (pg_catalog.jsonb_typeof(v_val) IS DISTINCT FROM 'string' OR v_val = '""'::jsonb) THEN
        actor := NULL; context := NULL; actor_source := 'invalid'; RETURN;
      END IF;
      v_val := v_ctx->'userAgent';
      IF v_val IS NOT NULL
         AND (pg_catalog.jsonb_typeof(v_val) IS DISTINCT FROM 'string' OR v_val = '""'::jsonb) THEN
        actor := NULL; context := NULL; actor_source := 'invalid'; RETURN;
      END IF;
      context := v_ctx;
      actor := v_payload - 'context';
    ELSE
      context := NULL;
      actor := v_payload;
    END IF;
    actor_source := v_source;
    RETURN;
  END IF;

  v_raw_setting := NULLIF(pg_catalog.current_setting('request.jwt.claims', true), '');
  IF v_raw_setting IS NOT NULL THEN
    BEGIN
      v_claims := v_raw_setting::jsonb;
    EXCEPTION WHEN others THEN
      actor := NULL; context := NULL; actor_source := 'invalid'; RETURN;
    END;
    IF pg_catalog.jsonb_typeof(v_claims) IS DISTINCT FROM 'object' THEN
      actor := NULL; context := NULL; actor_source := 'invalid'; RETURN;
    END IF;
    v_val := v_claims->'sub';
    IF v_val IS NOT NULL
       AND pg_catalog.jsonb_typeof(v_val) IS DISTINCT FROM 'null' THEN
      IF pg_catalog.jsonb_typeof(v_val) IS DISTINCT FROM 'string'
         OR v_val = '""'::jsonb
         OR 21 + pg_catalog.octet_length(v_val::text) > 512 THEN
        actor := NULL; context := NULL; actor_source := 'invalid'; RETURN;
      END IF;
      actor := pg_catalog.jsonb_build_object('type', 'user', 'id', v_val);
      context := NULL;
      actor_source := 'jwt';
      RETURN;
    END IF;
  END IF;

  actor := NULL;
  context := NULL;
  actor_source := NULL;
END
$fn$;
--> statement-breakpoint
CREATE OR REPLACE FUNCTION "auditstream".capture()
RETURNS trigger
LANGUAGE plpgsql
SECURITY DEFINER
SET search_path = pg_catalog, pg_temp
AS $fn$
DECLARE
  v_actor jsonb;
  v_context jsonb;
  v_actor_source text;
  v_raw_setting text;
  v_q_tail text;
  v_last_ch text;
  v_q_len integer;
  v_prefix text;
  v_p1 integer;
  v_open_pos integer;
  v_comment_body text;
  v_body_len integer;
  v_allow_escapes boolean;
  v_pos integer;
  v_eq_pos integer;
  v_pair_key text;
  v_key_check text;
  v_val_start integer;
  v_val_end integer;
  v_scan_pos integer;
  v_quote_rel integer;
  v_q_idx integer;
  v_bs_prefix text;
  v_found_count integer;
  v_pair_ok boolean;
  v_has_tag boolean := false;
  v_raw_b64 text;
  v_b64_len integer;
  v_decoded_bytes bytea;
  v_payload jsonb;
  v_source text;
  v_type text;
  v_val jsonb;
  v_obo jsonb;
  v_ctx jsonb;
  v_claims jsonb;
  v_arg text;
  pk_json jsonb;
  pk_len integer;
  pk_single text;
  pk_cols text[] := '{}';
  ex_json jsonb;
  ex_len integer;
  ex_cols text[] := '{}';
  has_ex boolean := false;
  v_schema text;
  v_table text;
  v_relid oid;
  v_before jsonb;
  v_after jsonb;
  v_record_id jsonb;
BEGIN
  IF TG_NARGS >= 4 THEN
    v_schema := TG_ARGV[2];
    v_table := TG_ARGV[3];
    SELECT c.oid
      INTO v_relid
      FROM pg_catalog.pg_class c
      JOIN pg_catalog.pg_namespace n ON n.oid = c.relnamespace
     WHERE n.nspname = v_schema
       AND c.relname = v_table;
    IF v_relid IS NULL OR (
      v_relid <> TG_RELID
      AND NOT EXISTS (
        SELECT 1
          FROM pg_catalog.pg_partition_ancestors(TG_RELID) AS a(relid)
         WHERE a.relid = v_relid
      )
    ) THEN
      RAISE EXCEPTION 'auditstream.capture: trigger relation % is not a partition of %.%',
        TG_RELID::pg_catalog.regclass, v_schema, v_table
        USING ERRCODE = '42501';
    END IF;
  ELSE
    v_schema := TG_TABLE_SCHEMA;
    v_table := TG_TABLE_NAME;
    v_relid := TG_RELID;
  END IF;

  IF TG_OP <> 'TRUNCATE' THEN
    IF TG_NARGS >= 2 THEN
      v_arg := TG_ARGV[1];
      IF v_arg <> '[]' AND v_arg <> '{}' AND v_arg <> '' THEN
        IF pg_catalog.left(v_arg, 1) = '[' THEN
          ex_json := v_arg::jsonb;
          ex_len := pg_catalog.jsonb_array_length(ex_json);
          IF ex_len = 1 THEN
            ex_cols := ARRAY[ex_json->>0];
            has_ex := true;
          ELSIF ex_len > 1 THEN
            ex_cols := ARRAY(SELECT pg_catalog.jsonb_array_elements_text(ex_json));
            has_ex := true;
          END IF;
        ELSIF pg_catalog.left(v_arg, 1) = '{' THEN
          ex_cols := v_arg::text[];
          has_ex := (pg_catalog.cardinality(ex_cols) > 0);
        ELSE
          ex_cols := ARRAY[v_arg];
          has_ex := true;
        END IF;
      END IF;
    END IF;

    IF TG_OP = 'UPDATE' THEN
      IF has_ex THEN
        v_before := pg_catalog.to_jsonb(OLD) - ex_cols;
        v_after := pg_catalog.to_jsonb(NEW) - ex_cols;
      ELSE
        v_before := pg_catalog.to_jsonb(OLD);
        v_after := pg_catalog.to_jsonb(NEW);
      END IF;
      IF v_after = v_before THEN
        RETURN NULL;
      END IF;
    END IF;
  END IF;

  <<resolve_actor>>
  BEGIN
    v_raw_setting := NULLIF(pg_catalog.current_setting('auditstream.actor', true), '');
    IF v_raw_setting IS NOT NULL THEN
      IF pg_catalog.octet_length(v_raw_setting) > 512 THEN
        v_actor := NULL; v_context := NULL; v_actor_source := 'invalid'; EXIT resolve_actor;
      END IF;
      BEGIN
        v_payload := v_raw_setting::jsonb;
      EXCEPTION WHEN others THEN
        v_actor := NULL; v_context := NULL; v_actor_source := 'invalid'; EXIT resolve_actor;
      END;
      v_source := 'set_config';
    ELSE
      v_q_tail := pg_catalog.right(pg_catalog.current_query(), 4096);
      v_last_ch := pg_catalog.right(v_q_tail, 1);
      IF v_last_ch = '/'
         OR (v_last_ch <> '' AND pg_catalog.strpos(E' \t\n\r\f\x0b;', v_last_ch) > 0) THEN
        IF v_last_ch <> '/' THEN
          v_q_tail := pg_catalog.rtrim(v_q_tail, E' \t\n\r\f\x0b;');
        END IF;
        v_q_len := pg_catalog.length(v_q_tail);
        IF v_q_len >= 4
           AND pg_catalog.right(v_q_tail, 2) = '*/'
           AND pg_catalog.strpos(v_q_tail, 'auditstream=''') > 0 THEN
          v_prefix := pg_catalog.left(v_q_tail, v_q_len - 2);
          v_p1 := pg_catalog.strpos(v_prefix, '/');
          IF v_p1 > 0 THEN
            IF pg_catalog.strpos(pg_catalog.substr(v_prefix, v_p1 + 1), '/') = 0 THEN
              v_open_pos := v_p1;
            ELSE
              v_open_pos := v_q_len - 1 - pg_catalog.strpos(pg_catalog.reverse(v_prefix), '/');
            END IF;
            IF pg_catalog.substr(v_prefix, v_open_pos, 2) = '/*'
               AND (CASE
                 WHEN v_open_pos > 1 THEN pg_catalog.substr(v_prefix, v_open_pos - 1, 1) <> '*'
                 ELSE pg_catalog.length(pg_catalog.current_query()) <= 4096
                      OR pg_catalog.left(pg_catalog.right(pg_catalog.current_query(), 4097), 1) <> '*'
               END) THEN
              v_comment_body := pg_catalog.substr(v_prefix, v_open_pos + 2);
              v_body_len := pg_catalog.length(v_comment_body);
              IF v_body_len >= 14
                 AND pg_catalog.left(v_comment_body, 13) = 'auditstream='''
                 AND pg_catalog.right(v_comment_body, 1) = '''' THEN
                v_raw_b64 := pg_catalog.substr(v_comment_body, 14, v_body_len - 14);
                IF pg_catalog.strpos(v_raw_b64, '''') = 0 THEN
                  v_has_tag := true;
                END IF;
              END IF;
              IF NOT v_has_tag AND pg_catalog.strpos(v_comment_body, 'auditstream=''') > 0 THEN
                FOR pass_idx IN 0..1 LOOP
                  v_allow_escapes := (pass_idx = 1);
                  IF v_allow_escapes AND pg_catalog.strpos(v_comment_body, E'\\''') = 0 THEN
                    EXIT;
                  END IF;
                  v_pos := 1;
                  v_found_count := 0;
                  v_pair_ok := true;
                  v_raw_b64 := NULL;
                  WHILE v_pos <= v_body_len LOOP
                    v_eq_pos := pg_catalog.strpos(pg_catalog.substr(v_comment_body, v_pos), '=''');
                    IF v_eq_pos <= 1 THEN
                      v_pair_ok := false;
                      EXIT;
                    END IF;
                    v_pair_key := pg_catalog.substr(v_comment_body, v_pos, v_eq_pos - 1);
                    v_key_check := CASE
                      WHEN v_allow_escapes THEN pg_catalog.replace(v_pair_key, E'\\''', '')
                      ELSE v_pair_key
                    END;
                    IF pg_catalog.textregexeq(v_key_check COLLATE pg_catalog."C", '[^A-Za-z0-9_.*~()!%-]') THEN
                      v_pair_ok := false;
                      EXIT;
                    END IF;
                    v_val_start := v_pos + v_eq_pos + 1;
                    v_val_end := 0;
                    IF v_allow_escapes AND v_pair_key <> 'auditstream' THEN
                      v_scan_pos := v_val_start;
                      WHILE v_scan_pos <= v_body_len LOOP
                        v_quote_rel := pg_catalog.strpos(pg_catalog.substr(v_comment_body, v_scan_pos), '''');
                        IF v_quote_rel = 0 THEN
                          EXIT;
                        END IF;
                        v_q_idx := v_scan_pos + v_quote_rel - 1;
                        IF v_quote_rel = 1 OR pg_catalog.substr(v_comment_body, v_q_idx - 1, 1) <> E'\\' THEN
                          v_val_end := v_q_idx;
                          EXIT;
                        END IF;
                        v_bs_prefix := pg_catalog.substr(v_comment_body, v_scan_pos, v_quote_rel - 1);
                        IF (pg_catalog.length(v_bs_prefix) - pg_catalog.length(pg_catalog.rtrim(v_bs_prefix, E'\\'))) % 2 = 0 THEN
                          v_val_end := v_q_idx;
                          EXIT;
                        END IF;
                        v_scan_pos := v_q_idx + 1;
                      END LOOP;
                    ELSE
                      v_quote_rel := pg_catalog.strpos(pg_catalog.substr(v_comment_body, v_val_start), '''');
                      IF v_quote_rel > 0 THEN
                        v_val_end := v_val_start + v_quote_rel - 1;
                      END IF;
                    END IF;
                    IF v_val_end = 0 THEN
                      v_pair_ok := false;
                      EXIT;
                    END IF;
                    IF v_pair_key = 'auditstream' THEN
                      v_found_count := v_found_count + 1;
                      IF v_found_count = 1 THEN
                        v_raw_b64 := pg_catalog.substr(v_comment_body, v_val_start, v_val_end - v_val_start);
                      END IF;
                    END IF;
                    v_pos := v_val_end + 1;
                    IF v_pos <= v_body_len THEN
                      IF pg_catalog.substr(v_comment_body, v_pos, 1) <> ',' OR v_pos = v_body_len THEN
                        v_pair_ok := false;
                        EXIT;
                      END IF;
                      v_pos := v_pos + 1;
                    END IF;
                  END LOOP;
                  IF v_pair_ok THEN
                    IF v_found_count > 1 THEN
                      v_actor := NULL; v_context := NULL; v_actor_source := 'invalid'; EXIT resolve_actor;
                    END IF;
                    IF v_found_count = 1 THEN
                      v_has_tag := true;
                      EXIT;
                    END IF;
                  END IF;
                END LOOP;
              END IF;
            END IF;
          END IF;
        END IF;
      END IF;
      IF v_has_tag THEN
        v_b64_len := pg_catalog.length(v_raw_b64);
        IF v_b64_len < 1
           OR v_b64_len > 683
           OR v_b64_len % 4 = 1
           OR pg_catalog.textregexeq(v_raw_b64 COLLATE pg_catalog."C", '[^A-Za-z0-9_-]') THEN
          v_actor := NULL; v_context := NULL; v_actor_source := 'invalid'; EXIT resolve_actor;
        END IF;
        BEGIN
          v_decoded_bytes := pg_catalog.decode(
            pg_catalog.translate(v_raw_b64, '-_', '+/')
              || pg_catalog.repeat('=', (4 - v_b64_len % 4) % 4),
            'base64'
          );
          IF pg_catalog.octet_length(v_decoded_bytes) > 512 THEN
            v_actor := NULL; v_context := NULL; v_actor_source := 'invalid'; EXIT resolve_actor;
          END IF;
          v_payload := pg_catalog.convert_from(v_decoded_bytes, 'UTF8')::jsonb;
        EXCEPTION WHEN others THEN
          v_actor := NULL; v_context := NULL; v_actor_source := 'invalid'; EXIT resolve_actor;
        END;
        v_source := 'comment';
      END IF;
    END IF;

    IF v_source IS NOT NULL THEN
      IF pg_catalog.jsonb_typeof(v_payload) IS DISTINCT FROM 'object' THEN
        v_actor := NULL; v_context := NULL; v_actor_source := 'invalid'; EXIT resolve_actor;
      END IF;
      v_type := v_payload->>'type';
      v_val := v_payload->'id';
      IF v_type IS NULL
         OR pg_catalog.jsonb_typeof(v_payload->'type') IS DISTINCT FROM 'string'
         OR v_type NOT IN ('user', 'api_key', 'ai_agent', 'service', 'system')
         OR pg_catalog.jsonb_typeof(v_val) IS DISTINCT FROM 'string'
         OR v_val = '""'::jsonb THEN
        v_actor := NULL; v_context := NULL; v_actor_source := 'invalid'; EXIT resolve_actor;
      END IF;
      v_val := v_payload->'tenant';
      IF v_val IS NOT NULL
         AND (pg_catalog.jsonb_typeof(v_val) IS DISTINCT FROM 'string' OR v_val = '""'::jsonb) THEN
        v_actor := NULL; v_context := NULL; v_actor_source := 'invalid'; EXIT resolve_actor;
      END IF;
      v_obo := v_payload->'onBehalfOf';
      IF v_obo IS NOT NULL THEN
        IF pg_catalog.jsonb_typeof(v_obo) IS DISTINCT FROM 'object' THEN
          v_actor := NULL; v_context := NULL; v_actor_source := 'invalid'; EXIT resolve_actor;
        END IF;
        v_type := v_obo->>'type';
        v_val := v_obo->'id';
        IF v_type IS NULL
           OR pg_catalog.jsonb_typeof(v_obo->'type') IS DISTINCT FROM 'string'
           OR v_type NOT IN ('user', 'api_key', 'ai_agent', 'service', 'system')
           OR pg_catalog.jsonb_typeof(v_val) IS DISTINCT FROM 'string'
           OR v_val = '""'::jsonb
           OR v_obo->'onBehalfOf' IS NOT NULL THEN
          v_actor := NULL; v_context := NULL; v_actor_source := 'invalid'; EXIT resolve_actor;
        END IF;
        v_val := v_obo->'tenant';
        IF v_val IS NOT NULL
           AND (pg_catalog.jsonb_typeof(v_val) IS DISTINCT FROM 'string' OR v_val = '""'::jsonb) THEN
          v_actor := NULL; v_context := NULL; v_actor_source := 'invalid'; EXIT resolve_actor;
        END IF;
      END IF;
      v_ctx := v_payload->'context';
      IF v_ctx IS NOT NULL THEN
        IF pg_catalog.jsonb_typeof(v_ctx) IS DISTINCT FROM 'object' THEN
          v_actor := NULL; v_context := NULL; v_actor_source := 'invalid'; EXIT resolve_actor;
        END IF;
        v_val := v_ctx->'requestId';
        IF v_val IS NOT NULL
           AND (pg_catalog.jsonb_typeof(v_val) IS DISTINCT FROM 'string' OR v_val = '""'::jsonb) THEN
          v_actor := NULL; v_context := NULL; v_actor_source := 'invalid'; EXIT resolve_actor;
        END IF;
        v_val := v_ctx->'source';
        IF v_val IS NOT NULL
           AND (pg_catalog.jsonb_typeof(v_val) IS DISTINCT FROM 'string' OR v_val = '""'::jsonb) THEN
          v_actor := NULL; v_context := NULL; v_actor_source := 'invalid'; EXIT resolve_actor;
        END IF;
        v_val := v_ctx->'ip';
        IF v_val IS NOT NULL
           AND (pg_catalog.jsonb_typeof(v_val) IS DISTINCT FROM 'string' OR v_val = '""'::jsonb) THEN
          v_actor := NULL; v_context := NULL; v_actor_source := 'invalid'; EXIT resolve_actor;
        END IF;
        v_val := v_ctx->'userAgent';
        IF v_val IS NOT NULL
           AND (pg_catalog.jsonb_typeof(v_val) IS DISTINCT FROM 'string' OR v_val = '""'::jsonb) THEN
          v_actor := NULL; v_context := NULL; v_actor_source := 'invalid'; EXIT resolve_actor;
        END IF;
        v_context := v_ctx;
        v_actor := v_payload - 'context';
      ELSE
        v_context := NULL;
        v_actor := v_payload;
      END IF;
      v_actor_source := v_source;
      EXIT resolve_actor;
    END IF;

    v_raw_setting := NULLIF(pg_catalog.current_setting('request.jwt.claims', true), '');
    IF v_raw_setting IS NOT NULL THEN
      BEGIN
        v_claims := v_raw_setting::jsonb;
      EXCEPTION WHEN others THEN
        v_actor := NULL; v_context := NULL; v_actor_source := 'invalid'; EXIT resolve_actor;
      END;
      IF pg_catalog.jsonb_typeof(v_claims) IS DISTINCT FROM 'object' THEN
        v_actor := NULL; v_context := NULL; v_actor_source := 'invalid'; EXIT resolve_actor;
      END IF;
      v_val := v_claims->'sub';
      IF v_val IS NOT NULL
         AND pg_catalog.jsonb_typeof(v_val) IS DISTINCT FROM 'null' THEN
        IF pg_catalog.jsonb_typeof(v_val) IS DISTINCT FROM 'string'
           OR v_val = '""'::jsonb
           OR 21 + pg_catalog.octet_length(v_val::text) > 512 THEN
          v_actor := NULL; v_context := NULL; v_actor_source := 'invalid'; EXIT resolve_actor;
        END IF;
        v_actor := pg_catalog.jsonb_build_object('type', 'user', 'id', v_val);
        v_context := NULL;
        v_actor_source := 'jwt';
        EXIT resolve_actor;
      END IF;
    END IF;

    v_actor := NULL;
    v_context := NULL;
    v_actor_source := NULL;
  END resolve_actor;

  IF TG_OP = 'TRUNCATE' THEN
    INSERT INTO "auditstream".changes (
      source, schema_name, table_name, table_oid, op,
      actor, context, actor_source, db_user, schema_version
    )
    VALUES (
      'db', v_schema, v_table, v_relid, 'TRUNCATE',
      v_actor, v_context, v_actor_source,
      session_user, 1
    );
    RETURN NULL;
  END IF;

  IF TG_NARGS >= 1 THEN
    v_arg := TG_ARGV[0];
    IF v_arg <> '[]' AND v_arg <> '{}' AND v_arg <> '' THEN
      IF pg_catalog.left(v_arg, 1) = '[' THEN
        pk_json := v_arg::jsonb;
        pk_len := pg_catalog.jsonb_array_length(pk_json);
        IF pk_len = 1 THEN
          pk_single := pk_json->>0;
        ELSIF pk_len > 1 THEN
          pk_cols := ARRAY(SELECT pg_catalog.jsonb_array_elements_text(pk_json));
        END IF;
      ELSIF pg_catalog.left(v_arg, 1) = '{' THEN
        pk_cols := v_arg::text[];
        pk_len := pg_catalog.cardinality(pk_cols);
        IF pk_len = 1 THEN
          pk_single := pk_cols[1];
          pk_cols := '{}';
        END IF;
      ELSE
        pk_single := v_arg;
      END IF;
    END IF;
  END IF;

  IF TG_OP = 'UPDATE' THEN
    IF pk_single IS NOT NULL THEN
      v_record_id := pg_catalog.jsonb_build_object(pk_single, v_after->pk_single);
    ELSIF pg_catalog.cardinality(pk_cols) > 0 THEN
      SELECT pg_catalog.jsonb_object_agg(k, v_after->k)
        INTO v_record_id
        FROM pg_catalog.unnest(pk_cols) AS k;
    END IF;
    INSERT INTO "auditstream".changes (
      source, schema_name, table_name, table_oid, op,
      record_id, before, after, changed,
      actor, context, actor_source, db_user, schema_version
    )
    VALUES (
      'db',
      v_schema,
      v_table,
      v_relid,
      'UPDATE',
      v_record_id,
      v_before,
      v_after,
      ARRAY(
        SELECT e.k
          FROM pg_catalog.jsonb_each(v_after) AS e(k, v)
         WHERE v_before->e.k IS DISTINCT FROM e.v
      ),
      v_actor,
      v_context,
      v_actor_source,
      session_user,
      1
    );
    RETURN NULL;
  END IF;

  IF TG_OP = 'INSERT' THEN
    IF pk_single IS NOT NULL AND NOT has_ex THEN
      INSERT INTO "auditstream".changes (
        source, schema_name, table_name, table_oid, op,
        record_id, before, after, changed,
        actor, context, actor_source, db_user, schema_version
      )
      SELECT
        'db',
        v_schema,
        v_table,
        v_relid,
        'INSERT',
        pg_catalog.jsonb_build_object(pk_single, s.row_after->pk_single),
        NULL,
        s.row_after,
        NULL,
        v_actor,
        v_context,
        v_actor_source,
        session_user,
        1
      FROM (
        SELECT pg_catalog.to_jsonb(r) AS row_after
          FROM new_rows AS r
        OFFSET 0
      ) AS s;
    ELSE
      INSERT INTO "auditstream".changes (
        source, schema_name, table_name, table_oid, op,
        record_id, before, after, changed,
        actor, context, actor_source, db_user, schema_version
      )
      SELECT
        'db',
        v_schema,
        v_table,
        v_relid,
        'INSERT',
        CASE
          WHEN pk_single IS NOT NULL THEN pg_catalog.jsonb_build_object(pk_single, s.row_after->pk_single)
          WHEN pg_catalog.cardinality(pk_cols) > 0 THEN (
            SELECT pg_catalog.jsonb_object_agg(k, s.row_after->k)
              FROM pg_catalog.unnest(pk_cols) AS k
          )
        END,
        NULL,
        s.row_after,
        NULL,
        v_actor,
        v_context,
        v_actor_source,
        session_user,
        1
      FROM (
        SELECT CASE WHEN has_ex THEN pg_catalog.to_jsonb(r) - ex_cols ELSE pg_catalog.to_jsonb(r) END AS row_after
          FROM new_rows AS r
        OFFSET 0
      ) AS s;
    END IF;
    RETURN NULL;
  END IF;

  IF TG_OP = 'DELETE' THEN
    IF pk_single IS NOT NULL AND NOT has_ex THEN
      INSERT INTO "auditstream".changes (
        source, schema_name, table_name, table_oid, op,
        record_id, before, after, changed,
        actor, context, actor_source, db_user, schema_version
      )
      SELECT
        'db',
        v_schema,
        v_table,
        v_relid,
        'DELETE',
        pg_catalog.jsonb_build_object(pk_single, s.row_before->pk_single),
        s.row_before,
        NULL,
        NULL,
        v_actor,
        v_context,
        v_actor_source,
        session_user,
        1
      FROM (
        SELECT pg_catalog.to_jsonb(r) AS row_before
          FROM old_rows AS r
        OFFSET 0
      ) AS s;
    ELSE
      INSERT INTO "auditstream".changes (
        source, schema_name, table_name, table_oid, op,
        record_id, before, after, changed,
        actor, context, actor_source, db_user, schema_version
      )
      SELECT
        'db',
        v_schema,
        v_table,
        v_relid,
        'DELETE',
        CASE
          WHEN pk_single IS NOT NULL THEN pg_catalog.jsonb_build_object(pk_single, s.row_before->pk_single)
          WHEN pg_catalog.cardinality(pk_cols) > 0 THEN (
            SELECT pg_catalog.jsonb_object_agg(k, s.row_before->k)
              FROM pg_catalog.unnest(pk_cols) AS k
          )
        END,
        s.row_before,
        NULL,
        NULL,
        v_actor,
        v_context,
        v_actor_source,
        session_user,
        1
      FROM (
        SELECT CASE WHEN has_ex THEN pg_catalog.to_jsonb(r) - ex_cols ELSE pg_catalog.to_jsonb(r) END AS row_before
          FROM old_rows AS r
        OFFSET 0
      ) AS s;
    END IF;
    RETURN NULL;
  END IF;

  RETURN NULL;
END
$fn$;
--> statement-breakpoint
DO $$
DECLARE
  fn_name name;
  grantee_oid oid;
BEGIN
  FOR fn_name, grantee_oid IN
    SELECT DISTINCT p.proname, a.grantee
      FROM pg_catalog.pg_proc p
      JOIN pg_catalog.pg_namespace n ON n.oid = p.pronamespace
      CROSS JOIN LATERAL pg_catalog.aclexplode(
        COALESCE(p.proacl, pg_catalog.acldefault('f', p.proowner))
      ) AS a
     WHERE n.nspname = 'auditstream'
       AND p.proname IN ('resolve_actor', 'capture')
       AND p.prokind = 'f'
       AND p.pronargs = 0
       AND a.grantee <> p.proowner
     ORDER BY p.proname, a.grantee
  LOOP
    IF grantee_oid = 0 THEN
      EXECUTE pg_catalog.format('REVOKE ALL ON FUNCTION %I.%I() FROM PUBLIC CASCADE', 'auditstream', fn_name);
    ELSE
      EXECUTE pg_catalog.format(
        'REVOKE ALL ON FUNCTION %I.%I() FROM %I CASCADE',
        'auditstream',
        fn_name,
        pg_catalog.pg_get_userbyid(grantee_oid)
      );
    END IF;
  END LOOP;
END
$$;
--> statement-breakpoint
DO $$
DECLARE
  prev_role text := pg_catalog.current_setting('auditstream._prev_role', true);
BEGIN
  SET LOCAL ROLE NONE;
  IF prev_role IS NOT NULL AND prev_role <> '' AND prev_role <> current_user THEN
    EXECUTE pg_catalog.format('SET LOCAL ROLE %I', prev_role);
  END IF;
  PERFORM pg_catalog.set_config('auditstream._prev_role', '', true);
END
$$;
--> statement-breakpoint
DO $$
DECLARE
  caller name := current_user;
  granted_usage boolean := false;
  granted_exec boolean := false;
BEGIN
  IF NOT pg_catalog.pg_has_role(caller, 'auditstream_owner', 'USAGE') THEN
    EXECUTE pg_catalog.format('SET LOCAL ROLE %I', 'auditstream_owner');
    IF NOT EXISTS (
      SELECT 1 FROM pg_catalog.pg_namespace n
      CROSS JOIN LATERAL pg_catalog.aclexplode(
        COALESCE(n.nspacl, pg_catalog.acldefault('n', n.nspowner))
      ) AS a
       WHERE n.nspname = 'auditstream'
         AND a.grantee <> 0
         AND pg_catalog.pg_get_userbyid(a.grantee)::text = caller::text
         AND a.privilege_type = 'USAGE'
    ) THEN
      EXECUTE pg_catalog.format('GRANT USAGE ON SCHEMA %I TO %I', 'auditstream', caller);
      granted_usage := true;
    END IF;
    EXECUTE pg_catalog.format('GRANT EXECUTE ON FUNCTION %I.capture() TO %I', 'auditstream', caller);
    granted_exec := true;
    SET LOCAL ROLE NONE;
    IF caller <> current_user THEN
      EXECUTE pg_catalog.format('SET LOCAL ROLE %I', caller);
    END IF;
  END IF;
  PERFORM pg_catalog.set_config(
    'auditstream._temp_trigger_privs',
    CASE
      WHEN granted_usage AND granted_exec THEN 'both'
      WHEN granted_exec THEN 'exec'
      ELSE 'none'
    END,
    true
  );
END
$$;
