CREATE OR REPLACE FUNCTION "auditstream".log_event(
  action text,
  target jsonb DEFAULT NULL,
  data jsonb DEFAULT NULL
)
RETURNS uuid
LANGUAGE plpgsql
SECURITY DEFINER
SET search_path = pg_catalog, pg_temp
AS $fn$
DECLARE
  resolved record;
  v_event_id uuid;
BEGIN
  IF action IS NULL
     OR pg_catalog.char_length(action) < 1
     OR pg_catalog.char_length(action) > 64
     OR pg_catalog.regexp_like(action COLLATE pg_catalog."C", E'[\\x01-\\x1f\\x7f\\u0080-\\u009f]')
     OR pg_catalog.btrim(
          action,
          E' \t\n\r\f\x0b\u0085\u00a0\u1680\u2000\u2001\u2002\u2003\u2004\u2005\u2006\u2007\u2008\u2009\u200a\u2028\u2029\u202f\u205f\u3000'
        ) COLLATE pg_catalog."C" <> action COLLATE pg_catalog."C"
     OR pg_catalog.translate(
          action,
          'abcdefghijklmnopqrstuvwxyz',
          'ABCDEFGHIJKLMNOPQRSTUVWXYZ'
        ) COLLATE pg_catalog."C" IN ('INSERT', 'UPDATE', 'DELETE', 'TRUNCATE') THEN
    RAISE EXCEPTION 'auditstream.log_event: invalid action %', action
      USING ERRCODE = '22023';
  END IF;

  IF target IS NOT NULL
     AND pg_catalog.jsonb_typeof(target) IS DISTINCT FROM 'object' THEN
    RAISE EXCEPTION 'auditstream.log_event: target must be a JSON object or NULL'
      USING ERRCODE = '22023';
  END IF;

  IF data IS NOT NULL
     AND pg_catalog.jsonb_typeof(data) IS DISTINCT FROM 'object' THEN
    RAISE EXCEPTION 'auditstream.log_event: data must be a JSON object or NULL'
      USING ERRCODE = '22023';
  END IF;

  SELECT r.actor, r.context, r.actor_source
    INTO resolved
    FROM "auditstream".resolve_actor() AS r;

  INSERT INTO "auditstream".changes (
    source,
    op,
    record_id,
    after,
    actor,
    context,
    actor_source,
    db_user,
    schema_version
  )
  VALUES (
    'app',
    action,
    target,
    data,
    resolved.actor,
    resolved.context,
    resolved.actor_source,
    session_user,
    1
  )
  RETURNING event_id INTO v_event_id;

  RETURN v_event_id;
END
$fn$;
