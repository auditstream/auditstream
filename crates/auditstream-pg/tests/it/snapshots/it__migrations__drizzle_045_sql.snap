DO $$
DECLARE
  caller name := current_user;
  priv_mode text := pg_catalog.current_setting('auditstream._temp_trigger_privs', true);
BEGIN
  IF priv_mode IN ('both', 'exec') THEN
    EXECUTE pg_catalog.format('SET LOCAL ROLE %I', 'auditstream_owner');
    EXECUTE pg_catalog.format('REVOKE EXECUTE ON FUNCTION %I.capture() FROM %I CASCADE', 'auditstream', caller);
    IF priv_mode = 'both' THEN
      EXECUTE pg_catalog.format('REVOKE USAGE ON SCHEMA %I FROM %I CASCADE', 'auditstream', caller);
    END IF;
    SET LOCAL ROLE NONE;
    IF caller <> current_user THEN
      EXECUTE pg_catalog.format('SET LOCAL ROLE %I', caller);
    END IF;
    PERFORM pg_catalog.set_config('auditstream._temp_trigger_privs', '', true);
  END IF;
END
$$;
--> statement-breakpoint
DO $$
DECLARE
  prev_role name := current_user;
  switched_role boolean := false;
  parent_locked boolean := false;
  current_part text;
  obj_schema name;
  rel_name name;
  is_parent boolean;
BEGIN
  IF NOT EXISTS (
    SELECT 1
      FROM pg_catalog.pg_settings
     WHERE name = 'default_toast_compression'
       AND 'lz4' = ANY(enumvals)
  ) THEN
    RETURN;
  END IF;

  current_part := 'changes_' || pg_catalog.to_char(
    pg_catalog.date_trunc('month', pg_catalog.now() AT TIME ZONE 'UTC'),
    'YYYY_MM'
  );

  FOR obj_schema, rel_name, is_parent IN
    WITH RECURSIVE parent AS (
      SELECT c.oid, n.nspname, c.relname
        FROM pg_catalog.pg_class c
        JOIN pg_catalog.pg_namespace n ON n.oid = c.relnamespace
       WHERE n.nspname = 'auditstream'
         AND c.relname = 'changes'
         AND c.relkind IN ('r', 'p')
    ),
    child_tree(relid, rel_schema, rel_name, sort_group, depth) AS (
      SELECT
        child.oid,
        cn.nspname,
        child.relname,
        CASE WHEN child.relname = 'changes_default' THEN 1 ELSE 2 END,
        1
        FROM parent p
        JOIN pg_catalog.pg_inherits i ON i.inhparent = p.oid
        JOIN pg_catalog.pg_class child ON child.oid = i.inhrelid
        JOIN pg_catalog.pg_namespace cn ON cn.oid = child.relnamespace
       WHERE cn.nspname = 'auditstream'
         AND child.relispartition
         AND child.relkind IN ('r', 'p')
         AND (
           child.relname = 'changes_default'
           OR (
             pg_catalog.regexp_like(
               child.relname::text COLLATE pg_catalog."C",
               '^changes_[0-9]{4}_(0[1-9]|1[0-2])$'
             )
             AND child.relname::text COLLATE pg_catalog."C" >= current_part COLLATE pg_catalog."C"
           )
         )
      UNION ALL
      SELECT sub.oid, sn.nspname, sub.relname, ct.sort_group, ct.depth + 1
        FROM child_tree ct
        JOIN pg_catalog.pg_inherits i ON i.inhparent = ct.relid
        JOIN pg_catalog.pg_class sub ON sub.oid = i.inhrelid
        JOIN pg_catalog.pg_namespace sn ON sn.oid = sub.relnamespace
       WHERE sub.relispartition
         AND sub.relkind IN ('r', 'p')
    ),
    targets AS (
      SELECT p.oid AS relid, p.nspname AS rel_schema, p.relname AS rel_name, 0 AS sort_group, 0 AS depth
        FROM parent p
      UNION ALL
      SELECT ct.relid, ct.rel_schema, ct.rel_name, ct.sort_group, ct.depth
        FROM child_tree ct
    )
    SELECT t.rel_schema, t.rel_name, (t.sort_group = 0)
      FROM targets t
     WHERE EXISTS (
       SELECT 1
         FROM pg_catalog.pg_attribute a
        WHERE a.attrelid = t.relid
          AND a.attname IN ('before', 'after')
          AND a.attnum > 0
          AND NOT a.attisdropped
          AND a.attcompression IS DISTINCT FROM 'l'
     )
     ORDER BY t.sort_group ASC, t.depth ASC, t.rel_schema, t.rel_name
  LOOP
    IF NOT switched_role AND prev_role <> 'auditstream_owner' THEN
      EXECUTE pg_catalog.format('SET LOCAL ROLE %I', 'auditstream_owner');
      switched_role := true;
    END IF;
    IF NOT is_parent AND NOT parent_locked THEN
      EXECUTE pg_catalog.format('LOCK TABLE ONLY %I.changes IN ACCESS EXCLUSIVE MODE', 'auditstream');
      parent_locked := true;
    END IF;
    EXECUTE pg_catalog.format(
      'ALTER TABLE ONLY %I.%I ALTER COLUMN before SET COMPRESSION lz4, ALTER COLUMN after SET COMPRESSION lz4',
      obj_schema,
      rel_name
    );
    IF is_parent THEN
      parent_locked := true;
    END IF;
  END LOOP;

  IF switched_role THEN
    SET LOCAL ROLE NONE;
    IF prev_role <> current_user THEN
      EXECUTE pg_catalog.format('SET LOCAL ROLE %I', prev_role);
    END IF;
  END IF;
END
$$;
--> statement-breakpoint
DO $$
DECLARE
  prev_role name := current_user;
  switched_role boolean := false;
  base_month timestamp := pg_catalog.date_trunc('month', pg_catalog.now() AT TIME ZONE 'UTC');
  m int;
  month_start timestamp;
  month_end timestamp;
  obj_schema name;
  part_name name;
  grantee_oid oid;
  managed_tables name[] := ARRAY[]::name[];
BEGIN
  IF prev_role <> 'auditstream_owner' THEN
    EXECUTE pg_catalog.format('SET LOCAL ROLE %I', 'auditstream_owner');
    switched_role := true;
  END IF;
  FOR m IN 1..3 LOOP
    month_start := base_month + pg_catalog.make_interval(months => m);
    month_end := base_month + pg_catalog.make_interval(months => m + 1);
    part_name := 'changes_' || pg_catalog.to_char(month_start, 'YYYY_MM');
    EXECUTE pg_catalog.format(
      'CREATE TABLE IF NOT EXISTS %I.%I PARTITION OF %I.changes FOR VALUES FROM (%L) TO (%L)',
      'auditstream',
      part_name,
      'auditstream',
      pg_catalog.to_char(month_start, 'YYYY-MM-DD HH24:MI:SS') || '+00',
      pg_catalog.to_char(month_end, 'YYYY-MM-DD HH24:MI:SS') || '+00'
    );
    managed_tables := pg_catalog.array_append(managed_tables, part_name);
  END LOOP;
  FOR part_name, grantee_oid IN
    SELECT future_grants.rel_name, future_grants.grantee FROM (
      SELECT c.relname AS rel_name, a.grantee
        FROM pg_catalog.pg_class c
        JOIN pg_catalog.pg_namespace n ON n.oid = c.relnamespace
        CROSS JOIN LATERAL pg_catalog.aclexplode(
          COALESCE(c.relacl, pg_catalog.acldefault('r', c.relowner))
        ) AS a
       WHERE n.nspname = 'auditstream'
         AND c.relname = ANY (managed_tables)
         AND a.grantee <> c.relowner
      UNION
      SELECT c.relname AS rel_name, a.grantee
        FROM pg_catalog.pg_class c
        JOIN pg_catalog.pg_namespace n ON n.oid = c.relnamespace
        JOIN pg_catalog.pg_attribute att
          ON att.attrelid = c.oid
         AND att.attnum > 0
         AND NOT att.attisdropped
         AND att.attacl IS NOT NULL
        CROSS JOIN LATERAL pg_catalog.aclexplode(att.attacl) AS a
       WHERE n.nspname = 'auditstream'
         AND c.relname = ANY (managed_tables)
         AND a.grantee <> c.relowner
    ) AS future_grants
     ORDER BY future_grants.rel_name, future_grants.grantee
  LOOP
    IF grantee_oid = 0 THEN
      EXECUTE pg_catalog.format('REVOKE ALL ON TABLE %I.%I FROM PUBLIC CASCADE', 'auditstream', part_name);
    ELSE
      EXECUTE pg_catalog.format(
        'REVOKE ALL ON TABLE %I.%I FROM %I CASCADE',
        'auditstream',
        part_name,
        pg_catalog.pg_get_userbyid(grantee_oid)
      );
    END IF;
  END LOOP;
  IF switched_role THEN
    SET LOCAL ROLE NONE;
    IF prev_role <> current_user THEN
      EXECUTE pg_catalog.format('SET LOCAL ROLE %I', prev_role);
    END IF;
  END IF;
END
$$;
--> statement-breakpoint
DO $$
DECLARE
  prev_role name := current_user;
  switched_role boolean := false;
  parent_locked boolean := false;
  current_part text := 'changes_' || pg_catalog.to_char(
    pg_catalog.date_trunc('month', pg_catalog.now() AT TIME ZONE 'UTC'),
    'YYYY_MM'
  );
  idx_schema name;
  idx_name name;
BEGIN
  FOR idx_schema, idx_name IN
    WITH RECURSIVE parent AS (
      SELECT c.oid, c.relnamespace
        FROM pg_catalog.pg_class c
        JOIN pg_catalog.pg_namespace n ON n.oid = c.relnamespace
       WHERE n.nspname = 'auditstream'
         AND c.relname = 'changes'
         AND c.relkind IN ('r', 'p')
    ),
    child_tree(relid, sort_group, depth) AS (
      SELECT
        child.oid,
        CASE WHEN child.relname = 'changes_default' THEN 1 ELSE 2 END,
        1
        FROM parent p
        JOIN pg_catalog.pg_inherits i ON i.inhparent = p.oid
        JOIN pg_catalog.pg_class child ON child.oid = i.inhrelid
        JOIN pg_catalog.pg_namespace cn ON cn.oid = child.relnamespace
       WHERE cn.nspname = 'auditstream'
         AND child.relispartition
         AND child.relkind IN ('r', 'p')
         AND (
           child.relname = 'changes_default'
           OR (
             pg_catalog.regexp_like(
               child.relname::text COLLATE pg_catalog."C",
               '^changes_[0-9]{4}_(0[1-9]|1[0-2])$'
             )
             AND child.relname::text COLLATE pg_catalog."C" >= current_part COLLATE pg_catalog."C"
           )
         )
      UNION ALL
      SELECT sub.oid, ct.sort_group, ct.depth + 1
        FROM child_tree ct
        JOIN pg_catalog.pg_inherits i ON i.inhparent = ct.relid
        JOIN pg_catalog.pg_class sub ON sub.oid = i.inhrelid
       WHERE sub.relispartition
         AND sub.relkind IN ('r', 'p')
    ),
    target_tables AS (
      SELECT p.oid AS relid, 0 AS sort_group, 0 AS depth
        FROM parent p
      UNION ALL
      SELECT ct.relid, ct.sort_group, ct.depth
        FROM child_tree ct
    ),
    idx_tree(idx_oid) AS (
      SELECT ic.oid
        FROM parent p
        JOIN pg_catalog.pg_index ix ON ix.indrelid = p.oid
        JOIN pg_catalog.pg_class ic ON ic.oid = ix.indexrelid
        JOIN pg_catalog.pg_am am ON am.oid = ic.relam
       WHERE ic.relnamespace = p.relnamespace
         AND ic.relname = 'changes_occurred_at_brin_idx'
         AND am.amname = 'brin'
      UNION ALL
      SELECT i.inhrelid
        FROM idx_tree it
        JOIN pg_catalog.pg_inherits i ON i.inhparent = it.idx_oid
    )
    SELECT idx_ns.nspname, idx_c.relname
      FROM idx_tree it
      JOIN pg_catalog.pg_class idx_c ON idx_c.oid = it.idx_oid
      JOIN pg_catalog.pg_namespace idx_ns ON idx_ns.oid = idx_c.relnamespace
      JOIN pg_catalog.pg_am am ON am.oid = idx_c.relam
      JOIN pg_catalog.pg_index ix ON ix.indexrelid = idx_c.oid
      JOIN target_tables tt ON tt.relid = ix.indrelid
     WHERE idx_c.relkind = 'i'
       AND am.amname = 'brin'
       AND NOT EXISTS (
         SELECT 1
           FROM pg_catalog.pg_options_to_table(idx_c.reloptions) AS opt
          WHERE CASE
                  WHEN opt.option_name COLLATE pg_catalog."C" = 'autosummarize' COLLATE pg_catalog."C"
                  THEN opt.option_value::pg_catalog.bool
                  ELSE false
                END
       )
     ORDER BY tt.sort_group ASC, tt.depth ASC, idx_ns.nspname, idx_c.relname
  LOOP
    IF NOT switched_role AND prev_role <> 'auditstream_owner' THEN
      EXECUTE pg_catalog.format('SET LOCAL ROLE %I', 'auditstream_owner');
      switched_role := true;
    END IF;
    IF NOT parent_locked THEN
      EXECUTE pg_catalog.format('LOCK TABLE ONLY %I.changes IN ACCESS EXCLUSIVE MODE', 'auditstream');
      parent_locked := true;
    END IF;
    EXECUTE pg_catalog.format('ALTER INDEX %I.%I SET (autosummarize = on)', idx_schema, idx_name);
  END LOOP;

  IF switched_role THEN
    SET LOCAL ROLE NONE;
    IF prev_role <> current_user THEN
      EXECUTE pg_catalog.format('SET LOCAL ROLE %I', prev_role);
    END IF;
  END IF;
END
$$;
--> statement-breakpoint
DO $$
DECLARE
  grant_mode text := pg_catalog.current_setting('auditstream._granted_self', true);
  grantor_role text := pg_catalog.current_setting('auditstream._granted_self_grantor', true);
  granted_by text := '';
BEGIN
  IF grantor_role IS NOT NULL AND grantor_role <> '' THEN
    granted_by := pg_catalog.format(' GRANTED BY %I', grantor_role);
  END IF;
  IF grant_mode = 'self_row' THEN
    EXECUTE pg_catalog.format('REVOKE "auditstream_owner" FROM %I', current_user) || granted_by;
  ELSIF grant_mode = 'set' THEN
    EXECUTE pg_catalog.format('REVOKE SET OPTION FOR "auditstream_owner" FROM %I', current_user) || granted_by;
  END IF;
  IF grant_mode IS NOT NULL AND grant_mode <> '' THEN
    PERFORM pg_catalog.set_config('auditstream._granted_self', '', true);
  END IF;
  IF grantor_role IS NOT NULL AND grantor_role <> '' THEN
    PERFORM pg_catalog.set_config('auditstream._granted_self_grantor', '', true);
  END IF;
END
$$;
--> statement-breakpoint
DO $$
BEGIN
  IF pg_catalog.current_setting('auditstream._lock_timeout_fallback', true) = 'on' THEN
    SET LOCAL lock_timeout = 0;
    PERFORM pg_catalog.set_config('auditstream._lock_timeout_fallback', 'off', true);
  END IF;
  PERFORM pg_catalog.set_config('auditstream._migration_tx', 'off', true);
END
$$;
