DO $$
DECLARE
  caller name := current_user;
  priv_mode text := pg_catalog.current_setting('auditstream._temp_trigger_privs', true);
BEGIN
  IF priv_mode IN ('both', 'exec') THEN
    EXECUTE pg_catalog.format('SET LOCAL ROLE %I', 'auditstream_owner');
    EXECUTE pg_catalog.format('REVOKE EXECUTE ON FUNCTION %I.capture() FROM %I CASCADE', 'auditstream', caller);
    IF priv_mode = 'both' THEN
      EXECUTE pg_catalog.format('REVOKE USAGE ON SCHEMA %I FROM %I CASCADE', 'auditstream', caller);
    END IF;
    SET LOCAL ROLE NONE;
    IF caller <> current_user THEN
      EXECUTE pg_catalog.format('SET LOCAL ROLE %I', caller);
    END IF;
    PERFORM pg_catalog.set_config('auditstream._temp_trigger_privs', '', true);
  END IF;
END
$$;
--> statement-breakpoint
DO $$
DECLARE
  prev_role name := current_user;
  switched_role boolean := false;
  base_month timestamp := pg_catalog.date_trunc('month', pg_catalog.now() AT TIME ZONE 'UTC');
  m int;
  month_start timestamp;
  month_end timestamp;
  obj_schema name;
  part_name name;
  grantee_oid oid;
  managed_tables name[] := ARRAY[]::name[];
BEGIN
  IF prev_role <> 'auditstream_owner' THEN
    EXECUTE pg_catalog.format('SET LOCAL ROLE %I', 'auditstream_owner');
    switched_role := true;
  END IF;
  FOR m IN 1..3 LOOP
    month_start := base_month + pg_catalog.make_interval(months => m);
    month_end := base_month + pg_catalog.make_interval(months => m + 1);
    part_name := 'changes_' || pg_catalog.to_char(month_start, 'YYYY_MM');
    EXECUTE pg_catalog.format(
      'CREATE TABLE IF NOT EXISTS %I.%I PARTITION OF %I.changes FOR VALUES FROM (%L) TO (%L)',
      'auditstream',
      part_name,
      'auditstream',
      pg_catalog.to_char(month_start, 'YYYY-MM-DD HH24:MI:SS') || '+00',
      pg_catalog.to_char(month_end, 'YYYY-MM-DD HH24:MI:SS') || '+00'
    );
    managed_tables := pg_catalog.array_append(managed_tables, part_name);
  END LOOP;
  FOR part_name, grantee_oid IN
    SELECT future_grants.rel_name, future_grants.grantee FROM (
      SELECT c.relname AS rel_name, a.grantee
        FROM pg_catalog.pg_class c
        JOIN pg_catalog.pg_namespace n ON n.oid = c.relnamespace
        CROSS JOIN LATERAL pg_catalog.aclexplode(
          COALESCE(c.relacl, pg_catalog.acldefault('r', c.relowner))
        ) AS a
       WHERE n.nspname = 'auditstream'
         AND c.relname = ANY (managed_tables)
         AND a.grantee <> c.relowner
      UNION
      SELECT c.relname AS rel_name, a.grantee
        FROM pg_catalog.pg_class c
        JOIN pg_catalog.pg_namespace n ON n.oid = c.relnamespace
        JOIN pg_catalog.pg_attribute att
          ON att.attrelid = c.oid
         AND att.attnum > 0
         AND NOT att.attisdropped
         AND att.attacl IS NOT NULL
        CROSS JOIN LATERAL pg_catalog.aclexplode(att.attacl) AS a
       WHERE n.nspname = 'auditstream'
         AND c.relname = ANY (managed_tables)
         AND a.grantee <> c.relowner
    ) AS future_grants
     ORDER BY future_grants.rel_name, future_grants.grantee
  LOOP
    IF grantee_oid = 0 THEN
      EXECUTE pg_catalog.format('REVOKE ALL ON TABLE %I.%I FROM PUBLIC CASCADE', 'auditstream', part_name);
    ELSE
      EXECUTE pg_catalog.format(
        'REVOKE ALL ON TABLE %I.%I FROM %I CASCADE',
        'auditstream',
        part_name,
        pg_catalog.pg_get_userbyid(grantee_oid)
      );
    END IF;
  END LOOP;
  IF switched_role THEN
    SET LOCAL ROLE NONE;
    IF prev_role <> current_user THEN
      EXECUTE pg_catalog.format('SET LOCAL ROLE %I', prev_role);
    END IF;
  END IF;
END
$$;
--> statement-breakpoint
DO $$
DECLARE
  grant_mode text := pg_catalog.current_setting('auditstream._granted_self', true);
  grantor_role text := pg_catalog.current_setting('auditstream._granted_self_grantor', true);
  granted_by text := '';
BEGIN
  IF grantor_role IS NOT NULL AND grantor_role <> '' THEN
    granted_by := pg_catalog.format(' GRANTED BY %I', grantor_role);
  END IF;
  IF grant_mode = 'self_row' THEN
    EXECUTE pg_catalog.format('REVOKE "auditstream_owner" FROM %I', current_user) || granted_by;
  ELSIF grant_mode = 'both' THEN
    EXECUTE pg_catalog.format('REVOKE INHERIT OPTION FOR "auditstream_owner" FROM %I', current_user) || granted_by;
    EXECUTE pg_catalog.format('REVOKE SET OPTION FOR "auditstream_owner" FROM %I', current_user) || granted_by;
  ELSIF grant_mode = 'inherit' THEN
    EXECUTE pg_catalog.format('REVOKE INHERIT OPTION FOR "auditstream_owner" FROM %I', current_user) || granted_by;
  ELSIF grant_mode = 'set' THEN
    EXECUTE pg_catalog.format('REVOKE SET OPTION FOR "auditstream_owner" FROM %I', current_user) || granted_by;
  END IF;
  IF grant_mode IS NOT NULL AND grant_mode <> '' THEN
    PERFORM pg_catalog.set_config('auditstream._granted_self', '', true);
  END IF;
  IF grantor_role IS NOT NULL AND grantor_role <> '' THEN
    PERFORM pg_catalog.set_config('auditstream._granted_self_grantor', '', true);
  END IF;
END
$$;
--> statement-breakpoint
DO $$
BEGIN
  IF pg_catalog.current_setting('auditstream._lock_timeout_fallback', true) = 'on' THEN
    SET LOCAL lock_timeout = 0;
    PERFORM pg_catalog.set_config('auditstream._lock_timeout_fallback', 'off', true);
  END IF;
  PERFORM pg_catalog.set_config('auditstream._migration_tx', 'off', true);
END
$$;
