---
source: crates/auditstream-pg/tests/it/triggers.rs
expression: "standard.join(\";\\n\\n\")"
---
DO $$
BEGIN
  PERFORM pg_catalog.set_config('auditstream._migration_tx', 'on', true);
END
$$;

DO $$
DECLARE
  grant_mode text := 'none';
  grantor_role text := '';
  grantor_oid oid;
  has_grantor_row boolean := false;
BEGIN
  IF pg_catalog.current_setting('auditstream._migration_tx', true) IS DISTINCT FROM 'on' THEN
    RAISE EXCEPTION 'Auditstream trigger statements must run inside a single transaction'
      USING HINT = 'Wrap the generated statements in BEGIN; ... COMMIT; or use a transactional migrator.';
  END IF;
  IF pg_catalog.current_setting('server_version_num')::int >= 160000 THEN
    IF NOT pg_catalog.pg_has_role(current_user, 'auditstream_owner', 'SET') THEN
      SELECT m.member
        INTO grantor_oid
        FROM pg_catalog.pg_auth_members m
        JOIN pg_catalog.pg_roles r ON r.oid = m.roleid
        JOIN pg_catalog.pg_roles u ON u.rolname = current_user
       WHERE r.rolname = 'auditstream_owner'
         AND m.admin_option
         AND (m.member = u.oid OR pg_catalog.pg_has_role(u.oid, m.member, 'USAGE'))
       ORDER BY (m.member = u.oid) DESC, m.member
       LIMIT 1;
      IF grantor_oid IS NULL THEN
        EXECUTE pg_catalog.format(
          'GRANT "auditstream_owner" TO %I WITH INHERIT FALSE, SET TRUE',
          current_user
        );
        grant_mode := 'self_row';
      ELSE
        grantor_role := pg_catalog.pg_get_userbyid(grantor_oid)::text;
        SELECT EXISTS (
          SELECT 1
            FROM pg_catalog.pg_auth_members m
            JOIN pg_catalog.pg_roles r ON r.oid = m.roleid
            JOIN pg_catalog.pg_roles u ON u.oid = m.member
           WHERE r.rolname = 'auditstream_owner'
             AND u.rolname = current_user
             AND m.grantor = grantor_oid
        ) INTO has_grantor_row;
        IF NOT has_grantor_row THEN
          EXECUTE pg_catalog.format(
            'GRANT "auditstream_owner" TO %I WITH INHERIT FALSE, SET TRUE GRANTED BY %I',
            current_user,
            grantor_role
          );
          grant_mode := 'self_row';
        ELSE
          EXECUTE pg_catalog.format(
            'GRANT "auditstream_owner" TO %I WITH SET TRUE GRANTED BY %I',
            current_user,
            grantor_role
          );
          grant_mode := 'set';
        END IF;
      END IF;
    END IF;
  ELSIF NOT pg_catalog.pg_has_role(current_user, 'auditstream_owner', 'MEMBER') THEN
    EXECUTE pg_catalog.format('GRANT "auditstream_owner" TO %I', current_user);
    grant_mode := 'self_row';
  END IF;
  PERFORM pg_catalog.set_config('auditstream._triggers_granted_self', grant_mode, true);
  PERFORM pg_catalog.set_config('auditstream._triggers_granted_self_grantor', grantor_role, true);
END
$$;

DO $$
DECLARE
  caller name := current_user;
  fn_name name;
  need_reconcile boolean := false;
  granted_schema_usage boolean := false;
BEGIN
  SELECT EXISTS (
    SELECT 1 FROM pg_catalog.pg_proc p
    JOIN pg_catalog.pg_namespace n ON n.oid = p.pronamespace
     WHERE n.nspname = 'auditstream'
       AND p.proname IN ('resolve_actor', 'capture')
       AND p.prokind = 'f'
       AND p.pronargs = 0
       AND p.proowner <> 'auditstream_owner'::pg_catalog.regrole
  ) INTO need_reconcile;

  IF NOT need_reconcile THEN
    RETURN;
  END IF;

  IF NOT pg_catalog.pg_has_role(caller, 'auditstream_owner', 'USAGE') THEN
    IF NOT EXISTS (
      SELECT 1 FROM pg_catalog.pg_namespace n
      CROSS JOIN LATERAL pg_catalog.aclexplode(
        COALESCE(n.nspacl, pg_catalog.acldefault('n', n.nspowner))
      ) AS a
       WHERE n.nspname = 'auditstream'
         AND a.grantee <> 0
         AND pg_catalog.pg_get_userbyid(a.grantee)::text = caller::text
         AND a.privilege_type = 'USAGE'
    ) THEN
      EXECUTE pg_catalog.format('SET LOCAL ROLE %I', 'auditstream_owner');
      EXECUTE pg_catalog.format('GRANT USAGE ON SCHEMA %I TO %I', 'auditstream', caller);
      SET LOCAL ROLE NONE;
      IF caller <> current_user THEN
        EXECUTE pg_catalog.format('SET LOCAL ROLE %I', caller);
      END IF;
      granted_schema_usage := true;
    END IF;
  END IF;

  FOREACH fn_name IN ARRAY ARRAY['resolve_actor', 'capture']::name[] LOOP
    IF EXISTS (
      SELECT 1 FROM pg_catalog.pg_proc p
      JOIN pg_catalog.pg_namespace n ON n.oid = p.pronamespace
       WHERE n.nspname = 'auditstream'
         AND p.proname = fn_name
         AND p.prokind = 'f'
         AND p.pronargs = 0
         AND p.proowner <> 'auditstream_owner'::pg_catalog.regrole
    ) THEN
      EXECUTE pg_catalog.format('ALTER FUNCTION %I.%I() OWNER TO %I', 'auditstream', fn_name, 'auditstream_owner');
    END IF;
  END LOOP;

  IF granted_schema_usage THEN
    EXECUTE pg_catalog.format('SET LOCAL ROLE %I', 'auditstream_owner');
    EXECUTE pg_catalog.format('REVOKE USAGE ON SCHEMA %I FROM %I', 'auditstream', caller);
    SET LOCAL ROLE NONE;
    IF caller <> current_user THEN
      EXECUTE pg_catalog.format('SET LOCAL ROLE %I', caller);
    END IF;
  END IF;
END
$$;

DO $$
BEGIN
  PERFORM pg_catalog.set_config('auditstream._prev_role', current_user, true);
  EXECUTE pg_catalog.format('SET LOCAL ROLE %I', 'auditstream_owner');
END
$$;

CREATE OR REPLACE FUNCTION "auditstream".resolve_actor(
  OUT actor jsonb,
  OUT context jsonb,
  OUT actor_source text
)
LANGUAGE plpgsql
STABLE
SECURITY DEFINER
SET search_path = pg_catalog, pg_temp
AS $fn$
DECLARE
  v_raw_setting text;
  v_q_tail text;
  v_last_ch text;
  v_q_len integer;
  v_prefix text;
  v_p1 integer;
  v_open_pos integer;
  v_comment_body text;
  v_body_len integer;
  v_allow_escapes boolean;
  v_pos integer;
  v_eq_pos integer;
  v_pair_key text;
  v_key_check text;
  v_val_start integer;
  v_val_end integer;
  v_scan_pos integer;
  v_quote_rel integer;
  v_q_idx integer;
  v_bs_prefix text;
  v_found_count integer;
  v_pair_ok boolean;
  v_has_tag boolean := false;
  v_raw_b64 text;
  v_b64_len integer;
  v_decoded_bytes bytea;
  v_payload jsonb;
  v_source text;
  v_type text;
  v_val jsonb;
  v_obo jsonb;
  v_ctx jsonb;
  v_claims jsonb;
BEGIN
  v_raw_setting := NULLIF(pg_catalog.current_setting('auditstream.actor', true), '');
  IF v_raw_setting IS NOT NULL THEN
    IF pg_catalog.octet_length(v_raw_setting) > 512 THEN
      actor := NULL; context := NULL; actor_source := 'invalid'; RETURN;
    END IF;
    BEGIN
      v_payload := v_raw_setting::jsonb;
    EXCEPTION WHEN others THEN
      actor := NULL; context := NULL; actor_source := 'invalid'; RETURN;
    END;
    v_source := 'set_config';
  ELSE
    v_q_tail := pg_catalog.right(pg_catalog.current_query(), 4096);
    v_last_ch := pg_catalog.right(v_q_tail, 1);
    IF v_last_ch = '/'
       OR (v_last_ch <> '' AND pg_catalog.strpos(E' \t\n\r\f\x0b;', v_last_ch) > 0) THEN
      IF v_last_ch <> '/' THEN
        v_q_tail := pg_catalog.rtrim(v_q_tail, E' \t\n\r\f\x0b;');
      END IF;
      v_q_len := pg_catalog.length(v_q_tail);
      IF v_q_len >= 4
         AND pg_catalog.right(v_q_tail, 2) = '*/'
         AND pg_catalog.strpos(v_q_tail, 'auditstream=''') > 0 THEN
        v_prefix := pg_catalog.left(v_q_tail, v_q_len - 2);
        v_p1 := pg_catalog.strpos(v_prefix, '/');
        IF v_p1 > 0 THEN
          IF pg_catalog.strpos(pg_catalog.substr(v_prefix, v_p1 + 1), '/') = 0 THEN
            v_open_pos := v_p1;
          ELSE
            v_open_pos := v_q_len - 1 - pg_catalog.strpos(pg_catalog.reverse(v_prefix), '/');
          END IF;
          IF pg_catalog.substr(v_prefix, v_open_pos, 2) = '/*'
             AND (CASE
               WHEN v_open_pos > 1 THEN pg_catalog.substr(v_prefix, v_open_pos - 1, 1) <> '*'
               ELSE pg_catalog.length(pg_catalog.current_query()) <= 4096
                    OR pg_catalog.left(pg_catalog.right(pg_catalog.current_query(), 4097), 1) <> '*'
             END) THEN
            v_comment_body := pg_catalog.substr(v_prefix, v_open_pos + 2);
            v_body_len := pg_catalog.length(v_comment_body);
            IF v_body_len >= 14
               AND pg_catalog.left(v_comment_body, 13) = 'auditstream='''
               AND pg_catalog.right(v_comment_body, 1) = '''' THEN
              v_raw_b64 := pg_catalog.substr(v_comment_body, 14, v_body_len - 14);
              IF pg_catalog.strpos(v_raw_b64, '''') = 0 THEN
                v_has_tag := true;
              END IF;
            END IF;
            IF NOT v_has_tag AND pg_catalog.strpos(v_comment_body, 'auditstream=''') > 0 THEN
              FOR pass_idx IN 0..1 LOOP
                v_allow_escapes := (pass_idx = 1);
                IF v_allow_escapes AND pg_catalog.strpos(v_comment_body, E'\\''') = 0 THEN
                  EXIT;
                END IF;
                v_pos := 1;
                v_found_count := 0;
                v_pair_ok := true;
                v_raw_b64 := NULL;
                WHILE v_pos <= v_body_len LOOP
                  v_eq_pos := pg_catalog.strpos(pg_catalog.substr(v_comment_body, v_pos), '=''');
                  IF v_eq_pos <= 1 THEN
                    v_pair_ok := false;
                    EXIT;
                  END IF;
                  v_pair_key := pg_catalog.substr(v_comment_body, v_pos, v_eq_pos - 1);
                  v_key_check := CASE
                    WHEN v_allow_escapes THEN pg_catalog.replace(v_pair_key, E'\\''', '')
                    ELSE v_pair_key
                  END;
                  IF pg_catalog.textregexeq(v_key_check COLLATE pg_catalog."C", '[^A-Za-z0-9_.*~()!%-]') THEN
                    v_pair_ok := false;
                    EXIT;
                  END IF;
                  v_val_start := v_pos + v_eq_pos + 1;
                  v_val_end := 0;
                  IF v_allow_escapes AND v_pair_key <> 'auditstream' THEN
                    v_scan_pos := v_val_start;
                    WHILE v_scan_pos <= v_body_len LOOP
                      v_quote_rel := pg_catalog.strpos(pg_catalog.substr(v_comment_body, v_scan_pos), '''');
                      IF v_quote_rel = 0 THEN
                        EXIT;
                      END IF;
                      v_q_idx := v_scan_pos + v_quote_rel - 1;
                      IF v_quote_rel = 1 OR pg_catalog.substr(v_comment_body, v_q_idx - 1, 1) <> E'\\' THEN
                        v_val_end := v_q_idx;
                        EXIT;
                      END IF;
                      v_bs_prefix := pg_catalog.substr(v_comment_body, v_scan_pos, v_quote_rel - 1);
                      IF (pg_catalog.length(v_bs_prefix) - pg_catalog.length(pg_catalog.rtrim(v_bs_prefix, E'\\'))) % 2 = 0 THEN
                        v_val_end := v_q_idx;
                        EXIT;
                      END IF;
                      v_scan_pos := v_q_idx + 1;
                    END LOOP;
                  ELSE
                    v_quote_rel := pg_catalog.strpos(pg_catalog.substr(v_comment_body, v_val_start), '''');
                    IF v_quote_rel > 0 THEN
                      v_val_end := v_val_start + v_quote_rel - 1;
                    END IF;
                  END IF;
                  IF v_val_end = 0 THEN
                    v_pair_ok := false;
                    EXIT;
                  END IF;
                  IF v_pair_key = 'auditstream' THEN
                    v_found_count := v_found_count + 1;
                    IF v_found_count = 1 THEN
                      v_raw_b64 := pg_catalog.substr(v_comment_body, v_val_start, v_val_end - v_val_start);
                    END IF;
                  END IF;
                  v_pos := v_val_end + 1;
                  IF v_pos <= v_body_len THEN
                    IF pg_catalog.substr(v_comment_body, v_pos, 1) <> ',' OR v_pos = v_body_len THEN
                      v_pair_ok := false;
                      EXIT;
                    END IF;
                    v_pos := v_pos + 1;
                  END IF;
                END LOOP;
                IF v_pair_ok THEN
                  IF v_found_count > 1 THEN
                    actor := NULL; context := NULL; actor_source := 'invalid'; RETURN;
                  END IF;
                  IF v_found_count = 1 THEN
                    v_has_tag := true;
                    EXIT;
                  END IF;
                END IF;
              END LOOP;
            END IF;
          END IF;
        END IF;
      END IF;
    END IF;
    IF v_has_tag THEN
      v_b64_len := pg_catalog.length(v_raw_b64);
      IF v_b64_len < 1
         OR v_b64_len > 683
         OR v_b64_len % 4 = 1
         OR pg_catalog.textregexeq(v_raw_b64 COLLATE pg_catalog."C", '[^A-Za-z0-9_-]') THEN
        actor := NULL; context := NULL; actor_source := 'invalid'; RETURN;
      END IF;
      BEGIN
        v_decoded_bytes := pg_catalog.decode(
          pg_catalog.translate(v_raw_b64, '-_', '+/')
            || pg_catalog.repeat('=', (4 - v_b64_len % 4) % 4),
          'base64'
        );
        IF pg_catalog.octet_length(v_decoded_bytes) > 512 THEN
          actor := NULL; context := NULL; actor_source := 'invalid'; RETURN;
        END IF;
        v_payload := pg_catalog.convert_from(v_decoded_bytes, 'UTF8')::jsonb;
      EXCEPTION WHEN others THEN
        actor := NULL; context := NULL; actor_source := 'invalid'; RETURN;
      END;
      v_source := 'comment';
    END IF;
  END IF;

  IF v_source IS NOT NULL THEN
    IF pg_catalog.jsonb_typeof(v_payload) IS DISTINCT FROM 'object' THEN
      actor := NULL; context := NULL; actor_source := 'invalid'; RETURN;
    END IF;
    v_type := v_payload->>'type';
    v_val := v_payload->'id';
    IF v_type IS NULL
       OR pg_catalog.jsonb_typeof(v_payload->'type') IS DISTINCT FROM 'string'
       OR v_type NOT IN ('user', 'api_key', 'ai_agent', 'service', 'system')
       OR pg_catalog.jsonb_typeof(v_val) IS DISTINCT FROM 'string'
       OR v_val = '""'::jsonb THEN
      actor := NULL; context := NULL; actor_source := 'invalid'; RETURN;
    END IF;
    v_val := v_payload->'tenant';
    IF v_val IS NOT NULL
       AND (pg_catalog.jsonb_typeof(v_val) IS DISTINCT FROM 'string' OR v_val = '""'::jsonb) THEN
      actor := NULL; context := NULL; actor_source := 'invalid'; RETURN;
    END IF;
    v_obo := v_payload->'onBehalfOf';
    IF v_obo IS NOT NULL THEN
      IF pg_catalog.jsonb_typeof(v_obo) IS DISTINCT FROM 'object' THEN
        actor := NULL; context := NULL; actor_source := 'invalid'; RETURN;
      END IF;
      v_type := v_obo->>'type';
      v_val := v_obo->'id';
      IF v_type IS NULL
         OR pg_catalog.jsonb_typeof(v_obo->'type') IS DISTINCT FROM 'string'
         OR v_type NOT IN ('user', 'api_key', 'ai_agent', 'service', 'system')
         OR pg_catalog.jsonb_typeof(v_val) IS DISTINCT FROM 'string'
         OR v_val = '""'::jsonb
         OR v_obo->'onBehalfOf' IS NOT NULL THEN
        actor := NULL; context := NULL; actor_source := 'invalid'; RETURN;
      END IF;
      v_val := v_obo->'tenant';
      IF v_val IS NOT NULL
         AND (pg_catalog.jsonb_typeof(v_val) IS DISTINCT FROM 'string' OR v_val = '""'::jsonb) THEN
        actor := NULL; context := NULL; actor_source := 'invalid'; RETURN;
      END IF;
    END IF;
    v_ctx := v_payload->'context';
    IF v_ctx IS NOT NULL THEN
      IF pg_catalog.jsonb_typeof(v_ctx) IS DISTINCT FROM 'object' THEN
        actor := NULL; context := NULL; actor_source := 'invalid'; RETURN;
      END IF;
      v_val := v_ctx->'requestId';
      IF v_val IS NOT NULL
         AND (pg_catalog.jsonb_typeof(v_val) IS DISTINCT FROM 'string' OR v_val = '""'::jsonb) THEN
        actor := NULL; context := NULL; actor_source := 'invalid'; RETURN;
      END IF;
      v_val := v_ctx->'source';
      IF v_val IS NOT NULL
         AND (pg_catalog.jsonb_typeof(v_val) IS DISTINCT FROM 'string' OR v_val = '""'::jsonb) THEN
        actor := NULL; context := NULL; actor_source := 'invalid'; RETURN;
      END IF;
      v_val := v_ctx->'ip';
      IF v_val IS NOT NULL
         AND (pg_catalog.jsonb_typeof(v_val) IS DISTINCT FROM 'string' OR v_val = '""'::jsonb) THEN
        actor := NULL; context := NULL; actor_source := 'invalid'; RETURN;
      END IF;
      v_val := v_ctx->'userAgent';
      IF v_val IS NOT NULL
         AND (pg_catalog.jsonb_typeof(v_val) IS DISTINCT FROM 'string' OR v_val = '""'::jsonb) THEN
        actor := NULL; context := NULL; actor_source := 'invalid'; RETURN;
      END IF;
      context := v_ctx;
      actor := v_payload - 'context';
    ELSE
      context := NULL;
      actor := v_payload;
    END IF;
    actor_source := v_source;
    RETURN;
  END IF;

  v_raw_setting := NULLIF(pg_catalog.current_setting('request.jwt.claims', true), '');
  IF v_raw_setting IS NOT NULL THEN
    BEGIN
      v_claims := v_raw_setting::jsonb;
    EXCEPTION WHEN others THEN
      actor := NULL; context := NULL; actor_source := 'invalid'; RETURN;
    END;
    IF pg_catalog.jsonb_typeof(v_claims) IS DISTINCT FROM 'object' THEN
      actor := NULL; context := NULL; actor_source := 'invalid'; RETURN;
    END IF;
    v_val := v_claims->'sub';
    IF v_val IS NOT NULL
       AND pg_catalog.jsonb_typeof(v_val) IS DISTINCT FROM 'null' THEN
      IF pg_catalog.jsonb_typeof(v_val) IS DISTINCT FROM 'string'
         OR v_val = '""'::jsonb
         OR 21 + pg_catalog.octet_length(v_val::text) > 512 THEN
        actor := NULL; context := NULL; actor_source := 'invalid'; RETURN;
      END IF;
      actor := pg_catalog.jsonb_build_object('type', 'user', 'id', v_val);
      context := NULL;
      actor_source := 'jwt';
      RETURN;
    END IF;
  END IF;

  actor := NULL;
  context := NULL;
  actor_source := NULL;
END
$fn$;

CREATE OR REPLACE FUNCTION "auditstream".capture()
RETURNS trigger
LANGUAGE plpgsql
SECURITY DEFINER
SET search_path = pg_catalog, pg_temp
AS $fn$
DECLARE
  v_actor jsonb;
  v_context jsonb;
  v_actor_source text;
  v_raw_setting text;
  v_q_tail text;
  v_last_ch text;
  v_q_len integer;
  v_prefix text;
  v_p1 integer;
  v_open_pos integer;
  v_comment_body text;
  v_body_len integer;
  v_allow_escapes boolean;
  v_pos integer;
  v_eq_pos integer;
  v_pair_key text;
  v_key_check text;
  v_val_start integer;
  v_val_end integer;
  v_scan_pos integer;
  v_quote_rel integer;
  v_q_idx integer;
  v_bs_prefix text;
  v_found_count integer;
  v_pair_ok boolean;
  v_has_tag boolean := false;
  v_raw_b64 text;
  v_b64_len integer;
  v_decoded_bytes bytea;
  v_payload jsonb;
  v_source text;
  v_type text;
  v_val jsonb;
  v_obo jsonb;
  v_ctx jsonb;
  v_claims jsonb;
  v_arg text;
  pk_json jsonb;
  pk_len integer;
  pk_single text;
  pk_cols text[] := '{}';
  ex_json jsonb;
  ex_len integer;
  ex_cols text[] := '{}';
  has_ex boolean := false;
  v_schema text;
  v_table text;
  v_relid oid;
  v_before jsonb;
  v_after jsonb;
  v_record_id jsonb;
BEGIN
  IF TG_NARGS >= 4 THEN
    v_schema := TG_ARGV[2];
    v_table := TG_ARGV[3];
    SELECT c.oid
      INTO v_relid
      FROM pg_catalog.pg_class c
      JOIN pg_catalog.pg_namespace n ON n.oid = c.relnamespace
     WHERE n.nspname = v_schema
       AND c.relname = v_table;
    IF v_relid IS NULL OR (
      v_relid <> TG_RELID
      AND NOT EXISTS (
        SELECT 1
          FROM pg_catalog.pg_partition_ancestors(TG_RELID) AS a(relid)
         WHERE a.relid = v_relid
      )
    ) THEN
      RAISE EXCEPTION 'auditstream.capture: trigger relation % is not a partition of %.%',
        TG_RELID::pg_catalog.regclass, v_schema, v_table
        USING ERRCODE = '42501';
    END IF;
  ELSE
    v_schema := TG_TABLE_SCHEMA;
    v_table := TG_TABLE_NAME;
    v_relid := TG_RELID;
  END IF;

  IF TG_OP <> 'TRUNCATE' THEN
    IF TG_NARGS >= 2 THEN
      v_arg := TG_ARGV[1];
      IF v_arg <> '[]' AND v_arg <> '{}' AND v_arg <> '' THEN
        IF pg_catalog.left(v_arg, 1) = '[' THEN
          ex_json := v_arg::jsonb;
          ex_len := pg_catalog.jsonb_array_length(ex_json);
          IF ex_len = 1 THEN
            ex_cols := ARRAY[ex_json->>0];
            has_ex := true;
          ELSIF ex_len > 1 THEN
            ex_cols := ARRAY(SELECT pg_catalog.jsonb_array_elements_text(ex_json));
            has_ex := true;
          END IF;
        ELSIF pg_catalog.left(v_arg, 1) = '{' THEN
          ex_cols := v_arg::text[];
          has_ex := (pg_catalog.cardinality(ex_cols) > 0);
        ELSE
          ex_cols := ARRAY[v_arg];
          has_ex := true;
        END IF;
      END IF;
    END IF;

    IF TG_OP = 'UPDATE' THEN
      IF has_ex THEN
        v_before := pg_catalog.to_jsonb(OLD) - ex_cols;
        v_after := pg_catalog.to_jsonb(NEW) - ex_cols;
      ELSE
        v_before := pg_catalog.to_jsonb(OLD);
        v_after := pg_catalog.to_jsonb(NEW);
      END IF;
      IF v_after = v_before THEN
        RETURN NULL;
      END IF;
    END IF;
  END IF;

  <<resolve_actor>>
  BEGIN
    v_raw_setting := NULLIF(pg_catalog.current_setting('auditstream.actor', true), '');
    IF v_raw_setting IS NOT NULL THEN
      IF pg_catalog.octet_length(v_raw_setting) > 512 THEN
        v_actor := NULL; v_context := NULL; v_actor_source := 'invalid'; EXIT resolve_actor;
      END IF;
      BEGIN
        v_payload := v_raw_setting::jsonb;
      EXCEPTION WHEN others THEN
        v_actor := NULL; v_context := NULL; v_actor_source := 'invalid'; EXIT resolve_actor;
      END;
      v_source := 'set_config';
    ELSE
      v_q_tail := pg_catalog.right(pg_catalog.current_query(), 4096);
      v_last_ch := pg_catalog.right(v_q_tail, 1);
      IF v_last_ch = '/'
         OR (v_last_ch <> '' AND pg_catalog.strpos(E' \t\n\r\f\x0b;', v_last_ch) > 0) THEN
        IF v_last_ch <> '/' THEN
          v_q_tail := pg_catalog.rtrim(v_q_tail, E' \t\n\r\f\x0b;');
        END IF;
        v_q_len := pg_catalog.length(v_q_tail);
        IF v_q_len >= 4
           AND pg_catalog.right(v_q_tail, 2) = '*/'
           AND pg_catalog.strpos(v_q_tail, 'auditstream=''') > 0 THEN
          v_prefix := pg_catalog.left(v_q_tail, v_q_len - 2);
          v_p1 := pg_catalog.strpos(v_prefix, '/');
          IF v_p1 > 0 THEN
            IF pg_catalog.strpos(pg_catalog.substr(v_prefix, v_p1 + 1), '/') = 0 THEN
              v_open_pos := v_p1;
            ELSE
              v_open_pos := v_q_len - 1 - pg_catalog.strpos(pg_catalog.reverse(v_prefix), '/');
            END IF;
            IF pg_catalog.substr(v_prefix, v_open_pos, 2) = '/*'
               AND (CASE
                 WHEN v_open_pos > 1 THEN pg_catalog.substr(v_prefix, v_open_pos - 1, 1) <> '*'
                 ELSE pg_catalog.length(pg_catalog.current_query()) <= 4096
                      OR pg_catalog.left(pg_catalog.right(pg_catalog.current_query(), 4097), 1) <> '*'
               END) THEN
              v_comment_body := pg_catalog.substr(v_prefix, v_open_pos + 2);
              v_body_len := pg_catalog.length(v_comment_body);
              IF v_body_len >= 14
                 AND pg_catalog.left(v_comment_body, 13) = 'auditstream='''
                 AND pg_catalog.right(v_comment_body, 1) = '''' THEN
                v_raw_b64 := pg_catalog.substr(v_comment_body, 14, v_body_len - 14);
                IF pg_catalog.strpos(v_raw_b64, '''') = 0 THEN
                  v_has_tag := true;
                END IF;
              END IF;
              IF NOT v_has_tag AND pg_catalog.strpos(v_comment_body, 'auditstream=''') > 0 THEN
                FOR pass_idx IN 0..1 LOOP
                  v_allow_escapes := (pass_idx = 1);
                  IF v_allow_escapes AND pg_catalog.strpos(v_comment_body, E'\\''') = 0 THEN
                    EXIT;
                  END IF;
                  v_pos := 1;
                  v_found_count := 0;
                  v_pair_ok := true;
                  v_raw_b64 := NULL;
                  WHILE v_pos <= v_body_len LOOP
                    v_eq_pos := pg_catalog.strpos(pg_catalog.substr(v_comment_body, v_pos), '=''');
                    IF v_eq_pos <= 1 THEN
                      v_pair_ok := false;
                      EXIT;
                    END IF;
                    v_pair_key := pg_catalog.substr(v_comment_body, v_pos, v_eq_pos - 1);
                    v_key_check := CASE
                      WHEN v_allow_escapes THEN pg_catalog.replace(v_pair_key, E'\\''', '')
                      ELSE v_pair_key
                    END;
                    IF pg_catalog.textregexeq(v_key_check COLLATE pg_catalog."C", '[^A-Za-z0-9_.*~()!%-]') THEN
                      v_pair_ok := false;
                      EXIT;
                    END IF;
                    v_val_start := v_pos + v_eq_pos + 1;
                    v_val_end := 0;
                    IF v_allow_escapes AND v_pair_key <> 'auditstream' THEN
                      v_scan_pos := v_val_start;
                      WHILE v_scan_pos <= v_body_len LOOP
                        v_quote_rel := pg_catalog.strpos(pg_catalog.substr(v_comment_body, v_scan_pos), '''');
                        IF v_quote_rel = 0 THEN
                          EXIT;
                        END IF;
                        v_q_idx := v_scan_pos + v_quote_rel - 1;
                        IF v_quote_rel = 1 OR pg_catalog.substr(v_comment_body, v_q_idx - 1, 1) <> E'\\' THEN
                          v_val_end := v_q_idx;
                          EXIT;
                        END IF;
                        v_bs_prefix := pg_catalog.substr(v_comment_body, v_scan_pos, v_quote_rel - 1);
                        IF (pg_catalog.length(v_bs_prefix) - pg_catalog.length(pg_catalog.rtrim(v_bs_prefix, E'\\'))) % 2 = 0 THEN
                          v_val_end := v_q_idx;
                          EXIT;
                        END IF;
                        v_scan_pos := v_q_idx + 1;
                      END LOOP;
                    ELSE
                      v_quote_rel := pg_catalog.strpos(pg_catalog.substr(v_comment_body, v_val_start), '''');
                      IF v_quote_rel > 0 THEN
                        v_val_end := v_val_start + v_quote_rel - 1;
                      END IF;
                    END IF;
                    IF v_val_end = 0 THEN
                      v_pair_ok := false;
                      EXIT;
                    END IF;
                    IF v_pair_key = 'auditstream' THEN
                      v_found_count := v_found_count + 1;
                      IF v_found_count = 1 THEN
                        v_raw_b64 := pg_catalog.substr(v_comment_body, v_val_start, v_val_end - v_val_start);
                      END IF;
                    END IF;
                    v_pos := v_val_end + 1;
                    IF v_pos <= v_body_len THEN
                      IF pg_catalog.substr(v_comment_body, v_pos, 1) <> ',' OR v_pos = v_body_len THEN
                        v_pair_ok := false;
                        EXIT;
                      END IF;
                      v_pos := v_pos + 1;
                    END IF;
                  END LOOP;
                  IF v_pair_ok THEN
                    IF v_found_count > 1 THEN
                      v_actor := NULL; v_context := NULL; v_actor_source := 'invalid'; EXIT resolve_actor;
                    END IF;
                    IF v_found_count = 1 THEN
                      v_has_tag := true;
                      EXIT;
                    END IF;
                  END IF;
                END LOOP;
              END IF;
            END IF;
          END IF;
        END IF;
      END IF;
      IF v_has_tag THEN
        v_b64_len := pg_catalog.length(v_raw_b64);
        IF v_b64_len < 1
           OR v_b64_len > 683
           OR v_b64_len % 4 = 1
           OR pg_catalog.textregexeq(v_raw_b64 COLLATE pg_catalog."C", '[^A-Za-z0-9_-]') THEN
          v_actor := NULL; v_context := NULL; v_actor_source := 'invalid'; EXIT resolve_actor;
        END IF;
        BEGIN
          v_decoded_bytes := pg_catalog.decode(
            pg_catalog.translate(v_raw_b64, '-_', '+/')
              || pg_catalog.repeat('=', (4 - v_b64_len % 4) % 4),
            'base64'
          );
          IF pg_catalog.octet_length(v_decoded_bytes) > 512 THEN
            v_actor := NULL; v_context := NULL; v_actor_source := 'invalid'; EXIT resolve_actor;
          END IF;
          v_payload := pg_catalog.convert_from(v_decoded_bytes, 'UTF8')::jsonb;
        EXCEPTION WHEN others THEN
          v_actor := NULL; v_context := NULL; v_actor_source := 'invalid'; EXIT resolve_actor;
        END;
        v_source := 'comment';
      END IF;
    END IF;

    IF v_source IS NOT NULL THEN
      IF pg_catalog.jsonb_typeof(v_payload) IS DISTINCT FROM 'object' THEN
        v_actor := NULL; v_context := NULL; v_actor_source := 'invalid'; EXIT resolve_actor;
      END IF;
      v_type := v_payload->>'type';
      v_val := v_payload->'id';
      IF v_type IS NULL
         OR pg_catalog.jsonb_typeof(v_payload->'type') IS DISTINCT FROM 'string'
         OR v_type NOT IN ('user', 'api_key', 'ai_agent', 'service', 'system')
         OR pg_catalog.jsonb_typeof(v_val) IS DISTINCT FROM 'string'
         OR v_val = '""'::jsonb THEN
        v_actor := NULL; v_context := NULL; v_actor_source := 'invalid'; EXIT resolve_actor;
      END IF;
      v_val := v_payload->'tenant';
      IF v_val IS NOT NULL
         AND (pg_catalog.jsonb_typeof(v_val) IS DISTINCT FROM 'string' OR v_val = '""'::jsonb) THEN
        v_actor := NULL; v_context := NULL; v_actor_source := 'invalid'; EXIT resolve_actor;
      END IF;
      v_obo := v_payload->'onBehalfOf';
      IF v_obo IS NOT NULL THEN
        IF pg_catalog.jsonb_typeof(v_obo) IS DISTINCT FROM 'object' THEN
          v_actor := NULL; v_context := NULL; v_actor_source := 'invalid'; EXIT resolve_actor;
        END IF;
        v_type := v_obo->>'type';
        v_val := v_obo->'id';
        IF v_type IS NULL
           OR pg_catalog.jsonb_typeof(v_obo->'type') IS DISTINCT FROM 'string'
           OR v_type NOT IN ('user', 'api_key', 'ai_agent', 'service', 'system')
           OR pg_catalog.jsonb_typeof(v_val) IS DISTINCT FROM 'string'
           OR v_val = '""'::jsonb
           OR v_obo->'onBehalfOf' IS NOT NULL THEN
          v_actor := NULL; v_context := NULL; v_actor_source := 'invalid'; EXIT resolve_actor;
        END IF;
        v_val := v_obo->'tenant';
        IF v_val IS NOT NULL
           AND (pg_catalog.jsonb_typeof(v_val) IS DISTINCT FROM 'string' OR v_val = '""'::jsonb) THEN
          v_actor := NULL; v_context := NULL; v_actor_source := 'invalid'; EXIT resolve_actor;
        END IF;
      END IF;
      v_ctx := v_payload->'context';
      IF v_ctx IS NOT NULL THEN
        IF pg_catalog.jsonb_typeof(v_ctx) IS DISTINCT FROM 'object' THEN
          v_actor := NULL; v_context := NULL; v_actor_source := 'invalid'; EXIT resolve_actor;
        END IF;
        v_val := v_ctx->'requestId';
        IF v_val IS NOT NULL
           AND (pg_catalog.jsonb_typeof(v_val) IS DISTINCT FROM 'string' OR v_val = '""'::jsonb) THEN
          v_actor := NULL; v_context := NULL; v_actor_source := 'invalid'; EXIT resolve_actor;
        END IF;
        v_val := v_ctx->'source';
        IF v_val IS NOT NULL
           AND (pg_catalog.jsonb_typeof(v_val) IS DISTINCT FROM 'string' OR v_val = '""'::jsonb) THEN
          v_actor := NULL; v_context := NULL; v_actor_source := 'invalid'; EXIT resolve_actor;
        END IF;
        v_val := v_ctx->'ip';
        IF v_val IS NOT NULL
           AND (pg_catalog.jsonb_typeof(v_val) IS DISTINCT FROM 'string' OR v_val = '""'::jsonb) THEN
          v_actor := NULL; v_context := NULL; v_actor_source := 'invalid'; EXIT resolve_actor;
        END IF;
        v_val := v_ctx->'userAgent';
        IF v_val IS NOT NULL
           AND (pg_catalog.jsonb_typeof(v_val) IS DISTINCT FROM 'string' OR v_val = '""'::jsonb) THEN
          v_actor := NULL; v_context := NULL; v_actor_source := 'invalid'; EXIT resolve_actor;
        END IF;
        v_context := v_ctx;
        v_actor := v_payload - 'context';
      ELSE
        v_context := NULL;
        v_actor := v_payload;
      END IF;
      v_actor_source := v_source;
      EXIT resolve_actor;
    END IF;

    v_raw_setting := NULLIF(pg_catalog.current_setting('request.jwt.claims', true), '');
    IF v_raw_setting IS NOT NULL THEN
      BEGIN
        v_claims := v_raw_setting::jsonb;
      EXCEPTION WHEN others THEN
        v_actor := NULL; v_context := NULL; v_actor_source := 'invalid'; EXIT resolve_actor;
      END;
      IF pg_catalog.jsonb_typeof(v_claims) IS DISTINCT FROM 'object' THEN
        v_actor := NULL; v_context := NULL; v_actor_source := 'invalid'; EXIT resolve_actor;
      END IF;
      v_val := v_claims->'sub';
      IF v_val IS NOT NULL
         AND pg_catalog.jsonb_typeof(v_val) IS DISTINCT FROM 'null' THEN
        IF pg_catalog.jsonb_typeof(v_val) IS DISTINCT FROM 'string'
           OR v_val = '""'::jsonb
           OR 21 + pg_catalog.octet_length(v_val::text) > 512 THEN
          v_actor := NULL; v_context := NULL; v_actor_source := 'invalid'; EXIT resolve_actor;
        END IF;
        v_actor := pg_catalog.jsonb_build_object('type', 'user', 'id', v_val);
        v_context := NULL;
        v_actor_source := 'jwt';
        EXIT resolve_actor;
      END IF;
    END IF;

    v_actor := NULL;
    v_context := NULL;
    v_actor_source := NULL;
  END resolve_actor;

  IF TG_OP = 'TRUNCATE' THEN
    INSERT INTO "auditstream".changes (
      source, schema_name, table_name, table_oid, op,
      actor, context, actor_source, db_user, schema_version
    )
    VALUES (
      'db', v_schema, v_table, v_relid, 'TRUNCATE',
      v_actor, v_context, v_actor_source,
      session_user, 1
    );
    RETURN NULL;
  END IF;

  IF TG_NARGS >= 1 THEN
    v_arg := TG_ARGV[0];
    IF v_arg <> '[]' AND v_arg <> '{}' AND v_arg <> '' THEN
      IF pg_catalog.left(v_arg, 1) = '[' THEN
        pk_json := v_arg::jsonb;
        pk_len := pg_catalog.jsonb_array_length(pk_json);
        IF pk_len = 1 THEN
          pk_single := pk_json->>0;
        ELSIF pk_len > 1 THEN
          pk_cols := ARRAY(SELECT pg_catalog.jsonb_array_elements_text(pk_json));
        END IF;
      ELSIF pg_catalog.left(v_arg, 1) = '{' THEN
        pk_cols := v_arg::text[];
        pk_len := pg_catalog.cardinality(pk_cols);
        IF pk_len = 1 THEN
          pk_single := pk_cols[1];
          pk_cols := '{}';
        END IF;
      ELSE
        pk_single := v_arg;
      END IF;
    END IF;
  END IF;

  IF TG_OP = 'UPDATE' THEN
    IF pk_single IS NOT NULL THEN
      v_record_id := pg_catalog.jsonb_build_object(pk_single, v_after->pk_single);
    ELSIF pg_catalog.cardinality(pk_cols) > 0 THEN
      SELECT pg_catalog.jsonb_object_agg(k, v_after->k)
        INTO v_record_id
        FROM pg_catalog.unnest(pk_cols) AS k;
    END IF;
    INSERT INTO "auditstream".changes (
      source, schema_name, table_name, table_oid, op,
      record_id, before, after, changed,
      actor, context, actor_source, db_user, schema_version
    )
    VALUES (
      'db',
      v_schema,
      v_table,
      v_relid,
      'UPDATE',
      v_record_id,
      v_before,
      v_after,
      ARRAY(
        SELECT e.k
          FROM pg_catalog.jsonb_each(v_after) AS e(k, v)
         WHERE v_before->e.k IS DISTINCT FROM e.v
      ),
      v_actor,
      v_context,
      v_actor_source,
      session_user,
      1
    );
    RETURN NULL;
  END IF;

  IF TG_OP = 'INSERT' THEN
    IF pk_single IS NOT NULL AND NOT has_ex THEN
      INSERT INTO "auditstream".changes (
        source, schema_name, table_name, table_oid, op,
        record_id, before, after, changed,
        actor, context, actor_source, db_user, schema_version
      )
      SELECT
        'db',
        v_schema,
        v_table,
        v_relid,
        'INSERT',
        pg_catalog.jsonb_build_object(pk_single, s.row_after->pk_single),
        NULL,
        s.row_after,
        NULL,
        v_actor,
        v_context,
        v_actor_source,
        session_user,
        1
      FROM (
        SELECT pg_catalog.to_jsonb(r) AS row_after
          FROM new_rows AS r
        OFFSET 0
      ) AS s;
    ELSE
      INSERT INTO "auditstream".changes (
        source, schema_name, table_name, table_oid, op,
        record_id, before, after, changed,
        actor, context, actor_source, db_user, schema_version
      )
      SELECT
        'db',
        v_schema,
        v_table,
        v_relid,
        'INSERT',
        CASE
          WHEN pk_single IS NOT NULL THEN pg_catalog.jsonb_build_object(pk_single, s.row_after->pk_single)
          WHEN pg_catalog.cardinality(pk_cols) > 0 THEN (
            SELECT pg_catalog.jsonb_object_agg(k, s.row_after->k)
              FROM pg_catalog.unnest(pk_cols) AS k
          )
        END,
        NULL,
        s.row_after,
        NULL,
        v_actor,
        v_context,
        v_actor_source,
        session_user,
        1
      FROM (
        SELECT CASE WHEN has_ex THEN pg_catalog.to_jsonb(r) - ex_cols ELSE pg_catalog.to_jsonb(r) END AS row_after
          FROM new_rows AS r
        OFFSET 0
      ) AS s;
    END IF;
    RETURN NULL;
  END IF;

  IF TG_OP = 'DELETE' THEN
    IF pk_single IS NOT NULL AND NOT has_ex THEN
      INSERT INTO "auditstream".changes (
        source, schema_name, table_name, table_oid, op,
        record_id, before, after, changed,
        actor, context, actor_source, db_user, schema_version
      )
      SELECT
        'db',
        v_schema,
        v_table,
        v_relid,
        'DELETE',
        pg_catalog.jsonb_build_object(pk_single, s.row_before->pk_single),
        s.row_before,
        NULL,
        NULL,
        v_actor,
        v_context,
        v_actor_source,
        session_user,
        1
      FROM (
        SELECT pg_catalog.to_jsonb(r) AS row_before
          FROM old_rows AS r
        OFFSET 0
      ) AS s;
    ELSE
      INSERT INTO "auditstream".changes (
        source, schema_name, table_name, table_oid, op,
        record_id, before, after, changed,
        actor, context, actor_source, db_user, schema_version
      )
      SELECT
        'db',
        v_schema,
        v_table,
        v_relid,
        'DELETE',
        CASE
          WHEN pk_single IS NOT NULL THEN pg_catalog.jsonb_build_object(pk_single, s.row_before->pk_single)
          WHEN pg_catalog.cardinality(pk_cols) > 0 THEN (
            SELECT pg_catalog.jsonb_object_agg(k, s.row_before->k)
              FROM pg_catalog.unnest(pk_cols) AS k
          )
        END,
        s.row_before,
        NULL,
        NULL,
        v_actor,
        v_context,
        v_actor_source,
        session_user,
        1
      FROM (
        SELECT CASE WHEN has_ex THEN pg_catalog.to_jsonb(r) - ex_cols ELSE pg_catalog.to_jsonb(r) END AS row_before
          FROM old_rows AS r
        OFFSET 0
      ) AS s;
    END IF;
    RETURN NULL;
  END IF;

  RETURN NULL;
END
$fn$;

DO $$
DECLARE
  fn_name name;
  grantee_oid oid;
BEGIN
  FOR fn_name, grantee_oid IN
    SELECT DISTINCT p.proname, a.grantee
      FROM pg_catalog.pg_proc p
      JOIN pg_catalog.pg_namespace n ON n.oid = p.pronamespace
      CROSS JOIN LATERAL pg_catalog.aclexplode(
        COALESCE(p.proacl, pg_catalog.acldefault('f', p.proowner))
      ) AS a
     WHERE n.nspname = 'auditstream'
       AND p.proname IN ('resolve_actor', 'capture')
       AND p.prokind = 'f'
       AND p.pronargs = 0
       AND a.grantee <> p.proowner
     ORDER BY p.proname, a.grantee
  LOOP
    IF grantee_oid = 0 THEN
      EXECUTE pg_catalog.format('REVOKE ALL ON FUNCTION %I.%I() FROM PUBLIC CASCADE', 'auditstream', fn_name);
    ELSE
      EXECUTE pg_catalog.format(
        'REVOKE ALL ON FUNCTION %I.%I() FROM %I CASCADE',
        'auditstream',
        fn_name,
        pg_catalog.pg_get_userbyid(grantee_oid)
      );
    END IF;
  END LOOP;
END
$$;

DO $$
DECLARE
  prev_role text := pg_catalog.current_setting('auditstream._prev_role', true);
BEGIN
  SET LOCAL ROLE NONE;
  IF prev_role IS NOT NULL AND prev_role <> '' AND prev_role <> current_user THEN
    EXECUTE pg_catalog.format('SET LOCAL ROLE %I', prev_role);
  END IF;
  PERFORM pg_catalog.set_config('auditstream._prev_role', '', true);
END
$$;

DO $$
DECLARE
  caller name := current_user;
  granted_usage boolean := false;
  granted_exec boolean := false;
BEGIN
  IF NOT pg_catalog.pg_has_role(caller, 'auditstream_owner', 'USAGE') THEN
    EXECUTE pg_catalog.format('SET LOCAL ROLE %I', 'auditstream_owner');
    IF NOT EXISTS (
      SELECT 1 FROM pg_catalog.pg_namespace n
      CROSS JOIN LATERAL pg_catalog.aclexplode(
        COALESCE(n.nspacl, pg_catalog.acldefault('n', n.nspowner))
      ) AS a
       WHERE n.nspname = 'auditstream'
         AND a.grantee <> 0
         AND pg_catalog.pg_get_userbyid(a.grantee)::text = caller::text
         AND a.privilege_type = 'USAGE'
    ) THEN
      EXECUTE pg_catalog.format('GRANT USAGE ON SCHEMA %I TO %I', 'auditstream', caller);
      granted_usage := true;
    END IF;
    EXECUTE pg_catalog.format('GRANT EXECUTE ON FUNCTION %I.capture() TO %I', 'auditstream', caller);
    granted_exec := true;
    SET LOCAL ROLE NONE;
    IF caller <> current_user THEN
      EXECUTE pg_catalog.format('SET LOCAL ROLE %I', caller);
    END IF;
  END IF;
  PERFORM pg_catalog.set_config(
    'auditstream._temp_trigger_privs',
    CASE
      WHEN granted_usage AND granted_exec THEN 'both'
      WHEN granted_exec THEN 'exec'
      ELSE 'none'
    END,
    true
  );
END
$$;

CREATE OR REPLACE TRIGGER auditstream_insert
  AFTER INSERT ON "public"."invoice"
  REFERENCING NEW TABLE AS new_rows
  FOR EACH STATEMENT
  EXECUTE FUNCTION "auditstream".capture('["id"]', '["password_hash"]');

CREATE OR REPLACE TRIGGER auditstream_update
  AFTER UPDATE ON "public"."invoice"
  FOR EACH ROW
  EXECUTE FUNCTION "auditstream".capture('["id"]', '["password_hash"]');

CREATE OR REPLACE TRIGGER auditstream_delete
  AFTER DELETE ON "public"."invoice"
  REFERENCING OLD TABLE AS old_rows
  FOR EACH STATEMENT
  EXECUTE FUNCTION "auditstream".capture('["id"]', '["password_hash"]');

CREATE OR REPLACE TRIGGER auditstream_truncate
  AFTER TRUNCATE ON "public"."invoice"
  FOR EACH STATEMENT
  EXECUTE FUNCTION "auditstream".capture('["id"]', '["password_hash"]');

CREATE OR REPLACE TRIGGER auditstream_insert
  AFTER INSERT ON "public"."line_item"
  REFERENCING NEW TABLE AS new_rows
  FOR EACH STATEMENT
  EXECUTE FUNCTION "auditstream".capture('["id"]', '[]');

CREATE OR REPLACE TRIGGER auditstream_update
  AFTER UPDATE ON "public"."line_item"
  FOR EACH ROW
  EXECUTE FUNCTION "auditstream".capture('["id"]', '[]');

CREATE OR REPLACE TRIGGER auditstream_delete
  AFTER DELETE ON "public"."line_item"
  REFERENCING OLD TABLE AS old_rows
  FOR EACH STATEMENT
  EXECUTE FUNCTION "auditstream".capture('["id"]', '[]');

CREATE OR REPLACE TRIGGER auditstream_truncate
  AFTER TRUNCATE ON "public"."line_item"
  FOR EACH STATEMENT
  EXECUTE FUNCTION "auditstream".capture('["id"]', '[]');

DO $$
DECLARE
  caller name := current_user;
  priv_mode text := pg_catalog.current_setting('auditstream._temp_trigger_privs', true);
BEGIN
  IF priv_mode IN ('both', 'exec') THEN
    EXECUTE pg_catalog.format('SET LOCAL ROLE %I', 'auditstream_owner');
    EXECUTE pg_catalog.format('REVOKE EXECUTE ON FUNCTION %I.capture() FROM %I CASCADE', 'auditstream', caller);
    IF priv_mode = 'both' THEN
      EXECUTE pg_catalog.format('REVOKE USAGE ON SCHEMA %I FROM %I CASCADE', 'auditstream', caller);
    END IF;
    SET LOCAL ROLE NONE;
    IF caller <> current_user THEN
      EXECUTE pg_catalog.format('SET LOCAL ROLE %I', caller);
    END IF;
    PERFORM pg_catalog.set_config('auditstream._temp_trigger_privs', '', true);
  END IF;
END
$$;

DO $$
DECLARE
  grant_mode text := pg_catalog.current_setting('auditstream._triggers_granted_self', true);
  grantor_role text := pg_catalog.current_setting('auditstream._triggers_granted_self_grantor', true);
  granted_by text := '';
BEGIN
  IF grantor_role IS NOT NULL AND grantor_role <> '' THEN
    granted_by := pg_catalog.format(' GRANTED BY %I', grantor_role);
  END IF;
  IF grant_mode = 'self_row' THEN
    EXECUTE pg_catalog.format('REVOKE "auditstream_owner" FROM %I', current_user) || granted_by;
  ELSIF grant_mode = 'set' THEN
    EXECUTE pg_catalog.format('REVOKE SET OPTION FOR "auditstream_owner" FROM %I', current_user) || granted_by;
  END IF;
  IF grant_mode IS NOT NULL AND grant_mode <> '' THEN
    PERFORM pg_catalog.set_config('auditstream._triggers_granted_self', '', true);
  END IF;
  IF grantor_role IS NOT NULL AND grantor_role <> '' THEN
    PERFORM pg_catalog.set_config('auditstream._triggers_granted_self_grantor', '', true);
  END IF;
END
$$
